; -!- emf -!-
;
; Copyright (C) 2026 JASSPA (www.jasspa.com)
;
; This is part of JASSPA's MicroEmacs, see the LICENSE file for licensing and
; copying information.
;
; Synopsis: Chat with an AI coding assistant over an OpenAI compatible API.
; Authors:  Dangit
;
; The conversation is the text of the *ai-chat* buffer, split into sections by
; "## You", "## AI", "## System" and "## Tool" lines, so it may be edited, saved and
; reloaded. Requests use the chat completions or the responses API, and stream
; through curl when it is found, otherwise they use the built-in HTTP client which
; waits for the whole reply. Questions may attach files, buffers and the output of
; commands; replies may change files with edit blocks or diffs, reviewed one at a
; time or as one diff, and with %ai-tools may ask to read and search the project.
; Chats are saved in %ai-chat-dir.
;
!iif &not &exi %ai-base-url       set-variable %ai-base-url "https://api.openai.com/v1"
!iif &not &exi %ai-model          set-variable %ai-model &reg "/history/ai-chat/model" ""
!iif &not &exi %ai-effort         set-variable %ai-effort &reg "/history/ai-chat/effort" ""
!iif &not &exi %ai-efforts        set-variable %ai-efforts "|none|minimal|low|medium|high|xhigh|"
!iif &not &exi %ai-api-key        set-variable %ai-api-key ""
!iif &not &exi %ai-transport      set-variable %ai-transport ""
!iif &not &exi %ai-curl           set-variable %ai-curl "curl"
!iif &not &exi %ai-curl-args      set-variable %ai-curl-args ""
; the seconds a reply may go without sending anything, the built-in client takes its limit from
; %sock-recv-timeout when its first URL is loaded
!iif &not &exi %ai-timeout        set-variable %ai-timeout 600
!iif &not &exi %sock-recv-timeout set-variable %sock-recv-timeout %ai-timeout
!iif &not &exi %ai-retries        set-variable %ai-retries 2
!iif &not &exi %ai-retry-wait     set-variable %ai-retry-wait 5
!iif &not &exi %ai-api            set-variable %ai-api "chat"
!iif &not &exi %ai-extra-json     set-variable %ai-extra-json ""
!iif &not &exi %ai-tools          set-variable %ai-tools 0
!iif &not &exi %ai-tool-rounds    set-variable %ai-tool-rounds 10
!iif &not &exi %ai-wrap           set-variable %ai-wrap 1
!iif &not &exi %ai-usage          set-variable %ai-usage 1
!iif &not &exi %ai-reasoning      set-variable %ai-reasoning 0
!iif &not &exi %ai-model-skip     set-variable %ai-model-skip "embed\\|tts\\|whisper\\|dall-e\\|image\\|moderation\\|transcri\\|realtime\\|audio\\|davinci\\|babbage\\|sora"
!iif &not &exi %ai-system-prompt  set-variable %ai-system-prompt "You are a programming assistant inside the MicroEmacs text editor. Be concise. Put code in fenced Markdown blocks tagged with the language. When asked to change code, reply with the complete replacement in a single block."
!iif &not &exi %ai-actions        set-variable %ai-actions "|explain|review|fix|document|tests|simplify|"
!iif &not &exi %ai-action-explain   set-variable %ai-action-explain "Explain what this code does."
!iif &not &exi %ai-action-review    set-variable %ai-action-review "Review this code for bugs, edge cases and readability. List the problems, most serious first."
!iif &not &exi %ai-action-fix       set-variable %ai-action-fix "Find and fix the bugs in this code. Reply with the complete corrected code in one block, then list the changes."
!iif &not &exi %ai-action-document  set-variable %ai-action-document "Add documentation comments to this code in the usual style of the language. Reply with the complete code in one block."
!iif &not &exi %ai-action-tests     set-variable %ai-action-tests "Write unit tests for this code."
!iif &not &exi %ai-action-simplify  set-variable %ai-action-simplify "Simplify this code without changing its behaviour. Reply with the complete code in one block."
!iif &not &exi %ai-attach-max     set-variable %ai-attach-max 200000
; the size of request, in characters, that is asked about before it is sent
!iif &not &exi %ai-request-max    set-variable %ai-request-max %ai-attach-max
!iif &not &exi %ai-chat-save      set-variable %ai-chat-save 1
!iif &not &exi %ai-chat-dir       set-variable %ai-chat-dir &cat $user-path "aichat/"
!iif &not &exi %ai-attach-lines   set-variable %ai-attach-lines 30
!iif &not &exi %ai-attach-cmd-lines  set-variable %ai-attach-cmd-lines 2000
!iif &not &exi %ai-edit-review    set-variable %ai-edit-review 1
!iif &not &exi %ai-edit-lenient   set-variable %ai-edit-lenient 1
!iif &not &exi %ai-edit-actions   set-variable %ai-edit-actions "|message|"
!iif &not &exi %ai-edit-action-message  set-variable %ai-edit-action-message "Rewrite the message quoted above, which comes from the attached code, as follows: %s. It may be a format string, so keep its % formats matching the arguments, and change every place it is used."
!iif &not &exi %ai-edit-prompt    set-variable %ai-edit-prompt "To change an attached file reply with edit blocks rather than the whole file. An edit block is a fenced block whose info string is edit followed by the file's name from its attachment, holding one or more changes:\n```edit src/main.c\n<<<<<<< SEARCH\nlines copied exactly from the file\n=======\nthe lines that replace them\n>>>>>>> REPLACE\n```\nCopy the SEARCH lines exactly, indentation included, using just enough lines to match one place in the file. Give each place that changes its own SEARCH and REPLACE, in the order they come in the file. An empty SEARCH creates a new file. Explain the changes briefly outside the blocks."
!iif &not &exi %ai-commit-prompt  set-variable %ai-commit-prompt "Write a git commit message for the staged changes in the diff above: a summary line of at most 72 characters, a blank line, then a short body saying what changed and why, wrapped at 72 columns. Reply with only the message in a single text code block."
!iif &not &exi %ai-fix-prompt     set-variable %ai-fix-prompt "Fix the cause of this error in the attached code, replying with edit blocks."
!iif &not &exi %ai-api-key-command  set-variable %ai-api-key-command ""
!iif &not &exi %ai-profiles       set-variable %ai-profiles "|"

; set #p9 to the API key: %ai-api-key, else the first line written by %ai-api-key-command, run
; once until the command or profile changes, else the OPENAI_API_KEY environment variable
0 define-macro ai-get-key
  set-variable #p9 %ai-api-key
  !iif &not &seq #p9 ""  !return
  !if &len %ai-api-key-command
    !if &not &seq .ai-send.key-cmd %ai-api-key-command
      set-variable .ai-send.key-out ""
      !force 0x402 pipe-shell-command %ai-api-key-command ".ai-send.key-out"
      set-variable #l1 $result
      set-variable #l2 .ai-send.key-out
      !iif &sin "\n" #l2  set-variable #l2 &lef #l2 &sub &sin "\n" #l2 1
      set-variable #l2 &trb &rep #l2 "\r" ""
      set-variable .ai-send.key-out ""
      !if &or #l1 &seq #l2 ""
        ml-write &spr "[AI Error: the key command %s failed]" %ai-api-key-command
        !abort
      !endif
      set-variable .ai-send.key-cache #l2
      set-variable .ai-send.key-cmd %ai-api-key-command
    !endif
    set-variable #p9 .ai-send.key-cache
    !return
  !endif
  set-variable #p9 &con &seq $OPENAI_API_KEY "ERROR" "" $OPENAI_API_KEY
!emacro

; Profiles: a profile is a server and how it is used, given by %ai-profile-NAME-SETTING for each
; setting in .ai-set-profile.settings. A setting a profile does not give has its value from when this
; file was loaded, which is the default profile. The model and effort last chosen are kept for
; each profile

; set #p9 to where setting @1 (model or effort) of the current profile is kept in the registry
0 define-macro ai-profile-reg
  set-variable #l1 @1
  set-variable #p9 &con &seq .ai-set-profile.current "default" &spr "/history/ai-chat/%s" #l1 &spr "/history/ai-chat/profile-%s/%s" .ai-set-profile.current #l1
!emacro

; keep value @2 of setting @1 (model or effort) of the current profile in the registry
0 define-macro ai-profile-keep
  set-variable #l1 @1
  set-variable #l2 @2
  ai-profile-reg #l1
  !if &not &seq #l2 &reg #l9 ""
    set-registry #l9 #l2
    ; set-registry does not flag the history as changed, so it would not be saved
    !iif &not &seq &lef &reg "/history" "" 6 "tfs://"  !force mark-registry "/history" "u"
  !endif
!emacro

; set the %ai- variables from the profile .ai-set-profile.current
0 define-macro ai-profile-apply
  set-variable #l1 .ai-set-profile.current
  set-variable #l2 0
  !while &not &seq &set #l3 &lget .ai-set-profile.settings &inc #l2 1 ""
    set-variable #l4 &spr "%%ai-profile-%s-%s" #l1 #l3
    !if &and &not &seq #l1 "default" &exi #l4
      set-variable &ind &spr "%%ai-%s" #l3 &ind #l4
    !else
      set-variable &ind &spr "%%ai-%s" #l3 &ind &spr ".ai-set-profile.default-%s" #l3
    !endif
  !done
  ; the model and effort last used with it, else its own
  ai-profile-reg "model"
  set-variable #l5 &reg #l9 ""
  !if &seq #l5 ""
    set-variable #l5 &con &seq #l1 "default" .ai-set-profile.default-model ""
    !iif &exi &spr "%%ai-profile-%s-model" #l1  set-variable #l5 &ind &spr "%%ai-profile-%s-model" #l1
  !endif
  set-variable %ai-model #l5
  ai-profile-reg "effort"
  set-variable #l5 &reg #l9 "\x01"
  !if &seq #l5 "\x01"
    set-variable #l5 &con &seq #l1 "default" .ai-set-profile.default-effort ""
    !iif &exi &spr "%%ai-profile-%s-effort" #l1  set-variable #l5 &ind &spr "%%ai-profile-%s-effort" #l1
  !endif
  set-variable %ai-effort #l5
  set-variable .ai-send.key-cmd ""
!emacro

; choose the profile, from "default" and %ai-profiles
define-macro ai-set-profile
  !force set-variable #l1 @1
  !if &not $status
    !if &les &len %ai-profiles 2
      ml-write "[AI: there are no profiles, see %ai-profiles]"
      !abort
    !endif
    !force set-variable #l1 @ml29 "AI profile" .ai-set-profile.current &cat "|default" %ai-profiles
    !iif &not $status  !abort
  !endif
  set-variable #l1 &trb #l1
  !iif &seq #l1 ""  set-variable #l1 "default"
  !if &not &or &seq #l1 "default" &lfind %ai-profiles #l1
    ml-write &spr "[AI: there is no profile %s in %%ai-profiles]" #l1
    !abort
  !endif
  ; leaving the default profile keeps its settings as they are now
  !if &seq .ai-set-profile.current "default"
    set-variable #l2 0
    !while &not &seq &set #l3 &lget .ai-set-profile.settings &inc #l2 1 ""
      set-variable &ind &spr ".ai-set-profile.default-%s" #l3 &ind &spr "%%ai-%s" #l3
    !done
    set-variable .ai-set-profile.default-model %ai-model
    set-variable .ai-set-profile.default-effort %ai-effort
  !endif
  set-variable .ai-set-profile.current #l1
  ai-profile-apply
  !if &not &seq #l1 &reg "/history/ai-chat/profile" "default"
    set-registry "/history/ai-chat/profile" #l1
    !iif &not &seq &lef &reg "/history" "" 6 "tfs://"  !force mark-registry "/history" "u"
  !endif
  ml-write &spr "[AI: using profile %s, model %s%s]" #l1 &con &len %ai-model %ai-model "not set" &con &len %ai-effort &spr ", %s effort" %ai-effort ""
!emacro

0 define-macro ai-temp-buffer
  find-buffer @1
  1 buffer-mode "hide"
  -1 buffer-mode "undo"
  -1 buffer-mode "backup"
  -1 buffer-mode "autosv"
  -1 buffer-mode "time"
  -1 buffer-mode "cr"
  -1 buffer-mode "view"
  beginning-of-buffer
  set-mark
  end-of-buffer
  !force -1 kill-region
  set-alpha-mark "\xa4"
!emacro

; the keys of a chat buffer, bound by ai-chat-buffer and listed at the top of a chat by
; ai-chat-key-list, each with the text that says what it does
0 define-macro ai-chat-key-table
  ai-chat-key "C-c C-c" ai-send "send"
  ai-chat-key "C-c C-k" ai-cancel "cancel"
  ai-chat-key "C-c g" ai-retry "ask again"
  ai-chat-key "C-c f" ai-attach "attach files"
  ai-chat-key "C-c v" ai-show-attachment "show attachment"
  ai-chat-key "C-c q" ai-quote "quote region"
  ai-chat-key "C-c e" ai-edit "ask for a change"
  ai-chat-key "C-c a" ai-apply-edits "apply edits"
  ai-chat-key "C-c d" ai-review-edits "review edits"
  ai-chat-key "C-c u" ai-undo-edits "undo edits"
  ai-chat-key "C-c i" ai-insert-block "insert block"
  ai-chat-key "C-c m" ai-set-model "model"
  ai-chat-key "C-c r" ai-set-effort "effort"
  ai-chat-key "C-c p" ai-set-profile "profile"
  ai-chat-key "C-c n" ai-new "new chat"
  ai-chat-key "C-c o" ai-chat-open "open chat"
  ai-chat-key "C-c b" ai-fork "branch chat"
  ai-chat-key "C-c C-n" ai-next-part "next part"
  ai-chat-key "C-c C-p" ai-prev-part "previous part"
  ai-chat-key "C-c C-f" ai-next-block "next block"
  ai-chat-key "C-c C-b" ai-prev-block "previous block"
  ai-chat-key "C-c tab" ai-fold "fold part"
  ai-chat-key "C-c ?" ai-chat-keys "these keys"
!emacro

; bind key @1 to @2 in the current buffer, or with .ai-chat.key-list add it to the list in *ai-keys*
0 define-macro ai-chat-key
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  !if &not .ai-chat.key-list
    buffer-bind-key #l2 #l1
    !return
  !endif
  set-variable #l0 $buffer-bname
  find-buffer "*ai-keys*"
  set-variable #l4 &cat &cat #l1 &lef .ai-chat.spaces &sub 8 &len #l1 #l3
  !if &equ .ai-chat.key-list 3
    insert-string &cat #l4 "\n"
    set-variable .ai-chat.key-list 1
  !else
    insert-string &cat #l4 &lef .ai-chat.spaces &sub 25 &len #l4
    set-variable .ai-chat.key-list &add .ai-chat.key-list 1
  !endif
  find-buffer #l0
!emacro

; the comment at the top of a chat, listing its keys three to a line
0 define-macro ai-chat-key-list
  set-variable #l0 $buffer-bname
  ai-temp-buffer "*ai-keys*"
  insert-string "<!-- AI chat: write under the last \"## You\" line, then C-c C-c to send.\n"
  find-buffer #l0
  set-variable .ai-chat.key-list 1
  ai-chat-key-table
  set-variable .ai-chat.key-list 0
  find-buffer "*ai-keys*"
  ; end the last line and the comment
  end-of-buffer
  !iif &gre $window-col 0  insert-string "\n"
  set-variable #l1 1
  beginning-of-buffer
  !while &not &seq @wc ""
    end-of-line
    !while &and &gre $window-col 0 &seq &set #l2 &mid @wl &sub $window-col 1 1 " "
      backward-delete-char
    !done
    forward-line
  !done
  insert-string "-->\n"
  find-buffer #l0
!emacro

; replace the key list comment at the top of the current chat with one for the current keys, or
; add one when there is none
0 define-macro ai-chat-key-header
  ai-chat-key-list
  beginning-of-buffer
  !if &xse @wl "<!-- AI chat.*"
    set-mark
    !force search-buffer "Me" "-->"
    !if $status
      forward-line
      beginning-of-line
      -1 kill-region
    !else
      beginning-of-buffer
    !endif
  !endif
  ai-edit-append-at 1 "*ai-keys*"
  !force 0 delete-buffer "*ai-keys*"
!emacro

; list the chat's keys at the top of the chat, the point is left there with the mark where it was
define-macro ai-chat-keys
  !if &not &exi :ai-chat
    ai-chat
  !endif
  ; the list is rewritten using the mark, and may change the number of lines above the point, so
  ; the point is kept by an alpha mark which moves with the text and the mark is set after
  set-alpha-mark "\xac"
  ai-chat-key-header
  !force goto-alpha-mark "\xac"
  set-mark
  beginning-of-buffer
  ; the mark is only for going back, not a region to show
  -1 show-region
  ml-write "[AI: the keys are listed at the top of the chat, C-x C-x goes back]"
!emacro

0 define-macro ai-chat-init
  beginning-of-buffer
  set-mark
  end-of-buffer
  !force -1 kill-region
  ai-chat-key-header
  end-of-buffer
  insert-string "\n## You\n\n"
!emacro

0 define-macro ai-chat-buffer
  find-buffer .ai-chat.current
  ai-chat-setup
!emacro

; make the current buffer a chat
0 define-macro ai-chat-setup
  !if &not &exi :ai-chat
    ; markdown fills an empty buffer with its file template
    !iif &les $window-eline 2  ai-chat-init
    !force major-mode "md"
    ; md hilighting starts 100 lines above the window as if outside a code block, when
    ; that line is in one code and prose swap colours as the chat scrolls. This root
    ; scheme looks back to the top of the buffer and branches into md with a zero width
    ; token, a scroll costs under 1ms more in a 6000 line chat
    !if &and &exi .hilight.md &equ $buffer-hilight .hilight.md
      !if &not &exi .hilight.aichat
        set-variable .hilight.aichat &pinc .hilight.next 1
        0 hilight .hilight.aichat 2 1000000 $global-scheme
        hilight .hilight.aichat 0x80 "\\}." .hilight.md $global-scheme
      !endif
      set-variable $buffer-hilight .hilight.aichat
    !endif
    set-variable :ai-chat 1
    set-variable .ai-chat.key-list 0
    ai-chat-key-table
  !endif
!emacro

; leave the point at the end of the buffer after exactly one blank line
0 define-macro ai-chat-separate
  end-of-buffer
  !iif &gre $window-col 0  insert-string "\n"
  !if &gre $window-line 1
    backward-line
    set-variable #l0 &seq @wc "\n"
    forward-line
    !iif &not #l0  insert-string "\n"
  !endif
!emacro

; set .ai-chat.fence to the code fence open after the line of text @1 when fence @2 is open before it,
; "" for none. A fence is 3 or more backticks or tildes, closed by a line of at least as many of
; the same character
0 define-macro ai-fence-line
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable .ai-chat.fence #l2
  !if &not &len #l2
    !if &xse #l1 "[ \t]*\\(```+\\)[^`]*"
      set-variable .ai-chat.fence @s1
    !elif &xse #l1 "[ \t]*\\(~~~+\\).*"
      set-variable .ai-chat.fence @s1
    !endif
  !elif &xse #l1 "[ \t]*\\(```+\\|~~~+\\)[ \t]*"
    !iif &and &seq &lef @s1 1 &lef #l2 1 &not &les &len @s1 &len #l2  set-variable .ai-chat.fence ""
  !endif
!emacro

; map the current chat: the role lines and the attachment lines of its "## You" sections that are
; not in fenced code, as | lists of line numbers in .ai-chat.map-roles and .ai-chat.map-atts.
; .ai-chat.map-last is the last role line, .ai-chat.map-open the line of a code block left open at the end
; and .ai-chat.map-fence its fence, 0 and "" when there is none. The point is not moved
0 define-macro ai-chat-map
  ; the lines of folded parts would not be seen
  !iif &bmo "narrow"  !force 1 narrow-buffer
  0xc0 set-position "\xa9"
  set-variable #l1 "|"
  set-variable #l2 "|"
  set-variable #l3 ""
  set-variable #l4 ""
  set-variable #l5 0
  set-variable #l7 0
  beginning-of-buffer
  !repeat
    !force search-buffer "me" .ai-chat.map-regex
    !iif &not $status  !break
    set-variable #l6 @wl
    !if &len #l3
      !if &xse #l6 "[ \t]*\\(```\\|~~~\\).*"
        ai-fence-line #l6 #l3
        set-variable #l3 .ai-chat.fence
      !endif
    !elif &xse #l6 .ai-chat.role-re
      set-variable #l4 @s1
      set-variable #l7 $window-line
      set-variable #l1 &spr "%s%d|" #l1 #l7
    !elif &xse #l6 .ai-chat.att-line
      !iif &seq #l4 "You"  set-variable #l2 &spr "%s%d|" #l2 $window-line
    !else
      ai-fence-line #l6 ""
      set-variable #l3 .ai-chat.fence
      set-variable #l5 $window-line
    !endif
    end-of-line
  !done
  0xc0 goto-position "\xa9"
  set-variable .ai-chat.map-roles #l1
  set-variable .ai-chat.map-atts #l2
  set-variable .ai-chat.map-last #l7
  set-variable .ai-chat.map-open &con &len #l3 #l5 0
  set-variable .ai-chat.map-fence #l3
!emacro

; close the code block left open at the end of the current chat, as mapped by ai-chat-map, so a
; role line added after it is not taken as its text
0 define-macro ai-chat-close-fence
  !if .ai-chat.map-open
    end-of-buffer
    !iif &gre $window-col 0  insert-string "\n"
    ; after its last line of text
    !repeat
      backward-line
    !until &or &not &gre $window-line .ai-chat.map-open &not &xse @wl "[ \t]*"
    forward-line
    beginning-of-line
    insert-string &cat .ai-chat.map-fence "\n"
    set-variable .ai-chat.map-open 0
  !endif
!emacro

; leave the point where the text of a new question goes, reusing a last "## You" that holds
; nothing but attachments
0 define-macro ai-chat-question
  ai-chat-map
  set-variable #l1 .ai-chat.map-last
  !if #l1
    set-variable $window-line #l1
    set-variable #l1 &xse @wl .ai-chat.you-re
  !endif
  !if #l1
    set-variable #l1 $window-line
    set-variable #l2 0
    !repeat
      forward-line
      !if &seq @wc ""
        set-variable #l1 &con #l2 #l2 #l1
        set-variable $window-line #l1
        end-of-line
        set-mark
        end-of-buffer
        !force -1 kill-region
        ; the text goes after a blank line below the attachments, the newline before the end of
        ; the buffer may not have been killed
        end-of-buffer
        !while &les &sub $window-line #l1 &con #l2 2 1
          insert-string "\n"
        !done
        !return
      !elif &xse @wl .ai-chat.att-line
        set-variable #l2 $window-line
      !elif &not &xse @wl "[ \t]*"
        !break
      !endif
    !done
  !endif
  ai-chat-close-fence
  ai-chat-separate
  insert-string "## You\n"
!emacro

; move to where the next attachment of the question being written goes, after its "## You"
; line and attachments, starting a question when there is none. #p8 is the line after the
; "## You" line
0 define-macro ai-chat-attach-point
  ai-chat-map
  set-variable #l1 .ai-chat.map-last
  !if #l1
    set-variable $window-line #l1
    set-variable #l1 &xse @wl .ai-chat.you-re
  !endif
  !if #l1
    forward-line
  !else
    ai-chat-close-fence
    ai-chat-separate
    insert-string "## You\n\n"
    backward-line
  !endif
  set-variable #p8 $window-line
  set-variable #l1 #p8
  !repeat
    !if &xse @wl .ai-chat.att-line
      set-variable #l1 &add $window-line 1
    !elif &not &xse @wl "[ \t]*"
      !break
    !endif
    !iif &seq @wc ""  !break
    forward-line
  !done
  set-variable $window-line #l1
!emacro

; the end of the buffer after a blank line when the question so far ends in an attachment
0 define-macro ai-chat-text-point
  end-of-buffer
  !if &gre $window-line 1
    backward-line
    set-variable #l0 &xse @wl .ai-chat.att-line
    forward-line
    !iif #l0  insert-string "\n"
  !endif
!emacro

; add attachment @1 (file or buffer) @2 lines @3 to @4 (0 for all of it) to the question
; being written in the current chat, merged with the attachments of the same file it
; overlaps. #p9 is the attachment line, "" when it was already attached
0 define-macro ai-chat-attach
  set-variable #l4 @1
  set-variable #l5 @2
  set-variable #l6 @3
  set-variable #l7 @4
  ai-chat-attach-point
  set-variable #l9 1
  ; a merge can make the new range overlap an attachment already passed, so repeat
  !while #l9
    set-variable #l9 0
    set-variable $window-line #l8
    !repeat
      !if &xse @wl .ai-chat.att-line
        set-variable #l0 @s1
        set-variable #l1 @s2
        ai-att-parse #l0 #l1
        !if &and &seq #l0 #l4 &seq #l1 #l5
          !if &not #l2
            set-variable #p9 ""
            !return
          !elif &or &not #l6 &not &or &les #l7 &sub #l2 1 &gre #l6 &add #l3 1
            ; whole file or an overlapping range, it replaces this line
            !if #l6
              !iif &les #l2 #l6  set-variable #l6 #l2
              !iif &gre #l3 #l7  set-variable #l7 #l3
            !endif
            beginning-of-line
            set-mark
            forward-line
            -1 kill-region
            set-variable #l9 1
            !break
          !endif
        !endif
      !elif &not &xse @wl "[ \t]*"
        !break
      !endif
      !iif &seq @wc ""  !break
      forward-line
    !done
  !done
  ai-chat-attach-point
  ; shorten a file name under the home directory
  set-variable #l0 #l5
  !if &and &seq #l4 "file" &not &seq $HOME "ERROR"
    !iif &seq &lef #l0 &add &len $HOME 1 &cat $HOME "/"  set-variable #l0 &cat "~" &rig #l0 &len $HOME
  !endif
  set-variable #l0 &spr "@%s %s" #l4 #l0
  !iif #l6  set-variable #l0 &cat #l0 &con &equ #l6 #l7 &spr ":%d" #l6 &spr ":%d-%d" #l6 #l7
  insert-string &cat #l0 "\n"
  set-variable #p9 #l0
!emacro

; set #p9 to a | list of the names of the open chats other than *ai-chat*
0 define-macro ai-chat-names
  set-variable #l0 $buffer-bname
  set-variable $buffer-names "^\\*ai-chat\\(:.*\\)?\\*$"
  set-variable #l1 "|"
  !while &not &seq &set #l2 $buffer-names ""
    !iif &gre &len #l2 10  set-variable #l1 &spr "%s%s|" #l1 &mid #l2 9 &sub &len #l2 10
  !done
  set-variable #p9 #l1
!emacro

; show the chat in a popup window and move to its end. With an argument it asks which chat, by
; name, starting one when there is none of that name, empty for *ai-chat*
define-macro ai-chat
  !if @?
    ai-chat-names
    !force set-variable #l1 @ml09 "AI chat (empty for the main chat)" #l9
    !iif &not $status  !abort
    set-variable #l1 &trb #l1
    set-variable .ai-chat.current &con &len #l1 &spr "*ai-chat:%s*" #l1 "*ai-chat*"
  !elif &exi :ai-chat
    ; the chat in use is the one last shown
    set-variable .ai-chat.current $buffer-bname
  !endif
  !if &not &seq $buffer-bname .ai-chat.current
    !force 0 popup-window .ai-chat.current
    !iif &not $status  1 popup-window .ai-chat.current
  !endif
  ai-chat-buffer
  end-of-buffer
!emacro

; parse the attachment of type @1 (file or buffer) and text @2, sets #p1 to the absolute file
; name or the buffer name and #p2 & #p3 to its first & last line, 0 for all of it
0 define-macro ai-att-parse
  set-variable #l0 @1
  set-variable #l1 @2
  set-variable #l2 0
  set-variable #l3 0
  ; only a file or buffer takes lines, a command is left as it is
  !if &not &lfind "|file|buffer|" #l0
  !elif &xse #l1 "\\(.*[^ \t\n]\\)[ \t]*:\\([0-9]+\\)\\(-\\([0-9]+\\)\\)?"
    set-variable #l1 @s1
    set-variable #l2 @s2
    set-variable #l3 &con &seq @s4 "" #l2 @s4
    !iif &les #l2 1  set-variable #l2 1
    !iif &les #l3 #l2  set-variable #l3 #l2
  !endif
  !if &seq #l0 "cmd"
    set-variable #l1 &rep #l1 "\t" " "
  !elif &not &seq #l0 "buffer"
    set-variable #l1 &stat "a" #l1
    ; a directory's absolute name ends in a /
    !iif &and &gre &len #l1 1 &seq &rig #l1 &sub &len #l1 1 "/"  set-variable #l1 &lef #l1 &sub &len #l1 1
  !endif
  set-variable #p1 #l1
  set-variable #p2 #l2
  set-variable #p3 #l3
!emacro

; set #p9 to the buffer holding file @1, an absolute name, or "" when it is not loaded
0 define-macro ai-file-buffer
  set-variable #l1 @1
  set-variable #l0 $buffer-bname
  set-variable #l2 &rig #l1 &rsin "/" #l1
  str-to-regex #l2
  set-variable $buffer-names &spr "^%s\\(<[0-9]+>\\)?$" #l2
  set-variable #l3 "|"
  !while &not &seq &set #l4 $buffer-names ""
    set-variable #l3 &spr "%s%s|" #l3 #l4
  !done
  set-variable #p9 ""
  set-variable #l5 0
  !while &not &seq &set #l4 &lget #l3 &inc #l5 1 ""
    find-buffer #l4
    !if &or &seq $buffer-fname #l1 &and &seq $platform "windows" &iseq $buffer-fname #l1
      set-variable #p9 #l4
      !break
    !endif
  !done
  find-buffer #l0
!emacro

; set #p7 to the shortest end of file name @1 that no other file in *ai-att* ends with
0 define-macro ai-att-label
  set-variable #l1 @1
  set-variable #l2 &rig #l1 &rsin "/" #l1
  set-variable #l0 $window-line
  !repeat
    set-variable #l3 0
    beginning-of-buffer
    !while &not &seq @wc ""
      !if &seq &lget @wl 1 "file"
        set-variable #l4 &cat "/" &lget @wl 2
        !if &and &not &seq #l4 &cat "/" #l1 &gre &len #l4 &len #l2
          !iif &seq &rig #l4 &sub &len #l4 &add &len #l2 1 &cat "/" #l2  set-variable #l3 1
        !endif
      !endif
      forward-line
    !done
    !iif &not #l3  !break
    set-variable #l4 &lef #l1 &sub &sub &len #l1 &len #l2 1
    !if &not &rsin "/" #l4
      set-variable #l2 #l1
      !break
    !endif
    set-variable #l2 &rig #l1 &rsin "/" #l4
  !done
  set-variable $window-line #l0
  set-variable #p7 #l2
!emacro

; list the attachments of the "## You" sections of the current chat in *ai-att*, one a line
; as a tab separated list of type, name, first & last line, the chat line of its last
; mention and its label, #p9 is the number of attachments
0 define-macro ai-att-scan
  set-variable #l0 $buffer-bname
  ai-temp-buffer "*ai-att*"
  find-buffer #l0
  ai-chat-map
  set-variable #l8 0
  !while &not &seq &set #l6 &lget .ai-chat.map-atts &inc #l8 1 ""
    set-variable $window-line #l6
    !if &xse @wl .ai-chat.att-line
      set-variable #l4 @s1
      set-variable #l5 @s2
      ai-att-parse #l4 #l5
      set-variable #l7 &spr "\t%s\t%s\t%d\t%d\t" #l4 #l1 #l2 #l3
      find-buffer "*ai-att*"
      beginning-of-buffer
      !while &and &not &seq @wc "" &not &seq &lef @wl &len #l7 #l7
        forward-line
      !done
      !if &seq @wc ""
        insert-string &spr "%s%d\t\t\n" #l7 #l6
      !else
        set-variable @wl &spr "%s%d\t\t" #l7 #l6
      !endif
      find-buffer #l0
    !endif
  !done
  ; a file is named by the shortest end of its name that no other file ends with, a directory
  ; shown under the home directory
  find-buffer "*ai-att*"
  beginning-of-buffer
  set-variable #l9 0
  set-variable #l8 0
  !while &not &seq @wc ""
    set-variable #l1 @wl
    set-variable #l3 &lget #l1 1
    set-variable #l7 &lget #l1 2
    !if &seq #l3 "file"
      set-variable #l2 #l7
      ai-att-label #l2
    !elif &lfind "|diff|tree|" #l3
      ai-home-name #l7
      set-variable #l7 #l9
    !endif
    set-variable @wl &lset #l1 6 #l7
    !iif &lfind "|file|buffer|" #l3  set-variable #l8 &add #l8 1
    forward-line
  !done
  end-of-buffer
  set-variable #l9 &sub $window-line 1
  find-buffer #l0
  set-variable #p9 #l9
  set-variable #p8 #l8
!emacro

; set #p9 to file name @1 with the home directory as ~
0 define-macro ai-home-name
  set-variable #l1 @1
  !if &not &seq $HOME "ERROR"
    !iif &seq &lef #l1 &add &len $HOME 1 &cat $HOME "/"  set-variable #l1 &cat "~" &rig #l1 &len $HOME
    !iif &seq #l1 $HOME  set-variable #l1 "~"
  !endif
  set-variable #p9 #l1
!emacro

; set #p6 to the *ai-att* record of attachment @1 @2 lines @3 to @4
0 define-macro ai-att-find
  set-variable #l1 &spr "\t%s\t%s\t%d\t%d\t" @1 @2 @3 @4
  set-variable #l0 $buffer-bname
  find-buffer "*ai-att*"
  beginning-of-buffer
  !while &and &not &seq @wc "" &not &seq &lef @wl &len #l1 #l1
    forward-line
  !done
  set-variable #p6 @wl
  find-buffer #l0
!emacro

; fill *ai-att-text* with lines @3 to @4 (0 for all) of file or buffer @1 @2, from its buffer
; when loaded so unsaved changes are sent. Sets #p7 to its language, #p8 to its line count
; and #p9 to why it could not be read or ""
0 define-macro ai-att-read
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 @4
  set-variable #l7 ""
  set-variable #l8 0
  !if &lfind "|cmd|diff|tree|" #l1
    ai-att-run #l1 #l2
    find-buffer #l0
    set-variable #p7 #l7
    set-variable #p8 #l8
    set-variable #p9 #l9
    !return
  !elif &seq #l1 "buffer"
    set-variable #l5 &con &exi &spr ":%s:" #l2 #l2 ""
    set-variable #l9 &con &len #l5 "" "there is no such buffer"
  !else
    ai-file-buffer #l2
    set-variable #l5 #l9
    set-variable #l9 ""
    !if &len #l5
      ; a collapsed part is not in the buffer's lines, read the saved file instead
      find-buffer #l5
      !if &bmo "narrow"
        !iif &bmo "edit"  set-variable #l9 "it has collapsed parts and unsaved changes"
        set-variable #l5 ""
      !endif
      find-buffer #l0
    !endif
    !if &and &not &len #l5 &not &len #l9
      set-variable #l6 &stat "t" #l2
      !if &seq #l6 "D"
        set-variable #l9 "it is a directory"
      !elif &not &seq #l6 "R"
        set-variable #l9 "the file was not found"
      !endif
    !endif
  !endif
  ai-temp-buffer "*ai-att-text*"
  !if &len #l9
  !elif &len #l5
    find-buffer #l5
    0x6c0 set-position "\xa6"
    end-of-buffer
    set-variable #l8 &sub $window-line 1
    !if &and #l8 &not &gre #l3 #l8
      set-variable $window-line &con #l3 #l3 1
      set-mark
      !if &or &not #l4 &not &les #l4 #l8
        end-of-buffer
      !else
        set-variable $window-line &add #l4 1
      !endif
      set-variable #l6 $system
      set-variable $system &bor #l6 0x800000
      copy-region
      !force 0x6c0 goto-position "\xa6"
      set-variable #l7 $buffer-major-mode
      find-buffer "*ai-att-text*"
      !force yank
      -1 yank
      set-variable $system #l6
    !else
      !force 0x6c0 goto-position "\xa6"
    !endif
    !iif &lfind "|default|txt|" #l7  set-variable #l7 ""
  !else
    !force insert-file #l2
    !iif &not $status  set-variable #l9 "the file could not be read"
    end-of-buffer
    set-variable #l8 &sub $window-line 1
    !if &and #l3 &not &gre #l3 #l8
      !if &les #l4 #l8
        set-variable $window-line &add #l4 1
        set-mark
        end-of-buffer
        -1 kill-region
      !endif
      !if &gre #l3 1
        beginning-of-buffer
        set-mark
        set-variable $window-line #l3
        -1 kill-region
      !endif
    !endif
    set-variable #l6 &rig #l2 &rsin "/" #l2
    set-variable #l7 &con &rsin "." #l6 &rig #l6 &rsin "." #l6 ""
  !endif
  ; a NUL byte would make the request invalid, the model cannot use a binary file anyway
  !if &not &len #l9
    find-buffer "*ai-att-text*"
    beginning-of-buffer
    ; the search also finds the characters past U+00FF
    !repeat
      !force search-buffer "me" "[^\x01-\xff]"
      !iif &not $status  !break
      backward-char
      !iif &not &atoi @wc  set-variable #l9 "it is a binary file"
      forward-char
    !until &len #l9
  !endif
  find-buffer #l0
  set-variable #p7 #l7
  set-variable #p8 #l8
  set-variable #p9 #l9
!emacro

; set #p9 to "y" when command @1 may be run for an attachment of chat .ai-attach.chat, asking the
; first time in each chat
0 define-macro ai-cmd-allowed
  set-variable #l1 @1
  set-variable #l2 &ind &spr ":%s:ai-cmd-ok" .ai-attach.chat
  !iif &seq #l2 "ERROR"  set-variable #l2 "\x01"
  !if &lfind #l2 #l1
    set-variable #p9 "y"
    !return
  !endif
  !force set-variable #l9 @mc1 &spr "Run \"%s\" for its attachment (y/n)? " #l1 "yYnN"
  !iif &not $status  set-variable #l9 "n"
  set-variable #l9 &slo #l9
  !iif &seq #l9 "y"  ai-cmd-allow #l1 .ai-attach.chat
  set-variable #p9 #l9
!emacro

; let command @1 be run for the attachments of chat buffer @2 without asking
0 define-macro ai-cmd-allow
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 &ind &spr ":%s:ai-cmd-ok" #l2
  !iif &seq #l3 "ERROR"  set-variable #l3 "\x01"
  !iif &not &lfind #l3 #l1  set-variable &ind &spr ":%s:ai-cmd-ok" #l2 &spr "%s%s\x01" #l3 #l1
!emacro

; fill *ai-att-text* with the output of the attachment of type @1 (cmd, diff or tree) @2, run in
; a shell. Sets #p7 to its language, #p8 to its line count and #p9 to why it was not run or "",
; .ai-attach.rc to the exit code and .ai-attach.cut to the number of lines there were when cut short
0 define-macro ai-att-run
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l0 $buffer-bname
  set-variable #p8 0
  set-variable #p9 ""
  set-variable .ai-attach.rc 0
  set-variable .ai-attach.cut 0
  set-variable #p7 &con &seq #l1 "diff" "diff" "text"
  ai-temp-buffer "*ai-att-text*"
  find-buffer #l0
  !if &seq #l1 "cmd"
    ai-cmd-allowed #l2
    !if &not &seq #l9 "y"
      set-variable #p9 "the command was not run"
      !return
    !endif
    set-variable #l3 #l2
  !else
    ; the name is passed in double quotes, which these characters would get out of
    !if &or &sin "\"" #l2 &or &sin "$" #l2 &sin "`" #l2
      set-variable #p9 "its name has a quote, $ or ` in it"
      !return
    !endif
    set-variable #l4 &stat "t" #l2
    !if &seq #l4 "D"
      set-variable #l5 #l2
      set-variable #l6 "."
    !elif &seq #l1 "tree"
      set-variable #p9 "it is not a directory"
      !return
    !else
      set-variable #l5 &lef #l2 &rsin "/" #l2
      set-variable #l6 &rig #l2 &rsin "/" #l2
    !endif
    !if &seq #l1 "diff"
      set-variable #l3 &spr "git -C \"%s\" --no-pager diff --no-ext-diff --no-color HEAD -- \"%s\"" #l5 #l6
    !else
      set-variable #l3 &spr "git -C \"%s\" ls-files" #l5
    !endif
  !endif
  !force 0x42 pipe-shell-command #l3 "*ai-att-text*"
  set-variable .ai-attach.rc $result
  ; the output is read only
  find-buffer "*ai-att-text*"
  -1 buffer-mode "view"
  1 buffer-mode "hide"
  find-buffer #l0
  ; a directory that is not in git is listed by the editor
  !if &and &seq #l1 "tree" &not &equ .ai-attach.rc 0
    ai-temp-buffer "*ai-att-text*"
    ai-att-walk #l2
    set-variable .ai-attach.rc 0
  !endif
  find-buffer "*ai-att-text*"
  end-of-buffer
  set-variable #l8 &sub $window-line 1
  !if &gre #l8 %ai-attach-cmd-lines
    set-variable .ai-attach.cut #l8
    set-variable $window-line &add %ai-attach-cmd-lines 1
    set-mark
    end-of-buffer
    -1 kill-region
    set-variable #l8 %ai-attach-cmd-lines
  !endif
  find-buffer #l0
  set-variable #p8 #l8
!emacro

; list the files under directory @1 in the current buffer, relative to it and up to
; %ai-attach-cmd-lines of them, leaving out those whose names start with a dot
0 define-macro ai-att-walk
  set-variable #l1 @1
  set-variable #l0 $buffer-bname
  ai-temp-buffer "*ai-att-dirs*"
  insert-string "\n"
  set-variable #l2 1
  set-variable #l3 0
  !repeat
    find-buffer "*ai-att-dirs*"
    set-variable $window-line #l2
    !iif &seq @wc ""  !break
    set-variable #l4 @wl
    set-variable #l2 &add #l2 1
    set-variable $file-names &spr "%s/%s.*" #l1 #l4
    !while &not &seq &set #l5 $file-names ""
      !if &seq &lef #l5 1 "."
      !elif &seq &rig #l5 &sub &len #l5 1 "/"
        find-buffer "*ai-att-dirs*"
        end-of-buffer
        insert-string &spr "%s%s\n" #l4 #l5
      !elif &les #l3 %ai-attach-cmd-lines
        find-buffer #l0
        insert-string &spr "%s%s\n" #l4 #l5
        set-variable #l3 &add #l3 1
      !endif
    !done
  !done
  !force 0 delete-buffer "*ai-att-dirs*"
  find-buffer #l0
!emacro

; note a problem with an attachment for the request message
0 define-macro ai-att-warn
  set-variable .ai-send.req-bad &add .ai-send.req-bad 1
  set-variable .ai-send.req-warn &con &equ .ai-send.req-bad 1 @1 &spr "%d attachments not sent" .ai-send.req-bad
!emacro

; replace the empty line at the point in *ai-req* with attachment @1 (file or buffer) @2 lines
; @3 to @4 (0 for all), its text when chat line @5 is its last mention, else a pointer to it
0 define-macro ai-att-insert
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 @4
  set-variable #l5 @5
  ai-att-find #l1 #l2 #l3 #l4
  !if &lfind "|cmd|diff|tree|" #l1
    ai-att-insert-run #l1 #l2 &lget #l6 6 &equ &lget #l6 5 #l5
    !return
  !endif
  set-variable #l0 &spr "%s %s" #l1 &lget #l6 6
  !if &not &equ &lget #l6 5 #l5
    !iif #l3  set-variable #l0 &cat #l0 &con &equ #l3 #l4 &spr " line %d" #l3 &spr " lines %d-%d" #l3 #l4
    insert-string &spr "(Attached %s, its current text is in a later message.)" #l0
    !return
  !endif
  ai-att-read #l1 #l2 #l3 #l4
  !if &len #l9
    insert-string &spr "(Attached %s could not be read, %s.)" #l0 #l9
    ai-att-warn &spr "%s not sent" &lget #l6 6
    !return
  !elif &gre #l3 #l8
    insert-string &spr "(Attached %s lines %d-%d are past its end, it has %d lines.)" #l0 #l3 #l4 #l8
    ai-att-warn &spr "%s:%d is past its end" &lget #l6 6 #l3
    !return
  !elif #l3
    !iif &gre #l4 #l8  set-variable #l4 #l8
    set-variable #l0 &spr "Attached %s %s of %d:" #l0 &con &equ #l3 #l4 &spr "line %d" #l3 &spr "lines %d-%d" #l3 #l4 #l8
  !else
    set-variable #l0 &spr "Attached %s, %d line%s:" #l0 #l8 &con &equ #l8 1 "" "s"
  !endif
  ai-att-fenced #l0 #l7
!emacro

; insert at the point in *ai-req* the attachment of type @1 (cmd, diff or tree) @2 labelled @3,
; its output when @4 is 1 else a pointer to its last mention
0 define-macro ai-att-insert-run
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 @4
  !if &seq #l1 "cmd"
    set-variable #l0 &spr "The output of the command `%s`" #l3
  !elif &seq #l1 "diff"
    set-variable #l0 &spr "The git diff of %s" #l3
  !else
    set-variable #l0 &spr "The files under %s" #l3
  !endif
  !if &not #l4
    insert-string &spr "(%s, as it is now, is in a later message.)" #l0
    !return
  !endif
  ai-att-read #l1 #l2 0 0
  !if &len #l9
    insert-string &spr "(%s is not given, %s.)" #l0 #l9
    ai-att-warn &spr "%s not sent" #l3
    !return
  !elif &and &not #l8 &seq #l1 "diff"
    insert-string &spr "(%s shows no changes.)" #l0
    set-variable .ai-send.req-atts &add .ai-send.req-atts 1
    !return
  !endif
  !iif &and .ai-attach.rc &seq #l1 "cmd"  set-variable #l0 &spr "%s, exit code %d" #l0 .ai-attach.rc
  !if .ai-attach.cut
    set-variable #l0 &spr "%s, the first %d of its %d lines:" #l0 #l8 .ai-attach.cut
  !elif &seq #l1 "tree"
    set-variable #l0 &spr "%s, %d file%s:" #l0 #l8 &con &equ #l8 1 "" "s"
  !else
    set-variable #l0 &spr "%s, %d line%s:" #l0 #l8 &con &equ #l8 1 "" "s"
  !endif
  ai-att-fenced #l0 #l7
!emacro

; insert at the point in *ai-req* the text of *ai-att-text* in a code block of language @2 after
; the line @1
0 define-macro ai-att-fenced
  set-variable #l0 @1
  set-variable #l7 @2
  find-buffer "*ai-att-text*"
  ; fence it with more backticks than any fence in the text
  set-variable #l3 3
  beginning-of-buffer
  !repeat
    !force search-buffer "me" "^[ \t]*\\(````*\\)"
    !iif &not $status  !break
    !iif &not &les &len @s1 #l3  set-variable #l3 &add &len @s1 1
  !done
  set-variable #l3 &spr "%n" #l3 "`"
  beginning-of-buffer
  insert-string &spr "%s\n%s%s\n" #l0 #l3 #l7
  ; the copy ends after the closing fence, the line it replaces has the newline
  end-of-buffer
  insert-string #l3
  set-mark
  beginning-of-buffer
  set-variable #l6 $system
  set-variable $system &bor #l6 0x800000
  copy-region
  find-buffer .ai-attach.into
  !force yank
  -1 yank
  set-variable $system #l6
  set-variable .ai-send.req-atts &add .ai-send.req-atts 1
!emacro

; expand the attachment lines, as mapped by ai-chat-map, in the text of the "## You" section just
; added to *ai-req*, which is chat lines @1 to @2 (exclusive)
0 define-macro ai-att-expand
  set-variable #l5 @1
  set-variable $window-line .ai-send.req-line
  set-variable $window-col .ai-send.req-col
  ; put the text on its own lines so an attachment on its first line is expanded
  insert-string "\n"
  ; the line in *ai-req* of a chat line, less the chat line
  set-variable #l4 &sub $window-line #l5
  set-variable #l0 0
  !while &not &seq &set #l9 &lget .ai-chat.map-atts &inc #l0 1 ""
    !if &and &not &les #l9 #l5 &les #l9 @2
      set-variable $window-line &add #l9 #l4
      !if &xse @wl .ai-chat.att-line
        set-variable #l7 @s1
        set-variable #l8 @s2
        beginning-of-line
        set-mark
        end-of-line
        -1 kill-region
        set-variable #l6 $window-line
        ai-att-parse #l7 #l8
        ai-att-insert #l7 #l1 #l2 #l3 #l9
        set-variable #l4 &add #l4 &sub $window-line #l6
      !endif
    !endif
  !done
  set-variable $window-line .ai-send.req-line
  end-of-line
  forward-delete-char
  ; back to the end of the text, the buffer ends in an empty line
  end-of-buffer
  backward-char
!emacro

; JSON request building, the text of a message is inserted at the end of *ai-req* between
; ai-req-open and ai-req-close. .ai-send.req-n counts the messages so far and .ai-send.req-mline & mcol are
; where the current one starts, so it can be dropped. Role @1 is user, assistant, system or tool,
; a tool's result being for call @2
0 define-macro ai-req-open
  end-of-buffer
  set-variable .ai-send.req-mline $window-line
  set-variable .ai-send.req-mcol $window-col
  !iif .ai-send.req-n  insert-string ","
  !if &not &seq @1 "tool"
    insert-string &spr "{\"role\":\"%s\",\"content\":\"" @1
  !elif .ai-send.req-resp
    insert-string &spr "{\"type\":\"function_call_output\",\"call_id\":\"%s\",\"output\":\"" @2
  !else
    insert-string &spr "{\"role\":\"tool\",\"tool_call_id\":\"%s\",\"content\":\"" @2
  !endif
  set-variable .ai-send.req-line $window-line
  set-variable .ai-send.req-col $window-col
!emacro

; end the message started by ai-req-open
0 define-macro ai-req-close
  ai-req-escape
  insert-string "\"}"
  set-variable .ai-send.req-n &add .ai-send.req-n 1
!emacro

; drop the message started by ai-req-open
0 define-macro ai-req-drop
  set-variable $window-line .ai-send.req-mline
  set-variable $window-col .ai-send.req-mcol
  set-mark
  end-of-buffer
  -1 kill-region
!emacro

; escape the text from .ai-send.req-line & .ai-send.req-col to the point for a JSON string and join its lines,
; flag 16 writes a line without its newline. The point is left at its end
0 define-macro ai-req-escape
  set-variable #l1 $window-line
  set-variable $window-line .ai-send.req-line
  set-variable $window-col .ai-send.req-col
  !repeat
    !force search-buffer "me" "[\\\\\"\x01-\x09\x0b-\x1f]"
    !iif &not $status  !break
    backward-char
    set-variable #l0 &atoi @wc
    forward-delete-char
    !if &equ #l0 92
      insert-string "\\\\"
    !elif &equ #l0 34
      insert-string "\\\""
    !elif &equ #l0 9
      insert-string "\\t"
    !elif &equ #l0 13
      insert-string "\\r"
    !else
      insert-string &spr "\\u%04x" #l0
    !endif
  !done
  set-variable $window-line .ai-send.req-line
  !while &les $window-line #l1
    end-of-line
    insert-string "\\n"
    set-variable $line-flags &bor $line-flags 16
    forward-line
  !done
  end-of-line
!emacro

; set #p9 to the file named by line of text @1 written above a code block, as a model may name
; the file a block of SEARCH and REPLACE changes is for, else ""
0 define-macro ai-name-above
  set-variable #l1 &trb @1
  set-variable #p9 ""
  !iif &xse #l1 "\\(#+\\|[-*]\\)[ \t]+\\(.*\\)"  set-variable #l1 &trb @s2
  !iif &xse #l1 "\\(file\\|filename\\|path\\)[ \t]*:[ \t]*\\(.*\\)"  set-variable #l1 &trb @s2
  ; bold, quotes and a trailing colon around it
  !while &and &len #l1 &sin &lef #l1 1 "*`\"'"
    set-variable #l1 &rig #l1 1
  !done
  !while &and &len #l1 &sin &rig #l1 &sub &len #l1 1 "*`\"':"
    set-variable #l1 &lef #l1 &sub &len #l1 1
  !done
  !iif &not &xse #l1 "[^ \t*`\"']*[./][^ \t*`\"']*"  !return
  ; not a sentence's end or a number
  !iif &xse #l1 "[0-9.]*"  !return
  !iif &seq &rig #l1 &sub &len #l1 1 "."  !return
  set-variable #p9 #l1
!emacro

; tidy the text of a reply just added to *ai-req*, from .ai-send.req-line & .ai-send.req-col to its end:
; the editor's notes and thinking blocks are removed, the status lines written after edit blocks
; are moved to *ai-req-st* to be reported in the next question, and the tool-call blocks are moved
; to *ai-req-tc* as a header line of call id, name and line count then its arguments. The point is
; left at the end of the text
0 define-macro ai-req-reply
  set-variable $window-line .ai-send.req-line
  set-variable $window-col .ai-send.req-col
  ; put the text on its own lines so its first line is seen
  insert-string "\n"
  ; #l1 the open fence, #l3 its line, #l4 what it holds, #l2 the name of the last block of changes
  set-variable #l1 ""
  set-variable #l2 "block"
  set-variable #l4 ""
  set-variable #l8 ""
  !repeat
    !force search-buffer "me" "^\\([ \t]*\\(```\\|~~~\\)\\|(edit [0-9]+ \\|\\[AI\\( error\\)?: \\)"
    !iif &not $status  !break
    beginning-of-line
    set-variable #l5 @wl
    !if &len #l1
      !if &xse #l5 "[ \t]*\\(```\\|~~~\\).*"
        ai-fence-line #l5 #l1
        set-variable #l1 .ai-chat.fence
        !if &not &len #l1
          !if &seq #l4 "thinking"
            ; the model's thinking is not sent back
            set-variable #l6 $window-line
            set-variable $window-line #l3
            set-mark
            set-variable $window-line &add #l6 1
            -1 kill-region
            !continue
          !elif &len #l4
            ; a tool call, its arguments
            set-variable #l6 $window-line
            set-variable #l7 &sub &sub #l6 #l3 1
            ai-req-move-tc #l3 #l6 #l4 #l7
            !continue
          !endif
        !endif
      !endif
    !elif &xse #l5 "[ \t]*\\(```\\|~~~\\).*"
      set-variable #l3 $window-line
      ai-fence-line #l5 ""
      set-variable #l1 .ai-chat.fence
      set-variable #l4 ""
      !if &xse #l5 "[ \t]*\\(```+\\|~~~+\\)[ \t]*thinking[ \t]*"
        set-variable #l4 "thinking"
      !elif &xse #l5 "[ \t]*\\(```+\\|~~~+\\)[ \t]*tool-call[ \t]+\\([-_.:A-Za-z0-9]+\\)[ \t]+\\([-_.:A-Za-z0-9]+\\)[ \t]*"
        set-variable #l4 &spr "%s\t%s" @s2 @s3
      !elif &xse #l5 .ai-chat.edit-fence-x
        set-variable #l2 &trb @s3
      !elif &xse #l5 "[ \t]*\\(```+\\|~~~+\\)[ \t]*\\(diff\\|patch\\)\\b.*"
        set-variable #l2 "diff"
      !elif &gre $window-line &add .ai-send.req-line 1
        backward-line
        set-variable #l6 @wl
        forward-line
        ai-name-above #l6
        !iif &len #l9  set-variable #l2 #l9
      !endif
    !elif &xse #l5 "(edit \\([0-9]+\\) \\(.*\\))"
      ; reported in the next question rather than as the model's own words
      set-variable #l6 &spr "- %s edit %s: %s\n" #l2 @s1 @s2
      set-variable #l7 $buffer-bname
      find-buffer "*ai-req-st*"
      end-of-buffer
      insert-string #l6
      find-buffer #l7
      set-mark
      forward-line
      -1 kill-region
      !continue
    !elif &xse #l5 "\\[AI error: .*"
      ; the editor's note of an error may run over lines to its closing ]
      set-mark
      !force search-buffer "me" "\\]$"
      !iif &not $status  end-of-buffer
      forward-line
      -1 kill-region
      !continue
    !elif &xse #l5 "\\[AI: .*\\]"
      set-mark
      forward-line
      -1 kill-region
      !continue
    !endif
    !force forward-line
    !iif &not $status  !break
  !done
  ; an unclosed thinking block runs to the end
  !if &seq #l4 "thinking"
    !if &len #l1
      set-variable $window-line #l3
      set-mark
      end-of-buffer
      -1 kill-region
    !endif
  !endif
  set-variable $window-line .ai-send.req-line
  end-of-line
  forward-delete-char
  ; without the blank lines left at the start or end
  !while &and &seq @wc "\n" &les $window-line &sub $window-eline 1
    forward-delete-char
  !done
  end-of-buffer
  !repeat
    !iif &and &equ $window-line .ai-send.req-line &not &gre $window-col .ai-send.req-col  !break
    backward-char
    !iif &not &sin @wc " \t\n"  !break
    forward-delete-char
  !done
  !iif &not &sin @wc " \t\n"  forward-char
!emacro

; move the tool call block of *ai-req* lines @1 to @2 (its fences) to *ai-req-tc*, @3 is its call
; id and name, @4 the number of argument lines
0 define-macro ai-req-move-tc
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 @4
  set-variable #l0 $buffer-bname
  find-buffer "*ai-req-tc*"
  end-of-buffer
  insert-string &spr "\t%s\t%d\t\n" #l3 #l4
  find-buffer #l0
  !if #l4
    set-variable $window-line &add #l1 1
    set-mark
    set-variable $window-line #l2
    set-variable #l5 $system
    set-variable $system &bor #l5 0x800000
    copy-region
    find-buffer "*ai-req-tc*"
    end-of-buffer
    !force yank
    -1 yank
    set-variable $system #l5
    find-buffer #l0
  !endif
  set-variable $window-line #l1
  set-mark
  set-variable $window-line &add #l2 1
  -1 kill-region
!emacro

; add the tool calls in *ai-req-tc* after the text of the assistant message just written, for
; the chat API as its tool_calls and for the responses API as function_call items after it
0 define-macro ai-req-tool-calls
  set-variable #l0 $buffer-bname
  !iif &not .ai-send.req-resp  insert-string ",\"tool_calls\":["
  set-variable #l9 0
  set-variable #l8 1
  !repeat
    find-buffer "*ai-req-tc*"
    set-variable $window-line #l8
    !iif &seq @wc ""  !break
    set-variable #l1 @wl
    set-variable #l2 &lget #l1 1
    set-variable #l3 &lget #l1 2
    set-variable #l4 &lget #l1 3
    set-variable #l8 &add &add #l8 1 #l4
    find-buffer #l0
    end-of-buffer
    !if .ai-send.req-resp
      !iif .ai-send.req-n  insert-string ","
      insert-string &spr "{\"type\":\"function_call\",\"call_id\":\"%s\",\"name\":\"%s\",\"arguments\":\"" #l2 #l3
    !else
      !iif #l9  insert-string ","
      insert-string &spr "{\"id\":\"%s\",\"type\":\"function\",\"function\":{\"name\":\"%s\",\"arguments\":\"" #l2 #l3
    !endif
    set-variable .ai-send.req-line $window-line
    set-variable .ai-send.req-col $window-col
    !if #l4
      find-buffer "*ai-req-tc*"
      set-variable $window-line &sub #l8 #l4
      set-mark
      set-variable $window-line #l8
      set-variable #l5 $system
      set-variable $system &bor #l5 0x800000
      copy-region
      find-buffer #l0
      !force yank
      -1 yank
      set-variable $system #l5
      ; without the newline that ended the last line
      backward-delete-char
    !else
      insert-string "{}"
    !endif
    ai-req-escape
    !if .ai-send.req-resp
      insert-string "\"}"
      set-variable .ai-send.req-n &add .ai-send.req-n 1
    !else
      insert-string "\"}}"
    !endif
    set-variable #l9 &add #l9 1
  !done
  find-buffer #l0
  !iif &not .ai-send.req-resp  insert-string "]"
!emacro

; the text of the edit results moved from the last reply to *ai-req-st*, put before the question
; just added to *ai-req*. The point is left at the end of the text
0 define-macro ai-req-results
  set-variable #l0 $buffer-bname
  find-buffer "*ai-req-st*"
  end-of-buffer
  set-variable #l1 &gre $window-line 1
  !if #l1
    beginning-of-buffer
    insert-string "Results of the edits in your last reply, as applied by the editor:\n"
    end-of-buffer
    insert-string "\n"
    set-mark
    beginning-of-buffer
    set-variable #l2 $system
    set-variable $system &bor #l2 0x800000
    copy-region
    -1 kill-region
    find-buffer #l0
    set-variable $window-line .ai-send.req-line
    set-variable $window-col .ai-send.req-col
    !force yank
    -1 yank
    set-variable $system #l2
  !endif
  find-buffer #l0
  end-of-buffer
  backward-char
!emacro

; copy the trimmed lines @3 to @4 (exclusive) of chat buffer @1 as a message for role @2, which is
; You, AI, System or Tool followed by its call id
0 define-macro ai-req-section
  set-variable #l1 @3
  set-variable #l2 @4
  set-variable #l5 @2
  set-variable #l6 ""
  !if &xse #l5 "Tool[ \t]+\\(.*\\)"
    set-variable #l6 @s1
    set-variable #l5 "Tool"
  !endif
  set-variable $window-line #l1
  !while &and &les #l1 #l2 &sin @wc "\n"
    forward-line
    set-variable #l1 &add #l1 1
  !done
  !repeat
    !if &not &les #l1 #l2
      ; a tool's result is needed by its call even when empty
      !iif &not &seq #l5 "Tool"  !return
      !break
    !endif
    set-variable $window-line &sub #l2 1
    !iif &not &sin @wc "\n"  !break
    set-variable #l2 &sub #l2 1
  !done
  set-variable #l3 $system
  !if &les #l1 #l2
    set-variable $window-line #l1
    set-mark
    set-variable $window-line &sub #l2 1
    end-of-line
    set-variable $system &bor #l3 0x800000
    copy-region
  !endif
  find-buffer "*ai-req*"
  !if &seq #l5 "Tool"
    ai-req-open "tool" #l6
  !else
    ai-req-open &con &seq #l5 "You" "user" &con &seq #l5 "AI" "assistant" "system" ""
  !endif
  !if &les #l1 #l2
    !force yank
    -1 yank
    set-variable $system #l3
  !endif
  !if &seq #l5 "You"
    ai-att-expand #l1 #l2
    ai-req-results
  !elif &seq #l5 "System"
    !iif .ai-send.req-natt  insert-string &cat "\n\n" %ai-edit-prompt
  !elif &seq #l5 "AI"
    ai-temp-buffer "*ai-req-tc*"
    find-buffer "*ai-req*"
    ai-req-reply
    find-buffer "*ai-req-tc*"
    end-of-buffer
    set-variable #l7 &gre $window-line 1
    find-buffer "*ai-req*"
    ; a reply left with no text, such as an error, is not sent, nor an empty one for the responses
    ; API, its calls are items of their own
    !if &and &equ $window-line .ai-send.req-line &equ $window-col .ai-send.req-col
      !if &or &not #l7 .ai-send.req-resp
        ai-req-drop
        !iif #l7  ai-req-tool-calls
        find-buffer @1
        !return
      !endif
    !endif
    ai-req-escape
    insert-string "\""
    !iif &and #l7 &not .ai-send.req-resp  ai-req-tool-calls
    insert-string "}"
    set-variable .ai-send.req-n &add .ai-send.req-n 1
    !iif &and #l7 .ai-send.req-resp  ai-req-tool-calls
    find-buffer @1
    !return
  !endif
  ai-req-close
  find-buffer @1
!emacro

; add the tools the model may call, read_file, search_files and list_files
0 define-macro ai-req-tools
  insert-string "\"tools\":["
  ai-req-tool "read_file" "Read lines of a file of the project. Ask for the lines needed, up to 500 at a time." "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"The file, relative to the project directory\"},\"start_line\":{\"type\":\"integer\",\"description\":\"The first line, from 1\"},\"end_line\":{\"type\":\"integer\",\"description\":\"The last line\"}},\"required\":[\"path\"]}"
  insert-string ","
  ai-req-tool "search_files" "Search the files of the project for lines matching an extended regular expression, giving file:line:text for each match, up to 200." "{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\",\"description\":\"The regular expression\"},\"path\":{\"type\":\"string\",\"description\":\"A directory or file to search, the whole project when not given\"}},\"required\":[\"pattern\"]}"
  insert-string ","
  ai-req-tool "list_files" "List the files of a directory of the project and those below it." "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"The directory, the project directory when not given\"}}}"
  insert-string "],"
!emacro

; a tool definition, name @1, description @2 and JSON parameters @3
0 define-macro ai-req-tool
  !if .ai-send.req-resp
    insert-string &spr "{\"type\":\"function\",\"name\":\"%s\",\"description\":\"%s\",\"parameters\":%s}" @1 @2 @3
  !else
    insert-string &spr "{\"type\":\"function\",\"function\":{\"name\":\"%s\",\"description\":\"%s\",\"parameters\":%s}}" @1 @2 @3
  !endif
!emacro

; insert value @2 of string field @1 escaped for JSON
0 define-macro ai-req-field
  insert-string &spr "\"%s\":\"" @1
  set-variable .ai-send.req-line $window-line
  set-variable .ai-send.req-col $window-col
  insert-string @2
  ai-req-escape
  insert-string "\""
!emacro

; build the request for the chat in the current buffer in a temporary file .ai-send.req-file, streamed
; when @1 is 1
0 define-macro ai-build-request
  set-variable #l0 $buffer-bname
  set-variable .ai-send.req-atts 0
  set-variable .ai-send.req-bad 0
  set-variable .ai-send.req-warn ""
  set-variable .ai-send.req-n 0
  set-variable .ai-send.req-resp &seq %ai-api "responses"
  ; the chat is mapped by the scan, the sections are between its role lines
  set-variable .ai-attach.chat #l0
  ai-att-scan
  set-variable .ai-send.req-natt #l8
  ai-temp-buffer "*ai-req-st*"
  ai-temp-buffer "*ai-req*"
  insert-string "{"
  ai-req-field "model" %ai-model
  insert-string &spr ",\"stream\":%s," &con @1 "true" "false"
  ; the reasoning effort is only sent when set, a model without reasoning may refuse it
  !if .ai-send.req-resp
    ; nothing is kept by the server, the whole chat is sent each time
    insert-string "\"store\":false,"
    !if &len %ai-effort
      insert-string "\"reasoning\":{"
      ai-req-field "effort" %ai-effort
      insert-string "},"
    !endif
  !else
    !iif &and @1 %ai-usage  insert-string "\"stream_options\":{\"include_usage\":true},"
    !if &len %ai-effort
      ai-req-field "reasoning_effort" %ai-effort
      insert-string ","
    !endif
  !endif
  set-variable #l1 &trb %ai-extra-json
  !iif &seq &rig #l1 &sub &len #l1 1 ","  set-variable #l1 &lef #l1 &sub &len #l1 1
  !iif &len #l1  insert-string &cat #l1 ","
  !iif %ai-tools  ai-req-tools
  insert-string &con .ai-send.req-resp "\"input\":[" "\"messages\":["
  find-buffer #l0
  set-variable #l4 0
  set-variable #l5 0
  !while &not &seq &set #l2 &lget .ai-chat.map-roles &inc #l5 1 ""
    set-variable $window-line #l2
    !iif &and &xse @wl .ai-chat.role-re &seq @s1 "System"  set-variable #l4 1
  !done
  ; with attachments the model is told how to reply with edits, a "## System" part included
  !if &not #l4
    !if &or &len %ai-system-prompt .ai-send.req-natt
      find-buffer "*ai-req*"
      ai-req-open "system" ""
      insert-string %ai-system-prompt
      !iif .ai-send.req-natt  insert-string &cat &con &len %ai-system-prompt "\n\n" "" %ai-edit-prompt
      ai-req-close
      find-buffer #l0
    !endif
  !endif
  set-variable #l5 0
  !while &not &seq &set #l2 &lget .ai-chat.map-roles &inc #l5 1 ""
    set-variable $window-line #l2
    !iif &not &xse @wl .ai-chat.role-re  !abort
    set-variable #l1 @s1
    set-variable #l3 &lget .ai-chat.map-roles &add #l5 1
    !iif &seq #l3 ""  set-variable #l3 &add $window-eline 1
    ai-req-section #l0 #l1 &add #l2 1 #l3
  !done
  find-buffer "*ai-req*"
  end-of-buffer
  insert-string "]}\n"
  set-variable .ai-send.req-file &cat $temp-name ".json"
  0 write-buffer .ai-send.req-file
  0 delete-buffer $buffer-bname
  !force 0 delete-buffer "*ai-req-st*"
  !force 0 delete-buffer "*ai-req-tc*"
  !force 0 delete-buffer "*ai-att*"
  !force 0 delete-buffer "*ai-att-text*"
  find-buffer #l0
!emacro

0 define-macro ai-json-hex4
  set-variable #l0 "0x"
  set-variable #l1 4
  !while &gre &pdec #l1 1 0
    set-variable #l0 &cat #l0 @wc
    !force forward-char
  !done
  set-variable #p9 &add #l0 0
!emacro

; decode the escapes from line @1 column @2 to the end of the buffer, each replacement
; is inserted before its escape is deleted so the alpha mark stays after the text. A
; long line split on load leaves a raw newline, rejoining could pass the line limit
0 define-macro ai-json-unescape
  set-variable $window-line @1
  set-variable $window-col @2
  !repeat
    !force search-buffer "Me" "\\"
    !iif &not $status  !break
    backward-char
    set-variable #l5 $window-line
    set-variable #l6 $window-col
    forward-char
    set-variable #l0 @wc
    set-variable #l3 2
    !if &seq #l0 "n"
      set-variable #l0 "\n"
    !elif &seq #l0 "t"
      set-variable #l0 "\t"
    !elif &seq #l0 "u"
      forward-char
      ai-json-hex4
      set-variable #l3 6
      !if &and &not &les #l9 0xD800 &les #l9 0xDC00
        set-variable #l4 #l9
        !if &seq @wc "\\"
          forward-char
          !if &seq @wc "u"
            forward-char
            ai-json-hex4
            set-variable #l4 &add 0x10000 &add &mul &sub #l4 0xD800 1024 &sub #l9 0xDC00
            set-variable #l3 12
          !endif
        !endif
        set-variable #l9 #l4
      !endif
      set-variable #l0 &itoa #l9
    !elif &sin #l0 "bfr"
      set-variable #l0 ""
    !endif
    set-variable $window-line #l5
    set-variable $window-col #l6
    !iif &len #l0  insert-string #l0
    ; one at a time, a count would put what is deleted in the kill buffer
    !while &gre &pdec #l3 1 0
      !force forward-delete-char
    !done
  !done
!emacro

; the point is just after the opening quote of a JSON string, the decoded string is
; inserted at alpha mark \xa4 of buffer @1, which then follows it, and the point is
; left after the closing quote
0 define-macro ai-json-string
  set-variable #l0 $buffer-bname
  set-variable #l1 $window-line
  set-variable #l2 $window-col
  !repeat
    !force search-buffer "me" "[\"\\\\]"
    !iif &not $status  !break
    backward-char
    !iif &seq @wc "\""  !break
    forward-char
    forward-char
  !done
  !if &or &gre $window-line #l1 &gre $window-col #l2
    set-variable #l3 $window-line
    set-variable #l4 $window-col
    set-variable $window-line #l1
    set-variable $window-col #l2
    set-mark
    set-variable $window-line #l3
    set-variable $window-col #l4
    set-variable #l5 $system
    set-variable $system &bor #l5 0x800000
    copy-region
    find-buffer @1
    ai-target-mark
    ; a line cannot grow past 65000 characters
    !iif &gre $window-col 60000  insert-string "\n"
    set-variable #l6 $window-line
    set-variable #l7 $window-col
    !force yank
    -1 yank
    ; the yank ends on this line unless the raw string was split on load
    set-alpha-mark "\xa4"
    set-variable $system #l5
    ai-json-unescape #l6 #l7
    find-buffer #l0
    set-variable $window-line #l3
    set-variable $window-col #l4
  !endif
  !force forward-char
!emacro

; the end of the reply so far, the buffer always ends in an empty line so
; end-of-buffer would start a new line
0 define-macro ai-target-mark
  !force goto-alpha-mark "\xa4"
  !iif &not $status  end-of-buffer
!emacro

0 define-macro ai-target-insert
  set-variable #l0 $buffer-bname
  find-buffer .ai-send.target
  ai-target-mark
  insert-string @1
  set-alpha-mark "\xa4"
  find-buffer #l0
!emacro

; put the error from the reply in the current buffer, or its first line, into the chat. @1 is the
; text to give when there is neither and @2 the HTTP status when it is known, else 0
0 define-macro ai-reply-error
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  beginning-of-buffer
  !force search-buffer "me" "\"message\"[ \t\r\n]*:[ \t\r\n]*\""
  !if $status
    ai-target-insert "[AI error: "
    ai-json-string .ai-send.target
    ai-target-insert "]"
  !else
    beginning-of-buffer
    !force search-buffer "me" "[^ \t\r\n]"
    !if $status
      beginning-of-line
      set-variable #l1 &trb @wl
    !endif
    !iif &gre #l2 0  set-variable #l1 &spr "HTTP %d, %s" #l2 #l1
    ai-target-insert &spr "[AI error: %s]" #l1
  !endif
  find-buffer #l0
!emacro

; the reply's text from the JSON string at the point, after the model's thinking when that was
; shown
0 define-macro ai-reply-text
  !if &equ .ai-send.think 1
    ai-target-insert "\n```\n\n"
    set-variable .ai-send.think 3
  !endif
  ai-json-string .ai-send.target
  set-variable .ai-send.got 1
!emacro

; the model's thinking from the JSON string at the point, shown in a thinking block before the
; reply when %ai-reasoning is 1, which is not sent back
0 define-macro ai-reply-reasoning
  !if &not %ai-reasoning
    set-variable .ai-send.think 2
  !elif &not .ai-send.got
    !if &not &equ .ai-send.think 1
      ai-target-insert "```thinking\n"
      set-variable .ai-send.think 1
    !endif
    ai-json-string .ai-send.target
  !endif
!emacro

; set .ai-send.usage-in, -out, -cached & -reasoning from the usage object after the point, the numbers
; are searched for with @1 search-buffer, -1 keeping to the line
0 define-macro ai-usage-parse
  set-variable #l9 @1
  set-variable #l1 $window-line
  set-variable #l2 $window-col
  !force #l9 search-buffer "me" "\"\\(prompt\\|input\\)_tokens\"[ \t\r\n]*:[ \t\r\n]*\\([0-9]+\\)"
  !iif $status  set-variable .ai-send.usage-in @s2
  set-variable $window-line #l1
  set-variable $window-col #l2
  !force #l9 search-buffer "me" "\"\\(completion\\|output\\)_tokens\"[ \t\r\n]*:[ \t\r\n]*\\([0-9]+\\)"
  !iif $status  set-variable .ai-send.usage-out @s2
  set-variable $window-line #l1
  set-variable $window-col #l2
  !force #l9 search-buffer "me" "\"cached_tokens\"[ \t\r\n]*:[ \t\r\n]*\\([0-9]+\\)"
  !iif $status  set-variable .ai-send.usage-cached @s1
  set-variable $window-line #l1
  set-variable $window-col #l2
  !force #l9 search-buffer "me" "\"reasoning_tokens\"[ \t\r\n]*:[ \t\r\n]*\\([0-9]+\\)"
  !iif $status  set-variable .ai-send.usage-reasoning @s1
  set-variable .ai-send.usage-got 1
!emacro

; start a new tool call with id @1 and name @2, its arguments go to *ai-tc-N*
0 define-macro ai-tc-add
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l0 $buffer-bname
  find-buffer "*ai-tc*"
  end-of-buffer
  insert-string &spr "\t%s\t%s\t\n" #l1 #l2
  ai-temp-buffer &spr "*ai-tc-%d*" .ai-send.tc-n
  set-variable .ai-send.tc-n &add .ai-send.tc-n 1
  find-buffer #l0
!emacro

; set field @2 (1 the id, 2 the name) of tool call @1 (from 0), adding calls up to it
0 define-macro ai-tc-set
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  !while &not &gre .ai-send.tc-n #l1
    ai-tc-add "" ""
  !done
  !iif &not &len #l3  !return
  set-variable #l0 $buffer-bname
  find-buffer "*ai-tc*"
  set-variable $window-line &add #l1 1
  set-variable @wl &lset @wl #l2 #l3
  find-buffer #l0
!emacro

; a function call of the responses API from the point, its fields searched for with @1
; search-buffer, -1 keeping to the line
0 define-macro ai-resp-call
  set-variable #l9 @1
  set-variable #l1 $window-line
  set-variable #l2 $window-col
  !force #l9 search-buffer "me" "\"call_id\"[ \t\r\n]*:[ \t\r\n]*\"\\([^\"\n]*\\)\""
  !iif &not $status  !return
  set-variable #l3 @s1
  set-variable $window-line #l1
  set-variable $window-col #l2
  !force #l9 search-buffer "me" "\"name\"[ \t\r\n]*:[ \t\r\n]*\"\\([^\"\n]*\\)\""
  !iif &not $status  !return
  set-variable #l4 @s1
  set-variable #l5 .ai-send.tc-n
  ai-tc-add #l3 #l4
  set-variable $window-line #l1
  set-variable $window-col #l2
  !force #l9 search-buffer "me" "\"arguments\"[ \t\r\n]*:[ \t\r\n]*\""
  !iif $status  ai-json-string &spr "*ai-tc-%d*" #l5
!emacro

; the tool_calls of a chat API delta on the current line, after the point. Each entry has an
; index and the first gives its id and name, its arguments come in parts
0 define-macro ai-stream-tool-calls
  !repeat
    !force -1 search-buffer "me" "\"index\"[ \t]*:[ \t]*\\([0-9]+\\)"
    !iif &not $status  !break
    set-variable #l1 @s1
    set-variable #l2 $window-col
    ; where the next entry starts
    set-variable #l3 1000000
    !force -1 search-buffer "me" "\"index\"[ \t]*:"
    !iif $status  set-variable #l3 $window-col
    set-variable $window-col #l2
    ai-tc-set #l1 0 ""
    !force -1 search-buffer "me" "\"id\"[ \t]*:[ \t]*\"\\([^\"\n]*\\)\""
    !if $status
      set-variable #l4 @s1
      !iif &les $window-col #l3  ai-tc-set #l1 1 #l4
    !endif
    set-variable $window-col #l2
    !force -1 search-buffer "me" "\"name\"[ \t]*:[ \t]*\"\\([^\"\n]*\\)\""
    !if $status
      set-variable #l4 @s1
      !iif &les $window-col #l3  ai-tc-set #l1 2 #l4
    !endif
    set-variable $window-col #l2
    !force -1 search-buffer "me" "\"arguments\"[ \t]*:[ \t]*\""
    !if $status
      !iif &les $window-col #l3  ai-json-string &spr "*ai-tc-%d*" #l1
    !endif
    set-variable $window-col #l2
    !iif &equ #l3 1000000  !break
  !done
!emacro

; the tool calls of a chat API reply, from the point after its "tool_calls"
0 define-macro ai-http-tool-calls
  !repeat
    !force search-buffer "me" "\"id\"[ \t\r\n]*:[ \t\r\n]*\"\\([^\"\n]*\\)\""
    !iif &not $status  !break
    set-variable #l1 @s1
    !force search-buffer "me" "\"name\"[ \t\r\n]*:[ \t\r\n]*\"\\([^\"\n]*\\)\""
    !iif &not $status  !break
    set-variable #l2 @s1
    set-variable #l5 .ai-send.tc-n
    ai-tc-add #l1 #l2
    !force search-buffer "me" "\"arguments\"[ \t\r\n]*:[ \t\r\n]*\""
    !iif $status  ai-json-string &spr "*ai-tc-%d*" #l5
  !done
!emacro

; add the tool calls received to the reply as tool-call blocks, which ask for them
0 define-macro ai-tc-write
  set-variable #l0 $buffer-bname
  set-variable #l1 0
  !while &les #l1 .ai-send.tc-n
    find-buffer "*ai-tc*"
    set-variable $window-line &add #l1 1
    set-variable #l2 &lget @wl 1
    set-variable #l3 &lget @wl 2
    ; an id the chat can hold, some servers give none
    set-variable #l2 &xrep #l2 "[^-_.:A-Za-z0-9]" "_"
    !iif &not &len #l2  set-variable #l2 &spr "call_%d" #l1
    set-variable #l3 &xrep #l3 "[^-_.:A-Za-z0-9]" "_"
    !if &len #l3
      ; after a blank line
      find-buffer .ai-send.target
      ai-target-mark
      !if &gre $window-col 0
        ai-target-insert "\n\n"
      !elif &gre $window-line 1
        backward-line
        set-variable #l4 &xse @wl "[ \t]*"
        forward-line
        !iif &not #l4  ai-target-insert "\n"
      !endif
      ai-target-insert &spr "```tool-call %s %s\n" #l2 #l3
      find-buffer &spr "*ai-tc-%d*" #l1
      end-of-buffer
      set-variable #l4 &or &gre $window-line 1 $window-col
      !if #l4
        set-mark
        beginning-of-buffer
        set-variable #l5 $system
        set-variable $system &bor #l5 0x800000
        copy-region
        find-buffer .ai-send.target
        ai-target-mark
        !force yank
        -1 yank
        set-alpha-mark "\xa4"
        set-variable $system #l5
      !else
        ai-target-insert "{}"
      !endif
      find-buffer .ai-send.target
      ai-target-mark
      ai-target-insert &con &gre $window-col 0 "\n```\n" "```\n"
    !endif
    !force 0 delete-buffer &spr "*ai-tc-%d*" #l1
    set-variable #l1 &add #l1 1
  !done
  !force 0 delete-buffer "*ai-tc*"
  find-buffer #l0
!emacro

; the lines of the reply that look like the status lines the editor writes after edit blocks
; were written by the model, which would stop their changes being applied, so are removed
0 define-macro ai-reply-unstatus
  goto-alpha-mark "\xa4"
  set-variable #l2 $window-line
  goto-alpha-mark "\xa5"
  set-variable #l1 ""
  !repeat
    !force search-buffer "me" "^\\([ \t]*\\(```\\|~~~\\)\\|(edit [0-9]+ \\)"
    !iif &or &not $status &gre $window-line #l2  !break
    beginning-of-line
    !if &xse @wl "[ \t]*\\(```\\|~~~\\).*"
      ai-fence-line @wl #l1
      set-variable #l1 .ai-chat.fence
    !elif &and &not &len #l1 &xse @wl "(edit [0-9]+ \\(applied\\|rejected\\|failed\\|skipped\\|undone\\)[,)].*"
      beginning-of-line
      set-mark
      forward-line
      -1 kill-region
      set-variable #l2 &sub #l2 1
      !continue
    !endif
    !force forward-line
    !iif &not $status  !break
  !done
!emacro

; the integer seconds of $unix-time
0 define-macro ai-now
  set-variable #l1 $unix-time
  set-variable #p9 &lef #l1 &sub &sin "." #l1 1
!emacro

; show how the request is going in the chat's mode line, once a second while it is busy
0 define-macro ai-tick
  !iif &not .ai-send.busy  !return
  !iif &not &exi &spr ":%s:" .ai-send.target  !return
  ai-now
  set-variable #l1 &sub #l9 .ai-send.t0
  !if .ai-send.retry-at
    set-variable #l2 &spr "trying again in %ds" &sub .ai-send.retry-at #l9
  !elif .ai-send.got
    set-variable #l2 &spr "writing %ds" #l1
  !elif .ai-send.tc-n
    set-variable #l2 &spr "asking for tools %ds" #l1
  !elif .ai-send.think
    set-variable #l2 &spr "thinking %ds" #l1
  !else
    set-variable #l2 &spr "waiting %ds" #l1
  !endif
  set-variable #l0 $buffer-bname
  find-buffer .ai-send.target
  ; after the buffer's name, so it is not cut off, and without a - which the mode line would fill
  set-variable #l3 &spr "[AI %s] " #l2
  !if &sin "%b" .ai-send.ml-saved
    set-variable $buffer-mode-line &rep .ai-send.ml-saved "%b" &cat "%b " #l3
  !else
    set-variable $buffer-mode-line &cat #l3 .ai-send.ml-saved
  !endif
  find-buffer #l0
  1000 create-callback ai-tick
!emacro

; put the chat's mode line back
0 define-macro ai-tick-stop
  !force -1 create-callback ai-tick
  !iif &not &exi &spr ":%s:" .ai-send.target  !return
  set-variable #l0 $buffer-bname
  find-buffer .ai-send.target
  !iif &len .ai-send.ml-saved  set-variable $buffer-mode-line .ai-send.ml-saved
  find-buffer #l0
!emacro

; the role line of the reply, with the model and the tokens used
0 define-macro ai-reply-role
  set-variable #l1 .ai-send.reply-info
  !if .ai-send.usage-got
    set-variable #l1 &spr "%s, %d tokens in" #l1 .ai-send.usage-in
    !iif .ai-send.usage-cached  set-variable #l1 &spr "%s (%d cached)" #l1 .ai-send.usage-cached
    set-variable #l1 &spr "%s, %d out" #l1 .ai-send.usage-out
    !iif .ai-send.usage-reasoning  set-variable #l1 &spr "%s (%d reasoning)" #l1 .ai-send.usage-reasoning
  !endif
  goto-alpha-mark "\xa5"
  set-variable #l2 0
  !while &and &gre $window-line 1 &les #l2 3
    backward-line
    !if &xse @wl .ai-chat.ai-re
      set-variable @wl &spr "## AI <!-- %s -->" #l1
      !return
    !endif
    set-variable #l2 &add #l2 1
  !done
!emacro

; there is no soft wrap, so split the long prose lines of the reply, between alpha marks
; \xa5 and \xa4, at the fill column, code blocks, tables and headings are left alone
0 define-macro ai-wrap-line
  set-variable #l1 $buffer-fill-col
  !iif &not &xse @wl "\\([ \t]*\\([-*+]\\|[0-9]+[.)]\\)?[ \t]*\\).*"  !return
  set-variable #l2 &len @s1
  !iif &not &les #l2 &div #l1 2  !return
  set-variable #l3 &lef .ai-chat.spaces #l2
  !repeat
    end-of-line
    !iif &not &gre $window-col #l1  !return
    set-variable $window-col #l1
    !while &and &gre $window-col #l2 &not &seq @wc " "
      backward-char
    !done
    !if &not &gre $window-col #l2
      set-variable $window-col #l1
      !force -1 search-buffer "Me" " "
      !iif &not $status  !return
      backward-char
    !endif
    !while &seq @wc " "
      forward-delete-char
    !done
    !iif &seq @wc "\n"  !return
    insert-string &cat "\n" #l3
    set-variable #p8 &add #p8 1
  !done
!emacro

0 define-macro ai-wrap-reply
  goto-alpha-mark "\xa4"
  set-variable #l8 $window-line
  goto-alpha-mark "\xa5"
  set-variable #l7 ""
  !while &not &gre $window-line #l8
    beginning-of-line
    !if &xse @wl "[ \t]*\\(```\\|~~~\\).*"
      ai-fence-line @wl #l7
      set-variable #l7 .ai-chat.fence
    !elif &not &len #l7
      !iif &not &xse @wl "\\(    \\|\t\\|[ \t]*[|#]\\).*"  ai-wrap-line
    !endif
    forward-line
  !done
!emacro

0 define-macro ai-finish
  set-variable #l0 $buffer-bname
  !iif &len .ai-send.req-file  !force 0x20 file-op .ai-send.req-file
  !iif &len .ai-send.hdr-file  !force 0x20 file-op .ai-send.hdr-file
  set-variable .ai-send.req-file ""
  set-variable .ai-send.hdr-file ""
  set-variable .ai-send.req-key ""
  set-variable .ai-send.retry-at 0
  ai-tick-stop
  find-buffer .ai-send.target
  ; the thinking shown is closed when no text came after it
  !if &equ .ai-send.think 1
    ai-target-insert "\n```\n"
    set-variable .ai-send.think 3
  !endif
  set-variable #l1 &and .ai-send.tc-n &not .ai-send.cancel
  !if .ai-send.tc-n
    !iif #l1  ai-tc-write
    !force 0 delete-buffer "*ai-tc*"
  !endif
  !iif .ai-send.got  ai-reply-unstatus
  !iif %ai-wrap  !force ai-wrap-reply
  ai-reply-role
  ; the edits of a reply to ai-edit are reviewed once the reply is in
  !if .ai-apply-edits.review-next
    set-variable .ai-apply-edits.review-next 0
    !if &and &and .ai-send.got &not .ai-send.cancel %ai-edit-review
      goto-alpha-mark "\xa5"
      ai-edit-any
      !if $result
        set-variable .ai-apply-edits.review-chat .ai-send.target
        set-variable .ai-apply-edits.review-keys &cat $recent-keys "x"
        1 create-callback ai-edit-review
      !endif
    !endif
  !endif
  ; a reply to ai-commit-message goes into the buffer it was asked from
  !if .ai-insert-block.insert-next
    set-variable .ai-insert-block.insert-next 0
    !if &and .ai-send.got &not .ai-send.cancel
      set-variable .ai-insert-block.insert-chat .ai-send.target
      set-variable .ai-apply-edits.review-keys &cat $recent-keys "x"
      1 create-callback ai-insert-review
    !endif
  !endif
  ; a reply cut short in a code block would hide the next role line
  ai-chat-map
  ai-chat-close-fence
  ai-chat-separate
  !if .ai-send.cancel
    insert-string "[AI: cancelled]\n\n"
  !elif &seq .ai-send.finish-reason "length"
    insert-string "[AI: the reply was cut short, it reached the model's output limit]\n\n"
  !elif &seq .ai-send.finish-reason "content_filter"
    insert-string "[AI: the reply was stopped by the content filter]\n\n"
  !endif
  ; the tools the model asks for are run once the user has said it may
  !if #l1
    set-variable .ai-send.tool-chat .ai-send.target
    set-variable .ai-apply-edits.review-keys &cat $recent-keys "x"
    1 create-callback ai-tool-review
  !else
    insert-string "## You\n\n"
  !endif
  ; the chat's running total
  !if .ai-send.usage-got
    set-variable :ai-tokens-in &add &con &exi :ai-tokens-in :ai-tokens-in 0 .ai-send.usage-in
    set-variable :ai-tokens-out &add &con &exi :ai-tokens-out :ai-tokens-out 0 .ai-send.usage-out
    set-variable #l2 &spr ", %d in + %d out tokens, the chat %d + %d" .ai-send.usage-in .ai-send.usage-out :ai-tokens-in :ai-tokens-out
  !else
    set-variable #l2 ""
  !endif
  !force ai-chat-save
  find-buffer #l0
  set-variable .ai-send.busy 0
  !if .ai-send.cancel
    ml-write "[AI: cancelled]"
  !elif #l1
    ml-write &spr "[AI: %s asks to use tools%s]" %ai-model #l2
  !elif .ai-send.got
    ml-write &spr "[AI: %s replied%s]" %ai-model #l2
  !else
    ml-write "[AI: request failed, see the chat]"
  !endif
!emacro

; $result is 1 when the reply from the point has changes the editor can apply
0 define-macro ai-edit-any
  set-variable #l1 $window-line
  set-variable $result 0
  !force search-buffer "me" .ai-chat.edit-fence
  !if &not $status
    set-variable $window-line #l1
    !force search-buffer "me" "^<<<<<<<+[ \t]*SEARCH[ \t]*$"
  !endif
  !if &not $status
    set-variable $window-line #l1
    !force search-buffer "me" "^@@ -[0-9]"
  !endif
  set-variable #l2 $status
  set-variable $window-line #l1
  set-variable $result #l2
!emacro

; wait %ai-retry-wait seconds, doubling each time, then send the request again
0 define-macro ai-retry-later
  set-variable #l1 @1
  set-variable .ai-send.attempt &add .ai-send.attempt 1
  set-variable #l2 %ai-retry-wait
  set-variable #l3 1
  !while &les #l3 .ai-send.attempt
    set-variable #l2 &mul #l2 2
    set-variable #l3 &add #l3 1
  !done
  ai-now
  set-variable .ai-send.retry-at &add #l9 #l2
  set-variable #l4 &mul #l2 1000
  #l4 create-callback ai-retry-send
  ml-write &spr "[AI: %s, trying again in %ds (%d of %d), C-c C-k cancels]" #l1 #l2 .ai-send.attempt %ai-retries
!emacro

0 define-macro ai-retry-send
  !iif &not .ai-send.retry-at  !return
  set-variable .ai-send.retry-at 0
  !iif &or &not .ai-send.busy .ai-send.cancel  !return
  !if &seq .ai-send.req-how "curl"
    !force ai-curl-run
  !else
    !force ai-http-start
  !endif
  !if &not $status
    ai-target-insert "[AI error: the request macro failed]"
    ai-finish
  !endif
!emacro

; $result is 1 when the reply in the current buffer, from the built in client, failed for a
; reason that may pass: no reply, a rate limit or a server error
0 define-macro ai-http-retryable
  beginning-of-buffer
  set-variable $result 1
  !force search-buffer "me" "[^ \t\r\n]"
  !iif &not $status  !return
  beginning-of-buffer
  !force search-buffer "me" "rate.limit\\|server_error\\|overloaded\\|temporarily unavailable\\|\"code\"[ \t\r\n]*:[ \t\r\n]*5[0-9][0-9]"
  set-variable $result $status
!emacro

; the reply of the built in client in the current buffer
0 define-macro ai-http-parse
  !if .ai-send.req-resp
    ; the responses API's thinking summaries, text and function calls, in order
    beginning-of-buffer
    !repeat
      !force search-buffer "me" "\"type\"[ \t\r\n]*:[ \t\r\n]*\"\\(output_text\\|summary_text\\|function_call\\)\""
      !iif &not $status  !break
      set-variable #l1 @s1
      set-variable #l2 $window-line
      set-variable #l3 $window-col
      !if &seq #l1 "function_call"
        ai-resp-call 1
      !else
        !force search-buffer "me" "\"text\"[ \t\r\n]*:[ \t\r\n]*\""
        !if $status
          !if &seq #l1 "output_text"
            ai-reply-text
          !else
            ai-reply-reasoning
          !endif
        !endif
      !endif
      set-variable $window-line #l2
      set-variable $window-col #l3
    !done
    beginning-of-buffer
    !force search-buffer "me" "\"incomplete_details\"[ \t\r\n]*:[ \t\r\n]*{[^}]*\"reason\"[ \t\r\n]*:[ \t\r\n]*\"\\([a-z_]+\\)\""
    !iif $status  set-variable .ai-send.finish-reason &con &seq @s1 "content_filter" "content_filter" "length"
  !else
    beginning-of-buffer
    !force search-buffer "me" "\"choices\"[ \t\r\n]*:"
    !if $status
      set-variable #l2 $window-line
      set-variable #l3 $window-col
      !force search-buffer "me" "\"reasoning\\(_content\\)?\"[ \t\r\n]*:[ \t\r\n]*\""
      !iif $status  ai-reply-reasoning
      set-variable $window-line #l2
      set-variable $window-col #l3
      !force search-buffer "me" "\"content\"[ \t\r\n]*:[ \t\r\n]*\""
      !iif $status  ai-reply-text
      set-variable $window-line #l2
      set-variable $window-col #l3
      !force search-buffer "me" "\"finish_reason\"[ \t\r\n]*:[ \t\r\n]*\"\\([a-z_]+\\)\""
      !iif $status  set-variable .ai-send.finish-reason @s1
      set-variable $window-line #l2
      set-variable $window-col #l3
      !force search-buffer "me" "\"tool_calls\"[ \t\r\n]*:[ \t\r\n]*\\["
      !iif $status  ai-http-tool-calls
    !endif
  !endif
  beginning-of-buffer
  !force search-buffer "me" "\"usage\"[ \t\r\n]*:[ \t\r\n]*{"
  !iif $status  ai-usage-parse 1
!emacro

; the built-in HTTP client, waits for the whole reply
0 define-macro ai-http-start
  set-variable #l0 $buffer-bname
  set-variable #l1 &exi %http-header
  !iif #l1  set-variable #l2 %http-header
  set-variable #l3 &exi %http-flags
  !iif #l3  set-variable #l4 %http-flags
  set-variable %http-header ":POST:Content-Type: application/json"
  !iif &len .ai-send.req-key  set-variable %http-header &spr "%s\r\nAuthorization: Bearer %s" %http-header .ai-send.req-key
  ; flag d would log the key to *http-console*
  !iif #l3  set-variable %http-flags &rep #l4 "d" ""
  set-variable %http-post-file .ai-send.req-file
  ai-temp-buffer "*ai-response*"
  ml-write &spr "[AI: waiting for %s%s...]" %ai-model .ai-send.req-note
  !force insert-file &cat %ai-base-url .ai-send.req-path
  !force unset-variable %http-post-file
  !if #l1
    set-variable %http-header #l2
  !else
    unset-variable %http-header
  !endif
  !iif #l3  set-variable %http-flags #l4
  ai-http-parse
  !if &not &or .ai-send.got .ai-send.tc-n
    ai-http-retryable
    !if &and $result &les .ai-send.attempt %ai-retries
      ai-retry-later "the server did not reply"
      find-buffer #l0
      !return
    !endif
    ai-reply-error "no reply from the server" 0
  !endif
  ai-finish
  find-buffer #l0
!emacro

; curl, the reply streams in as server-sent events through ai-stream-ipipe
0 define-macro ai-curl-run
  set-variable #l0 $buffer-bname
  set-variable .ai-send.hdr-file &cat $temp-name ".hdr"
  ai-temp-buffer "*ai-hdr*"
  insert-string "Content-Type: application/json\n"
  !iif &len .ai-send.req-key  insert-string &spr "Authorization: Bearer %s\n" .ai-send.req-key
  !iif &not &seq $platform "windows"  set-variable $buffer-fmod 384
  0 write-buffer .ai-send.hdr-file
  ; write-buffer renames the buffer after the file
  0 delete-buffer $buffer-bname
  ; the HTTP status is written after the reply so a busy server can be tried again
  set-variable #l1 &spr "%s -sS -N --connect-timeout 30 --speed-limit 1 --speed-time %d %s --write-out \"\\nai-http-status:%%{http_code}\\n\" -H \"@%s\" --data-binary \"@%s\" \"%s%s\" 2>&1" %ai-curl %ai-timeout %ai-curl-args .ai-send.hdr-file .ai-send.req-file %ai-base-url .ai-send.req-path
  set-variable .ai-send.sline 1
  !force 0 delete-buffer "*ai-stream*"
  !force 0x20c2 ipipe-shell-command #l1 "*ai-stream*" ai-stream-ipipe
  set-variable #l2 $status
  find-buffer #l0
  !if #l2
    ml-write &spr "[AI: asking %s%s... C-c C-k to cancel]" %ai-model .ai-send.req-note
  !else
    ai-target-insert &spr "[AI error: failed to run %s]" %ai-curl
    ai-finish
  !endif
!emacro

0 define-macro ai-stream-event
  set-variable #l0 &lef @wl 12
  !iif &not &seq &lef #l0 6 "data: "  !return
  !iif &seq #l0 "data: [DONE]"  !return
  !if .ai-send.req-resp
    ai-stream-event-r
    !return
  !endif
  ; the usage comes in an event of its own at the end, when asked for
  !force -1 search-buffer "me" "\"usage\"[ \t]*:[ \t]*{"
  !iif $status  ai-usage-parse -1
  beginning-of-line
  !force -1 search-buffer "me" "\"finish_reason\"[ \t]*:[ \t]*\"\\([a-z_]+\\)\""
  !iif $status  set-variable .ai-send.finish-reason @s1
  beginning-of-line
  !force -1 search-buffer "me" "\"delta\"[ \t]*:[ \t]*{"
  !iif &not $status  !return
  set-variable #l1 $window-col
  !force -1 search-buffer "me" "\"reasoning\\(_content\\)?\"[ \t]*:[ \t]*\""
  !iif $status  ai-reply-reasoning
  set-variable $window-col #l1
  !force -1 search-buffer "me" "\"content\"[ \t]*:[ \t]*\""
  !iif $status  ai-reply-text
  set-variable $window-col #l1
  !force -1 search-buffer "me" "\"tool_calls\"[ \t]*:[ \t]*\\["
  !iif $status  ai-stream-tool-calls
!emacro

; an event of the responses API
0 define-macro ai-stream-event-r
  !force -1 search-buffer "me" "\"type\"[ \t]*:[ \t]*\"\\([a-z_.]+\\)\""
  !iif &not $status  !return
  set-variable #l1 @s1
  !if &seq #l1 "response.output_text.delta"
    !force -1 search-buffer "me" "\"delta\"[ \t]*:[ \t]*\""
    !iif $status  ai-reply-text
  !elif &or &seq #l1 "response.reasoning_summary_text.delta" &seq #l1 "response.reasoning_text.delta"
    !force -1 search-buffer "me" "\"delta\"[ \t]*:[ \t]*\""
    !iif $status  ai-reply-reasoning
  !elif &seq #l1 "response.reasoning_summary_part.added"
    ; summary parts are paragraphs
    !iif &equ .ai-send.think 1  ai-target-insert "\n\n"
  !elif &seq #l1 "response.output_item.done"
    !force -1 search-buffer "me" "\"item\"[ \t]*:[ \t]*{"
    !iif &not $status  !return
    set-variable #l2 $window-col
    !force -1 search-buffer "me" "\"type\"[ \t]*:[ \t]*\"function_call\""
    !iif &not $status  !return
    set-variable $window-col #l2
    ai-resp-call -1
  !elif &lfind "|response.completed|response.incomplete|response.failed|" #l1
    set-variable #l2 $window-col
    !force -1 search-buffer "me" "\"usage\"[ \t]*:[ \t]*{"
    !iif $status  ai-usage-parse -1
    set-variable $window-col #l2
    !force -1 search-buffer "me" "\"incomplete_details\"[ \t]*:[ \t]*{[^}\n]*\"reason\"[ \t]*:[ \t]*\"\\([a-z_]+\\)\""
    !iif $status  set-variable .ai-send.finish-reason &con &seq @s1 "content_filter" "content_filter" "length"
    set-variable $window-col #l2
    !if &seq #l1 "response.failed"
      !force -1 search-buffer "me" "\"message\"[ \t]*:[ \t]*\""
      !if $status
        ai-target-insert "[AI error: "
        ai-json-string .ai-send.target
        ai-target-insert "]"
        set-variable .ai-send.failed 1
      !endif
    !endif
  !elif &seq #l1 "error"
    !force -1 search-buffer "me" "\"message\"[ \t]*:[ \t]*\""
    !if $status
      ai-target-insert "[AI error: "
      ai-json-string .ai-send.target
      ai-target-insert "]"
      set-variable .ai-send.failed 1
    !endif
  !endif
!emacro

; process each complete event, a blank line ends an event and lines over 2046
; characters arrive wrapped so are joined back first
0 define-macro ai-stream-parse
  set-variable $window-line .ai-send.sline
  !repeat
    !while &seq @wc "\n"
      forward-line
    !done
    !iif &seq @wc ""  !break
    set-variable #l1 $window-line
    !repeat
      forward-line
    !until &sin @wc "\n"
    !iif &and @1 &seq @wc ""  !break
    set-variable #l2 $window-line
    ; an event's name or a comment is a line of its own before its data
    set-variable $window-line #l1
    !while &and &les &add #l1 1 #l2 &or &seq &lef @wl 6 "event:" &seq @wc ":"
      set-mark
      forward-line
      -1 kill-region
      set-variable #l2 &sub #l2 1
    !done
    set-variable $window-line #l1
    !while &les &add #l1 1 #l2
      end-of-line
      forward-delete-char
      set-variable #l2 &sub #l2 1
    !done
    beginning-of-line
    ai-stream-event
    set-variable .ai-send.sline &add #l1 1
    set-variable $window-line .ai-send.sline
  !until &seq @wc ""
!emacro

0 define-macro ai-stream-ipipe
  set-variable #l9 $result
  set-variable #l8 @#
  ; any output means curl has read the key, the pipe is called before that too
  !if &and &len .ai-send.hdr-file &gre $window-eline 1
    !force 0x20 file-op .ai-send.hdr-file
    set-variable .ai-send.hdr-file ""
  !endif
  !if &not #l8
    ; the HTTP status curl writes at the end, which is not an event
    set-variable #l7 0
    end-of-buffer
    ; it may follow a reply with no newline at its end
    !force search-buffer "bme" "ai-http-status:\\([0-9]+\\)"
    !if $status
      set-variable #l7 @s1
      set-mark
      end-of-line
      -1 kill-region
    !endif
  !endif
  !force ai-stream-parse #l8
  !if &not #l8
    !if .ai-send.cancel
    !elif &or .ai-send.got .ai-send.tc-n
    !elif .ai-send.failed
    !elif &and &or &equ #l7 0 &or &equ #l7 429 &not &les #l7 500 &les .ai-send.attempt %ai-retries
      ; no connection, a rate limit or a server error may pass
      ai-retry-later &con #l7 &spr "HTTP %d" #l7 "no connection"
      !return
    !else
      ai-reply-error &spr "curl exit code %s" #l9 #l7
    !endif
    ai-finish
  !endif
!emacro

; send the chat in the current buffer, the last part of which is the question or tool results
0 define-macro ai-start
  !if &seq %ai-model ""
    ai-set-model
    !iif &seq %ai-model ""  !abort
  !endif
  ai-get-key
  set-variable #l1 #l9
  !if &and &seq #l1 "" &sin "api.openai.com" %ai-base-url
    ml-write "[AI Error: set %ai-api-key or the OPENAI_API_KEY environment variable]"
    !abort
  !endif
  set-variable #l2 %ai-transport
  !iif &seq #l2 ""  set-variable #l2 &con &seq &which %ai-curl "ERROR" "http" "curl"
  set-variable .ai-send.target $buffer-bname
  ai-build-request &seq #l2 "curl"
  set-variable .ai-send.req-note &con &len %ai-effort &spr ", %s effort" %ai-effort ""
  ; the size of a request with attachments, or a large one, is shown and a very large one asked about
  set-variable #l4 &stat "s" .ai-send.req-file
  set-variable #l5 &div #l4 4
  set-variable #l5 &con &les #l5 1000 #l5 &spr "%dK" &div &add #l5 500 1000
  !if .ai-send.req-atts
    set-variable .ai-send.req-note &spr "%s, %d attachment%s, about %s tokens" .ai-send.req-note .ai-send.req-atts &con &equ .ai-send.req-atts 1 "" "s" #l5
  !elif &gre #l4 20000
    set-variable .ai-send.req-note &spr "%s, about %s tokens" .ai-send.req-note #l5
  !endif
  !if &gre #l4 %ai-request-max
    !if &not &iseq @mc1 &spr "The request is about %s tokens, send it (y/n)? " #l5 "yYnN" "y"
      !force 0x20 file-op .ai-send.req-file
      set-variable .ai-send.req-file ""
      !abort
    !endif
  !endif
  !iif &len .ai-send.req-warn  set-variable .ai-send.req-note &spr "%s, %s" .ai-send.req-note .ai-send.req-warn
  ; a code block the question leaves open would hide the reply's role line, the request mapped it
  ai-chat-close-fence
  ai-chat-separate
  set-variable .ai-send.reply-info &cat %ai-model &con &len %ai-effort &spr ", %s effort" %ai-effort ""
  insert-string &spr "## AI <!-- %s -->\n\n" .ai-send.reply-info
  set-alpha-mark "\xa4"
  set-alpha-mark "\xa5"
  set-variable .ai-send.busy 1
  set-variable .ai-send.got 0
  set-variable .ai-send.cancel 0
  set-variable .ai-send.failed 0
  set-variable .ai-send.finish-reason ""
  set-variable .ai-send.usage-got 0
  set-variable .ai-send.usage-in 0
  set-variable .ai-send.usage-out 0
  set-variable .ai-send.usage-cached 0
  set-variable .ai-send.usage-reasoning 0
  set-variable .ai-send.think 0
  set-variable .ai-send.tc-n 0
  set-variable .ai-send.attempt 0
  set-variable .ai-send.retry-at 0
  set-variable .ai-send.req-key #l1
  set-variable .ai-send.req-how #l2
  set-variable .ai-send.req-path &con .ai-send.req-resp "/responses" "/chat/completions"
  !force 0 delete-buffer "*ai-tc*"
  ai-temp-buffer "*ai-tc*"
  find-buffer .ai-send.target
  !force ai-chat-save
  ; the mode line says how the request is going
  set-variable .ai-send.ml-saved $buffer-mode-line
  ai-now
  set-variable .ai-send.t0 #l9
  !iif &seq #l2 "curl"  1000 create-callback ai-tick
  !if &seq #l2 "curl"
    !force ai-curl-run
    set-variable #l3 $status
  !else
    !force ai-http-start
    set-variable #l3 $status
  !endif
  ; never leave a failed request busy with its files behind
  !if &and &not #l3 .ai-send.busy
    ai-target-insert "[AI error: the request macro failed]"
    ai-finish
  !endif
!emacro

define-macro ai-send
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  ai-chat-map
  set-variable #l1 .ai-chat.map-last
  !if #l1
    set-variable $window-line #l1
    set-variable #l1 &xse @wl .ai-chat.you-re
  !endif
  !if &and &not #l1 .ai-chat.map-open
    ; the role lines after a code block left open are its text
    ml-write &spr "[AI Error: the code block on line %d is not closed]" .ai-chat.map-open
    !abort
  !elif &not .ai-chat.map-last
    ml-write "[AI Error: no \"## You\" section to send]"
    !abort
  !elif &not #l1
    ml-write "[AI Error: the last section is not a \"## You\" question]"
    !abort
  !endif
  end-of-line
  !force search-buffer "me" "[^ \t\n]"
  !if &not $status
    ml-write "[AI Error: write a question under \"## You\" first]"
    !abort
  !endif
  set-variable .ai-send.tool-round 0
  !iif &exi :ai-chat  set-variable .ai-chat.current $buffer-bname
  ai-start
!emacro

define-macro ai-ask
  !force set-variable #l1 @1
  !iif &not $status  set-variable #l1 @ml00 "AI question"
  !iif &seq #l1 ""  !abort
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  0x01 set-position "\xa1"
  ai-chat
  ai-chat-question
  insert-string &cat #l1 "\n"
  !force ai-start
  0x01 goto-position "\xa1"
!emacro

; set #p1 & #p2 to the line & column of the start of the region the user selected and #p3 &
; #p4 to its end, #p9 is 0 when there is none. The point is not moved
0 define-macro ai-get-region
  set-variable #p9 0
  0 show-region
  set-variable #l5 $result
  !iif &equ &band #l5 7 5  3 show-region
  !iif &lfind "|yank|reyank|yank-rectangle|search-forward|search-backward|isearch-forward|isearch-backward|hunt-forward|hunt-backward|search-buffer|replace-string|query-replace-string|" @cl  set-variable #l5 0
  !iif &not &equ &band #l5 5 5  !return
  0xc0 set-position "\xa6"
  !force -2 show-region
  set-variable #l1 $window-line
  set-variable #l2 $window-col
  !force 2 show-region
  set-variable #l3 $window-line
  set-variable #l4 $window-col
  0xc0 goto-position "\xa6"
  !if &or &gre #l1 #l3 &and &equ #l1 #l3 &gre #l2 #l4
    set-variable #l5 #l1
    set-variable #l1 #l3
    set-variable #l3 #l5
    set-variable #l5 #l2
    set-variable #l2 #l4
    set-variable #l4 #l5
  !endif
  set-variable #p1 #l1
  set-variable #p2 #l2
  set-variable #p3 #l3
  set-variable #p4 #l4
  set-variable #p9 1
!emacro

; set #p1 & #p2 to the first & last line of the function around the point, found with the
; mode's collapse patterns and taking in the comment above it, #p9 is 0 when there is none
0 define-macro ai-function-lines
  set-variable #p9 0
  !iif &not &exi collapse-get-vars  !force execute-file "collapse"
  !force collapse-get-vars
  !iif &not $status  !return
  ; #l9 & #l8 are the open & close patterns, #l7 & #l6 the line offsets and #l4 the search mode
  set-variable #l1 $window-line
  set-variable #l2 $window-col
  #l7 backward-line
  end-of-line
  !force search-buffer &cat "b" #l4 #l9
  !if $status
    #l7 forward-line
    set-variable #l3 $window-line
    end-of-line
    !force search-buffer #l4 #l8
    !if &and $status &not &les $window-line #l1
      #l6 forward-line
      set-variable #l0 &sub $window-line 1
      !if &not &les #l0 #l3
        set-variable $window-line #l3
        set-variable #l5 0
        !while &and &gre $window-line 1 &les #l5 %ai-attach-lines
          backward-line
          !iif &xse @wl "[ \t]*"  !break
          set-variable #l3 $window-line
          set-variable #l5 &add #l5 1
        !done
        set-variable $window-line #l3
        set-variable #p1 $window-aline
        set-variable $window-line #l0
        set-variable #p2 $window-aline
        set-variable #p9 1
      !endif
    !endif
  !endif
  set-variable $window-line #l1
  set-variable $window-col #l2
!emacro

; set #p9 to the number of lines in file or buffer @1 @2, 0 when it cannot be read
0 define-macro ai-att-lines
  set-variable #l1 @1
  set-variable #l2 @2
  ai-att-read #l1 #l2 0 0
  !force 0 delete-buffer "*ai-att-text*"
  set-variable #p9 &con &len #l9 0 #l8
!emacro

; set #p7 to file or buffer and #p8 to the name the current buffer is attached by: its file,
; unless it has none or it names a directory, as the output of a command such as *svn-diff* or
; *grep* does
0 define-macro ai-buffer-source
  set-variable #l1 $buffer-fname
  set-variable #p7 "buffer"
  set-variable #p8 $buffer-bname
  !iif &not &len #l1  !return
  !iif &seq &rig #l1 &sub &len #l1 1 "/"  !return
  !iif &seq &stat "t" #l1 "D"  !return
  set-variable #p7 "file"
  set-variable #p8 #l1
!emacro

; set #p1 & #p2 to the first & last line of the changes to one file at the point of the diff in the
; current buffer, from its Index: or diff line, else its --- line, #p9 is 0 when there are none.
; The point is not moved
0 define-macro ai-diff-section
  set-variable #p9 0
  0xc0 set-position "\xa6"
  set-variable #l1 $window-line
  ; the line each file's changes start with
  beginning-of-buffer
  set-variable #l3 "^\\(Index: \\|diff \\)"
  !force search-buffer "me" #l3
  !iif &not $status  set-variable #l3 "^--- "
  set-variable $window-line #l1
  end-of-line
  !force search-buffer "bme" #l3
  !if &not $status
    0xc0 goto-position "\xa6"
    !return
  !endif
  set-variable #l4 $window-line
  set-variable #l5 $window-aline
  set-variable $window-line #l1
  end-of-line
  !force search-buffer "me" #l3
  !if $status
    backward-line
  !else
    end-of-buffer
    backward-line
  !endif
  ; without the blank lines and the note of how the command ended
  !while &and &gre $window-line #l4 &xse @wl "\\([ \t]*\\|\\[\\*\\*\\*\\*.*\\)"
    backward-line
  !done
  set-variable #p1 #l5
  set-variable #p2 $window-aline
  set-variable #p9 1
  0xc0 goto-position "\xa6"
!emacro

; attach file @1 to the question being written in the current chat
0 define-macro ai-attach-file
  set-variable #l1 &stat "a" @1
  set-variable #l2 &stat "t" #l1
  !if &not &seq #l2 "R"
    ml-write &spr "[AI: %s is %s]" #l1 &con &seq #l2 "D" "a directory" "not a file"
    !return
  !endif
  ai-chat-attach "file" #l1 0 0
  ml-write &con &len #l9 &spr "[AI: attached %s]" #l1 &spr "[AI: %s is already attached]" #l1
!emacro

; attach files, or lines of them, to the question being written in *ai-chat*. In the chat it
; prompts for files, elsewhere it takes the grep or compile hit on the line, the region, the
; function at the point or the whole file
define-macro ai-attach
  !if .ai-send.busy
    ml-write "[AI: busy, attach once the reply is in]"
    !abort
  !endif
  !if &exi :ai-chat
    set-alpha-mark "\xa7"
    !force set-variable #l1 @1
    !if $status
      ai-attach-file #l1
    !else
      ; the prompt starts with the directory, so RET on a directory ends it
      !repeat
        !force set-variable #l1 @ml01 "Attach file (RET to end)"
        !iif &not $status  !break
        !iif &or &seq #l1 "" &seq &stat "t" #l1 "D"  !break
        ai-attach-file #l1
      !done
    !endif
    goto-alpha-mark "\xa7"
    !return
  !endif
  ai-buffer-source
  set-variable #l5 #l7
  set-variable #l6 #l8
  set-variable #l7 0
  set-variable #l8 0
  set-variable #l0 ""
  set-variable #l1 $window-line
  set-variable #l2 $window-col
  ; get-next-line 6 parses the next hit in this buffer only and does not open its file
  !force backward-line
  !force 6 get-next-line
  !if &and $status &equ $window-line #l1
    set-variable #l3 :next-line
    set-variable #l6 :next-file
    set-variable #l5 "file"
    !if &and &seq &lef #l6 1 "*" &seq &rig #l6 &sub &len #l6 1 "*"
      set-variable #l5 "buffer"
      set-variable #l6 &mid #l6 1 &sub &len #l6 2
    !endif
    set-variable #l7 &sub #l3 %ai-attach-lines
    !iif &les #l7 1  set-variable #l7 1
    set-variable #l8 &add #l3 %ai-attach-lines
    ai-att-lines #l5 #l6
    !iif &and #l9 &gre #l8 #l9  set-variable #l8 #l9
  !endif
  set-variable $window-line #l1
  set-variable $window-col #l2
  !if &not #l7
    ai-get-region
    !if #l9
      0xc0 set-position "\xa6"
      set-variable $window-line #l1
      set-variable #l7 $window-aline
      set-variable $window-line &sub #l3 &not #l4
      set-variable #l8 $window-aline
      !iif &les #l8 #l7  set-variable #l8 #l7
      0xc0 goto-position "\xa6"
    !elif &seq $buffer-major-mode "diff"
      ; a diff, such as *svn-diff*, is attached by the changes to one of its files
      !if &iseq @mc1 "Attach the changes to the file at the point or the whole diff (f/w)? " "fFwW" "f"
        ai-diff-section
        !if #l9
          set-variable #l7 #l1
          set-variable #l8 #l2
        !else
          set-variable #l0 ", no file's changes found here"
        !endif
      !endif
    !elif &iseq @mc1 "Attach the function at the point or the whole file (f/w)? " "fFwW" "f"
      ai-function-lines
      !if #l9
        set-variable #l7 #l1
        set-variable #l8 #l2
      !else
        set-variable #l7 &sub $window-aline %ai-attach-lines
        !iif &les #l7 1  set-variable #l7 1
        set-variable #l8 &add $window-aline %ai-attach-lines
        ai-att-lines #l5 #l6
        !iif &and #l9 &gre #l8 #l9  set-variable #l8 #l9
        set-variable #l0 ", no function found here"
      !endif
    !endif
  !endif
  0x3f set-position "\xa1"
  ai-chat-buffer
  ai-chat-attach #l5 #l6 #l7 #l8
  set-variable #l1 #l9
  goto-position "\xa1"
  !if &len #l1
    ml-write &spr "[AI: %s attached%s]" &rig #l1 1 #l0
  !else
    ml-write "[AI: already attached]"
  !endif
!emacro

; show the file or buffer of the attachment line at the point with its lines selected
define-macro ai-show-attachment
  !if &not &xse @wl .ai-chat.att-line
    ml-write "[AI: not on an @file or @buffer line]"
    !abort
  !endif
  set-variable #l4 @s1
  set-variable #l5 @s2
  ai-att-parse #l4 #l5
  !if &lfind "|cmd|diff|tree|" #l4
    ; run it now, showing its output
    set-variable .ai-attach.chat $buffer-bname
    ai-att-read #l4 #l1 0 0
    !if &len #l9
      !force 0 delete-buffer "*ai-att-text*"
      ml-write &spr "[AI: %s]" #l9
      !abort
    !endif
    !force 0 delete-buffer "*ai-attachment*"
    find-buffer "*ai-attachment*"
    ai-edit-append "*ai-att-text*"
    !force 0 delete-buffer "*ai-att-text*"
    -1 buffer-mode "edit"
    beginning-of-buffer
    find-buffer .ai-attach.chat
    !force 0 popup-window "*ai-attachment*"
    !iif &not $status  1 popup-window "*ai-attachment*"
    ml-write &spr "[AI: %d lines%s]" #l8 &con .ai-attach.rc &spr ", exit code %d" .ai-attach.rc ""
    !return
  !elif &seq #l4 "buffer"
    !if &not &exi &spr ":%s:" #l1
      ml-write &spr "[AI: no buffer %s]" #l1
      !abort
    !endif
    set-variable #l9 #l1
  !elif &not &seq &stat "t" #l1 "R"
    ml-write &spr "[AI: no file %s]" #l1
    !abort
  !else
    ai-file-buffer #l1
    !if &seq #l9 ""
      set-variable #l0 $buffer-bname
      find-file #l1
      set-variable #l9 $buffer-bname
      find-buffer #l0
    !endif
  !endif
  !force 0 popup-window #l9
  !iif &not $status  1 popup-window #l9
  !if #l2
    !force #l2 goto-line
    set-mark
    -3 show-region
    !force #l3 goto-line
    end-of-line
    3 show-region
    1 show-region
    ml-write &spr "[AI: lines %d-%d of %s]" #l2 #l3 $buffer-bname
  !endif
!emacro

define-macro ai-code-action
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  ai-get-region
  0x53f set-position "\xa1"
  !if &not #l9
    set-variable #l1 1
    set-variable #l2 0
    end-of-buffer
    set-variable #l3 $window-line
    set-variable #l4 $window-col
  !endif
  !if &and &equ #l1 #l3 &equ #l2 #l4
    goto-position "\xa1"
    ml-write "[AI Error: no code to send]"
    !abort
  !endif
  !force set-variable #l6 @1
  ; the actions are the prompt's history, up and down, as completion would take a space typed
  !iif &not $status  set-variable #l6 @ml0b &con #l9 "AI question or action (up for actions) on the region" "AI question or action (up for actions) on the buffer" %ai-actions
  !if &seq #l6 ""
    goto-position "\xa1"
    !abort
  !endif
  !iif &lfind %ai-actions #l6  set-variable #l6 &ind &cat "%ai-action-" #l6
  ; the reply to an action asking for the complete code of a whole file is better as edits
  !iif &and &not #l9 &sin "complete" #l6  set-variable #l6 &cat #l6 " As the whole file is attached, reply with edit blocks for the changes instead of the complete code."
  set-variable .ai-insert-block.src $buffer-bname
  set-variable .ai-insert-block.src-region #l9
  ai-buffer-source
  ; the code is attached, not copied into the chat. A region goes as whole lines, so
  ; marks \xa2 & \xa3 that ai-insert-block replaces between are put on whole lines
  !if #l9
    !iif &not #l4  set-variable #l3 &sub #l3 1
    set-variable $window-line &add #l3 1
    set-alpha-mark "\xa3"
    set-variable $window-line #l3
    set-variable #l4 $window-aline
    set-variable $window-line #l1
    set-alpha-mark "\xa2"
    set-variable #l2 $window-aline
  !else
    set-alpha-mark "\xa3"
    beginning-of-buffer
    set-alpha-mark "\xa2"
    set-variable #l2 0
    set-variable #l4 0
  !endif
  goto-position "\xa1"
  0x01 set-position "\xa1"
  ai-chat
  ai-chat-question
  ai-chat-attach #l7 #l8 #l2 #l4
  ai-chat-text-point
  insert-string &cat #l6 "\n"
  !force ai-start
  0x01 goto-position "\xa1"
!emacro

; find the fenced code block at or before the point, sets #p1 & #p2 to its first & end lines
0 define-macro ai-find-block
  set-variable #l0 $window-line
  set-variable #l1 0
  set-variable #l2 ""
  set-variable #p1 0
  set-variable #p2 0
  beginning-of-buffer
  !repeat
    !force search-buffer "me" .ai-chat.fence-regex
    !iif &not $status  !break
    !iif &and &not &len #l2 &gre $window-line #l0  !break
    ai-fence-line @wl #l2
    !if &not &len #l2
      set-variable #l1 $window-line
    !elif &not &len .ai-chat.fence
      set-variable #p1 &add #l1 1
      set-variable #p2 $window-line
    !endif
    set-variable #l2 .ai-chat.fence
    end-of-line
  !done
  set-variable $window-line #l0
!emacro

; outside a chat the last code block of *ai-chat* is used
define-macro ai-insert-block
  0x11 set-position "\xa1"
  !if &not &exi :ai-chat
    !force 0 popup-window .ai-chat.current
    !iif &not $status  find-buffer .ai-chat.current
    end-of-buffer
  !endif
  ai-find-block
  !if &or &not #l1 &not &les #l1 #l2
    0x11 goto-position "\xa1"
    ml-write "[AI: no code block found]"
    !abort
  !endif
  ; an edit block is applied
  set-variable $window-line &sub #l1 1
  set-variable #l5 &xse @wl .ai-chat.edit-fence-x
  !if &not #l5
    ai-block-kind &sub #l1 1 #l2
    set-variable #l5 &len .ai-apply-edits.block-kind
  !endif
  set-variable $window-line &sub #l1 1
  !if #l5
    !if .ai-send.busy
      0x11 goto-position "\xa1"
      ml-write "[AI: busy, wait for the reply or use ai-cancel]"
      !abort
    !endif
    ; from the block's opening fence, a closing fence just above it would be taken as an opening
    set-variable #l3 &sub #l1 1
    set-variable #l4 &add #l2 1
    ai-edit-run #l3 #l4 0
    0x11 goto-position "\xa1"
    !return
  !endif
  set-variable #l3 &and &len .ai-insert-block.src &exi &spr ":%s:" .ai-insert-block.src
  !force set-variable #l4 @1
  !if &not $status
    !if &and #l3 .ai-insert-block.src-region
      set-variable #l4 @mc1 &spr "Replace the region in %s, insert at its point or copy (r/i/c)? " .ai-insert-block.src "rRiIcC"
    !elif #l3
      set-variable #l4 @mc1 &spr "Insert at the point in %s or copy (i/c)? " .ai-insert-block.src "iIcC"
    !endif
  !endif
  set-variable #l4 &slo #l4
  !iif &not #l3  set-variable #l4 "c"
  !iif &and &seq #l4 "r" &not .ai-insert-block.src-region  set-variable #l4 "i"
  set-variable $window-line #l1
  set-mark
  set-variable $window-line #l2
  set-variable #l5 $system
  !iif &not &seq #l4 "c"  set-variable $system &bor #l5 0x800000
  copy-region
  set-variable $system #l5
  0x11 goto-position "\xa1"
  !if &seq #l4 "c"
    ml-write "[AI: code block copied]"
    !return
  !endif
  !force 0 popup-window .ai-insert-block.src
  !iif &not $status  1 popup-window .ai-insert-block.src
  !if &seq #l4 "r"
    goto-alpha-mark "\xa2"
    set-mark
    goto-alpha-mark "\xa3"
    !force -1 kill-region
  !endif
  set-variable $system &bor #l5 0x800000
  yank
  ; the block was only copied to be put here
  -1 yank
  set-variable $system #l5
  !iif &seq #l4 "r"  set-alpha-mark "\xa3"
  ml-write &spr "[AI: code block %s]" &con &seq #l4 "r" "replaced the region" "inserted"
!emacro

; Edits: a reply changes attached files with edit blocks, each holding one or more SEARCH and
; REPLACE changes. The status of each change is written after its block, so a change with a
; status is not applied again and the model sees what happened to it

; set #p1 & #p2 to the "## AI" line and the end line (exclusive) of the reply at or before the
; point of the current chat, #p1 is 0 when there is none
0 define-macro ai-edit-reply
  set-variable #l0 $window-line
  set-variable #l1 0
  set-variable #l2 0
  ai-chat-map
  set-variable #l3 0
  !while &not &seq &set #l4 &lget .ai-chat.map-roles &inc #l3 1 ""
    set-variable $window-line #l4
    !if &and &not &gre #l4 #l0 &xse @wl .ai-chat.ai-re
      set-variable #l1 #l4
      set-variable #l2 0
    !elif &and #l1 &not #l2
      set-variable #l2 #l4
    !endif
  !done
  !if &and #l1 &not #l2
    end-of-buffer
    set-variable #l2 $window-line
  !endif
  set-variable #p1 #l1
  set-variable #p2 #l2
!emacro

; list the pending changes of the edit block for @1 from line @2 of the current chat to its
; closing fence on line @3, the changes in the | list @4 have a status, in *ai-edits* as a tab
; list of name, SEARCH first & end line, REPLACE first & end line (ends exclusive), closing
; fence line and number in the block, the SEARCH line is 0 when the change is incomplete. #p9
; is increased by the number listed
0 define-macro ai-edit-block
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 @4
  set-variable #l5 0
  set-variable #l6 0
  set-variable #l7 0
  set-variable $window-line &add #l2 1
  !while &les $window-line #l3
    set-variable #l8 ""
    !if &xse @wl "<<<<<<<+[ \t]*SEARCH[ \t]*"
      set-variable #l6 &add $window-line 1
      set-variable #l7 0
    !elif &and #l6 &and &not #l7 &xse @wl "=======+[ \t]*"
      set-variable #l7 $window-line
    !elif &and #l7 &xse @wl ">>>>>>>+[ \t]*REPLACE[ \t]*"
      set-variable #l5 &add #l5 1
      set-variable #l8 &spr "\t%s\t%d\t%d\t%d\t%d\t%d\t%d\t" #l1 #l6 #l7 &add #l7 1 $window-line #l3 #l5
      set-variable #l6 0
      set-variable #l7 0
    !endif
    !if &and &len #l8 &not &lfind #l4 #l5
      set-variable #l9 $window-line
      find-buffer "*ai-edits*"
      end-of-buffer
      insert-string &cat #l8 "\n"
      find-buffer #l0
      set-variable $window-line #l9
      set-variable #p9 &add #p9 1
    !endif
    forward-line
  !done
  ; a change left open, or a block without one, is listed to report it
  !if &or #l6 &not #l5
    set-variable #l5 &add #l5 1
    !if &not &lfind #l4 #l5
      find-buffer "*ai-edits*"
      end-of-buffer
      insert-string &spr "\t%s\t0\t0\t0\t0\t%d\t%d\t\n" #l1 #l3 #l5
      find-buffer #l0
      set-variable #p9 &add #p9 1
    !endif
  !endif
!emacro

; list the pending changes of the edit blocks between lines @1 and @2 of the current chat in
; *ai-edits*, #p9 is the number of them and #p8 the number of blocks. A block the model left
; open is closed before the next block or the end of the reply
0 define-macro ai-edit-list
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  ai-temp-buffer "*ai-edits*"
  find-buffer #l0
  set-variable #l9 0
  set-variable #p8 0
  set-variable $window-line #l1
  !repeat
    !force search-buffer "me" .ai-chat.fence-regex
    !iif &or &not $status &not &les $window-line #l2  !break
    !if &not &xse @wl .ai-chat.edit-fence-x
      ; another code block is passed over, an edit block in it is only shown. With
      ; %ai-edit-lenient a diff, or SEARCH and REPLACE changes under a line naming the file, is
      ; taken as changes
      set-variable #l5 $window-line
      ai-fence-line @wl ""
      set-variable #l3 .ai-chat.fence
      !while &len #l3
        end-of-line
        !force search-buffer "me" .ai-chat.fence-regex
        !if &or &not $status &not &les $window-line #l2
          set-variable $window-line #l2
          set-variable #l3 ""
          set-variable #l5 0
        !else
          ai-fence-line @wl #l3
          set-variable #l3 .ai-chat.fence
        !endif
      !done
      !if #l5
        set-variable #l6 $window-line
        ai-block-kind #l5 #l6
        !if &len .ai-apply-edits.block-kind
          set-variable #p8 &add #p8 1
          set-variable #l7 "|"
          !repeat
            forward-line
            !iif &not &xse @wl "(edit \\([0-9]+\\) [a-z]+.*"  !break
            set-variable #l7 &cat #l7 &cat @s1 "|"
          !done
          !if &seq .ai-apply-edits.block-kind "\x01diff"
            ai-edit-diff #l5 #l6 #l7
          !else
            ai-edit-block .ai-apply-edits.block-kind #l5 #l6 #l7
          !endif
          set-variable $window-line #l6
        !endif
      !endif
      end-of-line
      !continue
    !endif
    set-variable #l3 @s1
    set-variable #l4 @s3
    !iif &xse #l4 "\\(path\\|file\\)[ \t]*=[ \t]*\\(.*\\)"  set-variable #l4 @s2
    set-variable #l5 $window-line
    set-variable #p8 &add #p8 1
    set-variable #l6 #l2
    set-variable #l8 1
    !force search-buffer "me" &spr "^[ \t]*%s%s*[ \t]*$" #l3 &lef #l3 1
    !if &and $status &les $window-line #l2
      set-variable #l6 $window-line
      set-variable #l8 0
    !endif
    set-variable $window-line #l5
    end-of-line
    !force search-buffer "me" .ai-chat.edit-fence
    !if &and $status &les $window-line #l6
      set-variable #l6 $window-line
      set-variable #l8 1
    !endif
    !if #l8
      ; close it after its last change, or its last text when that is a change cut short
      set-variable $window-line &sub #l6 1
      !while &and &gre $window-line #l5 &not &xse @wl "\\(>>>>>>>+[ \t]*REPLACE\\|<<<<<<<+[ \t]*SEARCH\\)[ \t]*"
        backward-line
      !done
      !if &or &equ $window-line #l5 &xse @wl "<<<<<<<+[ \t]*SEARCH[ \t]*"
        set-variable $window-line &sub #l6 1
        !while &and &gre $window-line #l5 &xse @wl "[ \t]*"
          backward-line
        !done
      !endif
      forward-line
      beginning-of-line
      insert-string &cat #l3 "\n"
      set-variable #l6 &sub $window-line 1
      set-variable #l2 &add #l2 1
    !endif
    ; the changes with a status line after the block
    set-variable $window-line #l6
    set-variable #l7 "|"
    !repeat
      forward-line
      !iif &not &xse @wl "(edit \\([0-9]+\\) [a-z]+.*"  !break
      set-variable #l7 &cat #l7 &cat @s1 "|"
    !done
    ai-edit-block #l4 #l5 #l6 #l7
    set-variable $window-line #l6
    end-of-line
  !done
  set-variable #p9 #l9
!emacro

; set .ai-apply-edits.block-kind to how the code block from line @1 of the current chat to its closing fence
; on line @2 changes files when it is not an edit block: "\x01diff" for a diff, with
; .ai-apply-edits.block-name the file named above it, or the name of the file written above a block of SEARCH
; and REPLACE changes, else "". Only with %ai-edit-lenient
0 define-macro ai-block-kind
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable .ai-apply-edits.block-kind ""
  set-variable .ai-apply-edits.block-name ""
  !iif &not %ai-edit-lenient  !return
  0xc0 set-position "\xaa"
  set-variable #l3 ""
  !if &gre #l1 1
    set-variable $window-line &sub #l1 1
    ai-name-above @wl
    set-variable #l3 #l9
  !endif
  set-variable $window-line #l1
  !force search-buffer "me" "^@@ -[0-9]"
  !if &and $status &les $window-line #l2
    set-variable $window-line #l1
    !force search-buffer "me" "^\\+\\+\\+ [^ \t\n]"
    !if &or &len #l3 &and $status &les $window-line #l2
      set-variable .ai-apply-edits.block-kind "\x01diff"
      set-variable .ai-apply-edits.block-name #l3
    !endif
  !elif &len #l3
    set-variable $window-line #l1
    !force search-buffer "me" "^<<<<<<<+[ \t]*SEARCH[ \t]*$"
    !iif &and $status &les $window-line #l2  set-variable .ai-apply-edits.block-kind #l3
  !endif
  0xc0 goto-position "\xaa"
!emacro

; set #p9 to the file name of the ---/+++ line of text @1, without its a/ or b/ and any date
0 define-macro ai-diff-name
  set-variable #l1 &rig @1 4
  !iif &sin "\t" #l1  set-variable #l1 &lef #l1 &sub &sin "\t" #l1 1
  set-variable #l1 &trb #l1
  !iif &xse #l1 "[ab]/.*"  set-variable #l1 &rig #l1 2
  set-variable #p9 #l1
!emacro

; list the changes of the diff in the block from line @1 of the current chat to its closing fence
; on line @2 in *ai-edits*, a hunk each, as ai-edit-block does for an edit block. The changes in
; the | list @3 have a status
0 define-macro ai-edit-diff
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  ; #l4 the file, #l5 the change's number, #l6 the first line of a hunk's text, #l7 d, or dn for
  ; a new file and dx for a file removed
  set-variable #l4 .ai-apply-edits.block-name
  set-variable #l5 0
  set-variable #l6 0
  set-variable #l7 "d"
  set-variable $window-line &add #l1 1
  !repeat
    ; a hunk ends at the next hunk or file, at the end of the block or at a line that is not one of
    ; its lines
    set-variable #l8 &equ $window-line #l2
    !if &not #l8
      set-variable #l9 @wc
      !if &xse @wl "\\(@@ \\|diff \\|index \\).*"
        set-variable #l8 2
      !elif &and &seq #l9 "-" &xse @wl "--- .*"
        forward-line
        set-variable #l8 &xse @wl "\\+\\+\\+ .*"
        backward-line
        !iif #l8  set-variable #l8 3
      !elif &not &sin #l9 " -+\\\n"
        set-variable #l8 1
      !endif
    !endif
    !if &and #l8 #l6
      set-variable #l5 &add #l5 1
      !if &not &lfind #l3 #l5
        set-variable #l9 &spr "\t%s\t%d\t%d\t%d\t%d\t%d\t%d\t%s\t\n" #l4 #l6 $window-line #l6 $window-line #l2 #l5 #l7
        find-buffer "*ai-edits*"
        end-of-buffer
        insert-string #l9
        find-buffer #l0
        set-variable #p9 &add #p9 1
      !endif
      set-variable #l6 0
    !endif
    !iif &equ $window-line #l2  !break
    !if &equ #l8 3
      ; a file's ---/+++ lines
      set-variable #l7 &con &xse @wl "--- /dev/null[ \t]*.*" "dn" "d"
      ai-diff-name @wl
      set-variable #l4 #l9
      forward-line
      !if &xse @wl "\\+\\+\\+ /dev/null[ \t]*.*"
        set-variable #l7 "dx"
      !else
        ai-diff-name @wl
        set-variable #l4 #l9
      !endif
    !elif &xse @wl "@@ .*"
      set-variable #l6 &add $window-line 1
    !endif
    forward-line
  !done
!emacro

; keep the lines of the diff hunk in the current buffer that are context or start with @1, without
; that first character
0 define-macro ai-edit-hunk-side
  set-variable #l1 @1
  beginning-of-buffer
  !while &not &seq @wc ""
    set-variable #l2 @wc
    !if &or &seq #l2 " " &seq #l2 #l1
      forward-delete-char
      forward-line
    !elif &seq #l2 "\n"
      ; a blank line of context that lost its space
      forward-line
    !else
      set-mark
      forward-line
      -1 kill-region
    !endif
  !done
!emacro

; fill *ai-edit-s* & *ai-edit-r* with the SEARCH & REPLACE text of change @1, an *ai-edits* record
; whose chat lines are now @2 lines further on. Sets #p8 to why it cannot be applied, else ""
0 define-macro ai-edit-fetch
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #p8 ""
  set-variable #l3 &lget #l1 8
  !if &not &lget #l1 2
    set-variable #p8 "failed, it is not a complete SEARCH and REPLACE"
  !elif &seq #l3 "dx"
    set-variable #p8 "failed, removing a file is not supported"
  !elif &seq &lef #l3 1 "d"
    set-variable #l4 &add &lget #l1 2 #l2
    set-variable #l5 &add &lget #l1 3 #l2
    ai-edit-copy #l4 #l5 "*ai-edit-s*"
    ai-edit-copy #l4 #l5 "*ai-edit-r*"
    set-variable #l0 $buffer-bname
    find-buffer "*ai-edit-r*"
    ai-edit-hunk-side "+"
    find-buffer "*ai-edit-s*"
    ai-edit-hunk-side "-"
    end-of-buffer
    set-variable #l6 &gre $window-line 1
    find-buffer #l0
    !iif &and &seq #l3 "d" &not #l6  set-variable #p8 "failed, the hunk has no lines to find in the file"
  !else
    ai-edit-copy &add &lget #l1 2 #l2 &add &lget #l1 3 #l2 "*ai-edit-s*"
    ai-edit-copy &add &lget #l1 4 #l2 &add &lget #l1 5 #l2 "*ai-edit-r*"
  !endif
!emacro

; Review all the changes of a reply as one diff in *ai-diff*, where each is kept or rejected
; before any is applied

; add lines of buffer @1 to the end of *ai-diff*, from line @2 for @3 lines (-1 for the rest),
; each after text @4
0 define-macro ai-diff-add
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 @4
  set-variable #l0 $buffer-bname
  find-buffer #l1
  !if &les #l3 0
    end-of-buffer
    set-variable #l3 &sub $window-line #l2
  !endif
  !if &gre #l3 0
    set-variable $window-line #l2
    set-mark
    set-variable $window-line &add #l2 #l3
    set-variable #l5 $system
    set-variable $system &bor #l5 0x800000
    copy-region
    find-buffer "*ai-diff*"
    end-of-buffer
    set-variable #l6 $window-line
    !force yank
    -1 yank
    set-variable $system #l5
    set-variable $window-line #l6
    !while &not &seq @wc ""
      insert-string #l4
      forward-line
      beginning-of-line
    !done
  !endif
  find-buffer #l0
!emacro

; add line of text @1 to *ai-diff*
0 define-macro ai-diff-line
  set-variable #l1 @1
  set-variable #l0 $buffer-bname
  find-buffer "*ai-diff*"
  end-of-buffer
  insert-string &cat #l1 "\n"
  find-buffer #l0
!emacro

; add to *ai-diff* how change .ai-review-edits.rec, an *ai-edits* record, the .ai-review-edits.i of .ai-review-edits.n, would
; change its file. The current buffer is the chat
0 define-macro ai-diff-change
  set-variable #l0 $buffer-bname
  set-variable .ai-review-edits.name &lget .ai-review-edits.rec 1
  set-variable .ai-review-edits.head &spr "[ ] edit %d of %d, %s" .ai-review-edits.i .ai-review-edits.n .ai-review-edits.name
  ai-edit-fetch .ai-review-edits.rec 0
  !if &len #l8
    ai-diff-line &spr "%s: %s\n" .ai-review-edits.head &rep #l8 "failed, " "it fails, "
    !return
  !endif
  ; sets #l1 to file or buffer, #l2 its name, #l3 its ranges, #l4 whether attached
  ai-edit-target .ai-review-edits.name
  !if &len #l8
    ai-diff-line &spr "%s: it fails, %s could be %s\n" .ai-review-edits.head .ai-review-edits.name #l8
    !return
  !endif
  set-variable .ai-review-edits.note &con #l4 "" ", not attached so you are asked first"
  find-buffer "*ai-edit-s*"
  end-of-buffer
  set-variable #l5 &sub $window-line 1
  find-buffer "*ai-edit-r*"
  end-of-buffer
  set-variable #l7 &sub $window-line 1
  find-buffer #l0
  ai-edit-buffer #l1 #l2
  set-variable #l6 #l9
  !if &not #l5
    ; an empty SEARCH creates the file, or fills an empty one
    !if &len #l6
      find-buffer #l6
      end-of-buffer
      set-variable #l8 &or &gre $window-line 1 $window-col
      find-buffer #l0
      !if #l8
        ai-diff-line &spr "%s: it fails, the SEARCH text is empty but %s is not\n" .ai-review-edits.head .ai-review-edits.name
        !return
      !endif
    !elif &seq #l1 "buffer"
      ai-diff-line &spr "%s: it fails, there is no %s\n" .ai-review-edits.head .ai-review-edits.name
      !return
    !elif &not &seq &stat "t" #l2 "X"
      ai-diff-line &spr "%s: it fails, %s is not a file\n" .ai-review-edits.head .ai-review-edits.name
      !return
    !endif
    ai-diff-line &spr "%s, %s it%s" .ai-review-edits.head &con &len #l6 "fills" "creates" .ai-review-edits.note
    ai-diff-line &spr "--- /dev/null\n+++ %s\n@@ -0,0 +1,%d @@" .ai-review-edits.name #l7
    ai-diff-add "*ai-edit-r*" 1 -1 "+"
    ai-diff-line ""
    !return
  !endif
  !if &not &len #l6
    ai-diff-line &spr "%s: it fails, there is no %s\n" .ai-review-edits.head .ai-review-edits.name
    !return
  !endif
  ; sets #l1 to the line it matched, #l2 the number of places and #l3 the comparison
  ai-edit-match #l6 #l3 #l5
  !if &not #l1
    find-buffer #l6
    set-variable #l8 &bmo "narrow"
    find-buffer #l0
    !if #l2
      ai-diff-line &spr "%s: it fails, the SEARCH text matches %d places\n" .ai-review-edits.head #l2
    !elif #l8
      ai-diff-line &spr "%s: it fails, the SEARCH text is not in the lines shown, it has collapsed parts\n" .ai-review-edits.head
    !else
      ai-diff-line &spr "%s: it fails, the SEARCH text is not in it\n" .ai-review-edits.head
    !endif
    !return
  !endif
  !iif &equ #l3 3  ai-edit-indent #l6 #l1 #l5
  find-buffer #l6
  ai-edit-copy #l1 &add #l1 #l5 "*ai-edit-o*"
  set-variable $window-line #l1
  set-variable #l4 $window-aline
  end-of-buffer
  set-variable #l8 $window-line
  find-buffer #l0
  ai-edit-formats "*ai-edit-o*"
  set-variable #l2 #l9
  ai-edit-formats "*ai-edit-r*"
  !iif &and &len #l2 &not &seq #l2 #l9  set-variable .ai-review-edits.note &cat .ai-review-edits.note ", its % formats look changed"
  ai-diff-line &spr "%s line %d%s" .ai-review-edits.head #l4 .ai-review-edits.note
  ai-diff-line &spr "--- %s\n+++ %s\n@@ -%d,%d +%d,%d @@" .ai-review-edits.name .ai-review-edits.name #l4 #l5 #l4 #l7
  ; with two lines either side
  set-variable #l2 &sub #l1 2
  !iif &les #l2 1  set-variable #l2 1
  ai-diff-add #l6 #l2 &sub #l1 #l2 " "
  ai-diff-add "*ai-edit-o*" 1 -1 "-"
  ai-diff-add "*ai-edit-r*" 1 -1 "+"
  set-variable #l2 &add #l1 #l5
  set-variable #l3 &sub #l8 #l2
  !iif &gre #l3 2  set-variable #l3 2
  ai-diff-add #l6 #l2 #l3 " "
  ai-diff-line ""
!emacro

; show the pending changes of the reply at or before the point in the chat, or of the last reply
; from any other buffer, as one diff in which each is kept (y) or rejected (n) before C-c C-c
; applies those decided. The keys are letters as a key's case is not told apart
define-macro ai-review-edits
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  !if &not &exi :ai-chat
    !force 0 popup-window .ai-chat.current
    !if &not $status
      ml-write "[AI: there is no chat]"
      !abort
    !endif
    end-of-buffer
  !endif
  set-alpha-mark "\xa8"
  ai-edit-reply
  goto-alpha-mark "\xa8"
  !if &not #l1
    ml-write "[AI: no reply to review]"
    !abort
  !endif
  set-variable .ai-apply-edits.chat $buffer-bname
  set-variable .ai-review-edits.line #l1
  ai-att-scan
  ai-edit-list #l1 #l2
  !if &not #l9
    !force 0 delete-buffer "*ai-edits*"
    !force 0 delete-buffer "*ai-att*"
    goto-alpha-mark "\xa8"
    ml-write &con #l8 "[AI: each change has a status line, delete one to apply its change again]" "[AI: no edits to review]"
    !abort
  !endif
  set-variable .ai-review-edits.n #l9
  !force 0 delete-buffer "*ai-diff*"
  find-buffer "*ai-diff*"
  insert-string "AI edits: y keeps a change, n rejects it and u undecides it, a keeps the rest and r rejects\nthe rest, tab moves on, C-c C-c applies those decided and q quits. Lines are as they are now.\n\n"
  find-buffer .ai-apply-edits.chat
  set-variable .ai-review-edits.i 0
  !while &les .ai-review-edits.i .ai-review-edits.n
    set-variable .ai-review-edits.i &add .ai-review-edits.i 1
    find-buffer "*ai-edits*"
    set-variable $window-line .ai-review-edits.i
    set-variable .ai-review-edits.rec @wl
    find-buffer .ai-apply-edits.chat
    ai-diff-change
  !done
  ; the changes as they were, to check on applying them
  find-buffer "*ai-edits*"
  end-of-buffer
  set-variable #l3 $window-line
  ai-edit-copy 1 #l3 "*ai-diff-edits*"
  !force 0 delete-buffer "*ai-edits*"
  !force 0 delete-buffer "*ai-edit-s*"
  !force 0 delete-buffer "*ai-edit-r*"
  !force 0 delete-buffer "*ai-edit-o*"
  !force 0 delete-buffer "*ai-att*"
  find-buffer .ai-apply-edits.chat
  goto-alpha-mark "\xa8"
  set-variable #l0 .ai-apply-edits.chat
  find-buffer "*ai-diff*"
  !force major-mode "diff"
  set-variable :ai-diff-chat #l0
  set-variable :ai-diff-line .ai-review-edits.line
  buffer-bind-key ai-diff-keep "y"
  buffer-bind-key ai-diff-reject "n"
  buffer-bind-key ai-diff-undecide "u"
  buffer-bind-key ai-diff-keep-rest "a"
  buffer-bind-key ai-diff-reject-rest "r"
  buffer-bind-key ai-diff-next "tab"
  buffer-bind-key ai-diff-prev "S-tab"
  buffer-bind-key ai-diff-apply "C-c C-c"
  buffer-bind-key ai-diff-quit "q"
  -1 buffer-mode "edit"
  find-buffer #l0
  !force 0 popup-window "*ai-diff*"
  !iif &not $status  1 popup-window "*ai-diff*"
  beginning-of-buffer
  ai-diff-next
  ml-write &spr "[AI: %d edit%s to review, y keeps, n rejects, C-c C-c applies]" .ai-review-edits.n &con &equ .ai-review-edits.n 1 "" "s"
!emacro

; move to the next change in *ai-diff*
0 define-macro ai-diff-next
  end-of-line
  !force search-buffer "me" "^\\[.\\] edit [0-9]+ of"
  !if $status
    beginning-of-line
  !else
    ml-write "[AI: no more changes]"
  !endif
!emacro

; move to the previous change in *ai-diff*
0 define-macro ai-diff-prev
  beginning-of-line
  !force search-buffer "bme" "^\\[.\\] edit [0-9]+ of"
  !iif &not $status  ml-write "[AI: no change before]"
!emacro

; mark the change at the point with @1, and go to the next
0 define-macro ai-diff-mark
  set-variable #l1 @1
  end-of-line
  !force search-buffer "bme" "^\\[.\\] edit [0-9]+ of"
  !if &not $status
    !force search-buffer "me" "^\\[.\\] edit [0-9]+ of"
    !iif &not $status  !return
  !endif
  beginning-of-line
  forward-char
  forward-delete-char
  insert-string #l1
  -1 buffer-mode "edit"
  ai-diff-next
!emacro

0 define-macro ai-diff-keep
  ai-diff-mark "y"
!emacro

0 define-macro ai-diff-reject
  ai-diff-mark "n"
!emacro

0 define-macro ai-diff-undecide
  ai-diff-mark " "
!emacro

; mark the changes not yet decided with @1
0 define-macro ai-diff-rest
  set-variable #l1 @1
  beginning-of-buffer
  !repeat
    !force search-buffer "me" "^\\[ \\] edit [0-9]+ of"
    !iif &not $status  !break
    beginning-of-line
    forward-char
    forward-delete-char
    insert-string #l1
  !done
  -1 buffer-mode "edit"
!emacro

0 define-macro ai-diff-keep-rest
  ai-diff-rest "y"
!emacro

0 define-macro ai-diff-reject-rest
  ai-diff-rest "n"
!emacro

0 define-macro ai-diff-quit
  set-variable #l0 :ai-diff-chat
  !force 0 delete-buffer "*ai-diff-edits*"
  0 delete-buffer "*ai-diff*"
  !force find-buffer #l0
!emacro

; apply the changes kept in *ai-diff* and mark those rejected, leaving those not decided
0 define-macro ai-diff-apply
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  set-variable #l0 :ai-diff-chat
  set-variable #l1 :ai-diff-line
  set-variable .ai-review-edits.decide "|"
  set-variable #l3 0
  beginning-of-buffer
  !repeat
    !force search-buffer "me" "^\\[\\(.\\)\\] edit [0-9]+ of"
    !iif &not $status  !break
    set-variable .ai-review-edits.decide &spr "%s%s|" .ai-review-edits.decide &slo @s1
    !iif &not &seq @s1 " "  set-variable #l3 1
  !done
  !if &not #l3
    ml-write "[AI: no change is decided, y keeps one and n rejects it]"
    !abort
  !endif
  !if &not &exi &spr ":%s:" #l0
    ml-write "[AI: the chat has gone]"
    !abort
  !endif
  ; the changes must be those reviewed
  find-buffer #l0
  set-variable $window-line #l1
  ai-edit-reply
  set-variable #l4 #l1
  set-variable #l5 #l2
  !if #l4
    set-variable .ai-apply-edits.chat #l0
    ai-att-scan
    ai-edit-list #l4 #l5
    set-variable #l6 &equ #l9 .ai-review-edits.n
    !force 0 delete-buffer "*ai-att*"
    !if #l6
      set-variable #l7 0
      !while &and #l6 &les #l7 .ai-review-edits.n
        set-variable #l7 &add #l7 1
        find-buffer "*ai-edits*"
        set-variable $window-line #l7
        set-variable #l8 @wl
        find-buffer "*ai-diff-edits*"
        set-variable $window-line #l7
        set-variable #l6 &seq @wl #l8
      !done
    !endif
    !force 0 delete-buffer "*ai-edits*"
  !else
    set-variable #l6 0
  !endif
  find-buffer "*ai-diff*"
  !if &not #l6
    ml-write "[AI: the reply has changed since, review it again]"
    !abort
  !endif
  find-buffer #l0
  set-variable $window-line #l4
  set-variable .ai-apply-edits.decide .ai-review-edits.decide
  !force ai-edit-run #l4 #l5 2
  set-variable .ai-apply-edits.decide ""
  !force 0 delete-buffer "*ai-diff-edits*"
  !force 0 delete-buffer "*ai-diff*"
  find-buffer #l0
  !force 0 popup-window #l0
  ml-write .ai-apply-edits.msg
!emacro

; copy lines @1 to @2 (exclusive) of the current buffer into temporary buffer @3
0 define-macro ai-edit-copy
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  ai-temp-buffer #l3
  !if &les #l1 #l2
    find-buffer #l0
    set-variable $window-line #l1
    set-mark
    set-variable $window-line #l2
    set-variable #l4 $system
    set-variable $system &bor #l4 0x800000
    copy-region
    find-buffer #l3
    !force yank
    -1 yank
    set-variable $system #l4
  !endif
  find-buffer #l0
!emacro

; append the text of buffer @1 to the end of the current buffer
0 define-macro ai-edit-append
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  find-buffer #l1
  end-of-buffer
  !if &gre $window-line 1
    set-mark
    beginning-of-buffer
    set-variable #l2 $system
    set-variable $system &bor #l2 0x800000
    copy-region
    find-buffer #l0
    end-of-buffer
    !force yank
    -1 yank
    set-variable $system #l2
  !endif
  find-buffer #l0
!emacro

; find the file named @1 in an edit block among the chat's attachments in *ai-att*, first by
; its label then by the end of its name. Sets #p1 to file or buffer, #p2 to its name, #p3 to its
; attached ranges as a | list, with none when the whole file is attached, and #p4 to 0 when it
; is not attached, #p2 is then a guess relative to where the attachments' labels start. #p8 is
; the labels of the files the end of the name fits when there is more than one, else ""
0 define-macro ai-edit-target
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  ; a model may quote the name, start it with ./ or add the lines
  !while &and &len #l1 &sin &lef #l1 1 "`\"'"
    set-variable #l1 &rig #l1 1
  !done
  !while &and &len #l1 &sin &rig #l1 &sub &len #l1 1 "`\"':"
    set-variable #l1 &lef #l1 &sub &len #l1 1
  !done
  !iif &xse #l1 "\\(.*[^ \t:]\\)[ \t]*:[0-9]+\\(-[0-9]+\\)?"  set-variable #l1 @s1
  !while &seq &lef #l1 2 "./"
    set-variable #l1 &rig #l1 2
  !done
  set-variable #l2 ""
  set-variable #l5 0
  set-variable #l9 ""
  find-buffer "*ai-att*"
  set-variable #l6 1
  !while &and &seq #l2 "" &les #l6 3
    beginning-of-buffer
    !while &not &seq @wc ""
      set-variable #l7 @wl
      !if &not &lfind "|file|buffer|" &lget #l7 1
        set-variable #l8 0
      !elif &equ #l6 1
        set-variable #l8 &seq &lget #l7 6 #l1
      !else
        set-variable #l8 &cat "/" &lget #l7 2
        set-variable #l8 &and &seq &lget #l7 1 "file" &and &gre &len #l8 &len #l1 &seq &rig #l8 &sub &len #l8 &add &len #l1 1 &cat "/" #l1
      !endif
      !if &and #l8 &seq #l2 ""
        set-variable #l2 &lget #l7 1
        set-variable #l3 &lget #l7 2
        set-variable #l4 "|"
        !iif &equ #l6 2  set-variable #l9 &lget #l7 6
      !elif &and #l8 &not &seq &lget #l7 2 #l3
        ; another file ends with the name
        !iif &not &sin &cat " or " &lget #l7 6 #l9  set-variable #l9 &spr "%s or %s" #l9 &lget #l7 6
      !endif
      !if &and &not &seq #l2 "" &seq &lget #l7 2 #l3
        !if &lget #l7 3
          set-variable #l4 &spr "%s%s-%s|" #l4 &lget #l7 3 &lget #l7 4
        !else
          set-variable #l5 1
        !endif
      !endif
      forward-line
    !done
    set-variable #l6 &add #l6 1
  !done
  set-variable #p8 &con &sin " or " #l9 #l9 ""
  set-variable #l9 &not &seq #l2 ""
  !if &not #l9
    set-variable #l2 "file"
    set-variable #l3 ""
    !if &not &sin &lef #l1 1 "/~"
      ; relative to the directory of an attached tree, else to where the attachments' labels start
      beginning-of-buffer
      !while &not &seq @wc ""
        !iif &and &seq #l3 "" &seq &lget @wl 1 "tree"  set-variable #l3 &cat &lget @wl 2 "/"
        forward-line
      !done
      beginning-of-buffer
      !while &not &seq @wc ""
        !if &and &seq #l3 "" &seq &lget @wl 1 "file"
          set-variable #l7 &lget @wl 2
          set-variable #l3 &lef #l7 &sub &len #l7 &len &lget @wl 6
        !endif
        forward-line
      !done
    !endif
    set-variable #l3 &stat "a" &cat #l3 #l1
    set-variable #l4 "|"
    ; it may be an attached file named another way, such as with ..
    beginning-of-buffer
    !while &not &seq @wc ""
      set-variable #l7 @wl
      !if &and &seq &lget #l7 1 "file" &seq &lget #l7 2 #l3
        set-variable #l9 1
        !if &lget #l7 3
          set-variable #l4 &spr "%s%s-%s|" #l4 &lget #l7 3 &lget #l7 4
        !else
          set-variable #l5 1
        !endif
      !endif
      forward-line
    !done
  !endif
  !iif #l5  set-variable #l4 "|"
  find-buffer #l0
  set-variable #p1 #l2
  set-variable #p2 #l3
  set-variable #p3 #l4
  set-variable #p4 #l9
!emacro

; set #p9 to the buffer of file or buffer @1 @2, loading the file when it is not, "" when there
; is no such file or buffer
0 define-macro ai-edit-buffer
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  !if &seq #l1 "buffer"
    set-variable #p9 &con &exi &spr ":%s:" #l2 #l2 ""
    !return
  !endif
  ai-file-buffer #l2
  !if &and &seq #l9 "" &seq &stat "t" #l2 "R"
    find-file #l2
    set-variable #l9 $buffer-bname
    find-buffer #l0
  !endif
  set-variable #p9 #l9
!emacro

; $result is 1 when lines 1 to @1 of the current buffer match the @1 lines after them, compared
; by @2: 1 exactly, 2 without trailing white space, 3 without indentation either
0 define-macro ai-edit-same
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 1
  !while &not &gre #l3 #l1
    set-variable $window-line &add #l3 #l1
    set-variable #l4 @wl
    set-variable $window-line #l3
    !if &equ #l2 1
      set-variable #l5 &seq @wl #l4
    !elif &equ #l2 2
      set-variable #l5 &seq &trr @wl &trr #l4
    !else
      set-variable #l5 &seq &trb @wl &trb #l4
    !endif
    !if &not #l5
      set-variable $result 0
      !return
    !endif
    set-variable #l3 &add #l3 1
  !done
  set-variable $result 1
!emacro

; set #p9 to a | list of the first lines of the places in buffer @1 where the @4 lines of
; *ai-edit-s* match, compared by @5 (see ai-edit-same). The places are found from SEARCH line
; @3 + 1, whose text without indentation is @2, a blank line when ""
0 define-macro ai-edit-find
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 @4
  set-variable #l5 @5
  set-variable #l9 "|"
  find-buffer #l1
  0xc0 set-position "\xa6"
  end-of-buffer
  set-variable #l8 &sub $window-line 1
  beginning-of-buffer
  !repeat
    !if &len #l2
      !force search-buffer "Me" #l2
    !else
      !force search-buffer "me" "^[ \t]*$"
    !endif
    !iif &not $status  !break
    set-variable #l7 $window-line
    set-variable #l6 &sub #l7 #l3
    !if &and &seq &trb @wl #l2 &and &gre #l6 0 &not &gre &add #l6 &sub #l4 1 #l8
      ; copy the lines below the SEARCH text in *ai-edit-s* to compare them
      set-variable $window-line #l6
      set-mark
      set-variable $window-line &add #l6 #l4
      set-variable #l8 $system
      set-variable $system &bor #l8 0x800000
      copy-region
      find-buffer "*ai-edit-s*"
      set-variable $window-line &add #l4 1
      set-mark
      end-of-buffer
      !force -1 kill-region
      !force yank
      -1 yank
      set-variable $system #l8
      ai-edit-same #l4 #l5
      !iif $result  set-variable #l9 &spr "%s%d|" #l9 #l6
      find-buffer #l1
      end-of-buffer
      set-variable #l8 &sub $window-line 1
    !endif
    set-variable $window-line #l7
    ; an empty line's end is its start, which a blank line search would find again
    !force forward-line
    !iif &not $status  !break
    beginning-of-line
  !done
  0xc0 goto-position "\xa6"
  find-buffer #l0
  set-variable #p9 #l9
!emacro

; $result is 1 when lines @1 to @2 are inside one of the ranges of the | list @3
0 define-macro ai-edit-inside
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 0
  set-variable $result 0
  !iif &les &len #l3 2  !return
  !while &not &seq &set #l5 &lget #l3 &inc #l4 1 ""
    set-variable #l6 &lef #l5 &sub &sin "-" #l5 1
    set-variable #l7 &rig #l5 &sin "-" #l5
    !if &and &not &les #l1 #l6 &not &gre #l2 #l7
      set-variable $result 1
      !return
    !endif
  !done
!emacro

; find the @3 lines of *ai-edit-s* in buffer @1 exactly, then without trailing white space, then
; without indentation. Sets #p1 to the first line of the one place, or of the one inside a range
; of the | list @2, else 0, #p2 to the number of places and #p3 to the comparison that matched
0 define-macro ai-edit-match
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  ; look for the longest SEARCH line, it has the fewest places to check
  find-buffer "*ai-edit-s*"
  beginning-of-buffer
  set-variable #l4 ""
  set-variable #l5 0
  !while &not &gre $window-line #l3
    !if &gre &len &trb @wl &len #l4
      set-variable #l4 &trb @wl
      set-variable #l5 &sub $window-line 1
    !endif
    forward-line
  !done
  find-buffer #l0
  set-variable #p1 0
  set-variable #p2 0
  set-variable #l6 0
  !repeat
    set-variable #l6 &add #l6 1
    ai-edit-find #l1 #l4 #l5 #l3 #l6
  !until &or &not &seq #l9 "|" &equ #l6 3
  set-variable #p3 #l6
  ; one place, or one inside the attached lines
  set-variable #l4 0
  set-variable #l5 0
  set-variable #l7 0
  set-variable #l8 0
  !while &not &seq &set #l1 &lget #l9 &inc #l8 1 ""
    set-variable #l4 &add #l4 1
    set-variable #p1 #l1
    set-variable #l6 &sub &add #l1 #l3 1
    ai-edit-inside #l1 #l6 #l2
    !if $result
      set-variable #l5 &add #l5 1
      set-variable #l7 #l1
    !endif
  !done
  set-variable #p2 #l4
  !if &not &equ #l4 1
    set-variable #p1 &con &equ #l5 1 #l7 0
  !endif
!emacro

; set #p7 to the width of indentation @1 with tabs every @2 columns
0 define-macro ai-indent-width
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 0
  set-variable #l4 0
  !while &les #l4 &len #l1
    !if &seq &mid #l1 #l4 1 "\t"
      set-variable #l3 &mul &add &div #l3 #l2 1 #l2
    !else
      set-variable #l3 &add #l3 1
    !endif
    set-variable #l4 &add #l4 1
  !done
  set-variable #p7 #l3
!emacro

; re-indent *ai-edit-r* for the @3 SEARCH lines that matched line @2 of buffer @1 ignoring
; indentation. The first SEARCH line indented in both, else the first that is not blank, gives
; the change: spaces to tabs or tabs to spaces a level at a time, else the same change of width
; for every line, in tabs and spaces when the file's lines start with tabs
0 define-macro ai-edit-indent
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  find-buffer #l1
  set-variable #l9 $buffer-tab-width
  0xc0 set-position "\xa6"
  beginning-of-buffer
  !force search-buffer "me" "^\t"
  set-variable #l8 $status
  0xc0 goto-position "\xa6"
  ; #l3 & #l4 the model's and the file's indentation, #l5 1 when one of them is empty
  set-variable #l5 0
  find-buffer "*ai-edit-s*"
  beginning-of-buffer
  !while &and &not &gre $window-line @3 &not &equ #l5 2
    !if &not &xse @wl "[ \t]*"
      set-variable #l6 &lef @wl &sub &len @wl &len &trl @wl
      set-variable #l7 &sub $window-line 1
      find-buffer #l1
      set-variable $window-line &add #l2 #l7
      set-variable #l7 &lef @wl &sub &len @wl &len &trl @wl
      find-buffer "*ai-edit-s*"
      !if &or &not #l5 &and &len #l6 &len #l7
        set-variable #l3 #l6
        set-variable #l4 #l7
        set-variable #l5 &con &and &len #l6 &len #l7 2 1
      !endif
    !endif
    forward-line
  !done
  !if #l5
    ; #l5 1 spaces to tabs or 2 tabs to spaces of #l6 spaces a level, else 3 a change of #l6
    set-variable #l5 3
    !if &and &len #l3 &len #l4
      !if &and &seq &rep #l3 " " "" "" &seq &rep #l4 "\t" "" ""
        !if &not &mod &len #l3 &len #l4
          set-variable #l5 1
          set-variable #l6 &div &len #l3 &len #l4
        !endif
      !elif &and &seq &rep #l3 "\t" "" "" &seq &rep #l4 " " "" ""
        !if &not &mod &len #l4 &len #l3
          set-variable #l5 2
          set-variable #l6 &div &len #l4 &len #l3
        !endif
      !endif
    !endif
    !if &equ #l5 3
      ai-indent-width #l4 #l9
      set-variable #l2 #l7
      ai-indent-width #l3 #l9
      set-variable #l6 &sub #l2 #l7
    !endif
    find-buffer "*ai-edit-r*"
    beginning-of-buffer
    !while &not &seq @wc ""
      !if &not &xse @wl "[ \t]*"
        set-variable #l3 &lef @wl &sub &len @wl &len &trl @wl
        set-variable #l4 #l3
        !if &equ #l5 1
          !iif &seq &rep #l3 " " "" ""  set-variable #l4 &spr "%n%n" &div &len #l3 #l6 "\t" &mod &len #l3 #l6 " "
        !elif &equ #l5 2
          !iif &seq &rep #l3 "\t" "" ""  set-variable #l4 &spr "%n" &mul &len #l3 #l6 " "
        !else
          ai-indent-width #l3 #l9
          set-variable #l7 &add #l7 #l6
          !iif &les #l7 0  set-variable #l7 0
          set-variable #l4 &con #l8 &spr "%n%n" &div #l7 #l9 "\t" &mod #l7 #l9 " " &spr "%n" #l7 " "
        !endif
        !if &not &seq #l3 #l4
          beginning-of-line
          ; one at a time, a count would put what is deleted in the kill buffer. #l1, the
          ; buffer's name, is not needed again
          set-variable #l1 &len #l3
          !while &gre &pdec #l1 1 0
            forward-delete-char
          !done
          insert-string #l4
        !endif
      !endif
      beginning-of-line
      forward-line
    !done
  !endif
  find-buffer #l0
!emacro

; set #p9 to the arguments the printf style % formats in buffer @1 take, in order: each format's
; * widths, size and type, the flags, widths and precisions are dropped and types taking the same
; argument are merged. A heuristic, it does not know a language's other formats
0 define-macro ai-edit-formats
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l9 ""
  find-buffer #l1
  beginning-of-buffer
  !repeat
    !force search-buffer "me" "\\(%%\\|%[-+ #0-9.*]*[hlLqjzt]*[diouxXeEfFgGaAcspn]\\)"
    !iif &not $status  !break
    !if &not &seq @s1 "%%"
      set-variable #l2 &xrep @s1 "[-+ #0-9.]" ""
      set-variable #l9 &cat #l9 &xrep &xrep &xrep #l2 "i$" "d" "[ouxX]$" "u" "[eEfFgGaA]$" "f"
    !endif
  !done
  find-buffer #l0
  set-variable #p9 #l9
!emacro

; move the line ranges of the attachments of file @1 in the current chat for the @3 lines from
; line @2 that were replaced by @4 lines
0 define-macro ai-att-shift
  set-variable #l5 @1
  set-variable #l6 @2
  set-variable #l7 &sub &add @2 @3 1
  set-variable #l8 &sub @4 @3
  set-variable #l0 &sub &add @2 @4 1
  !iif &les #l0 #l6  set-variable #l0 #l6
  !iif &not #l8  !return
  ai-chat-map
  set-variable #l9 0
  !while &not &seq &set #l4 &lget .ai-chat.map-atts &inc #l9 1 ""
    set-variable $window-line #l4
    !iif &not &xse @wl "@file[ \t]+\\(.*[^ \t\n]\\)[ \t]*"  !continue
    set-variable #l4 @s1
    ai-att-parse "file" #l4
    !if &and #l2 &seq #l1 #l5
      !if &gre #l2 #l7
        set-variable #l2 &add #l2 #l8
        set-variable #l3 &add #l3 #l8
      !elif &not &les #l3 #l6
        !iif &gre #l2 #l0  set-variable #l2 #l0
        set-variable #l3 &con &les #l3 #l7 &con &gre #l3 #l0 #l0 #l3 &add #l3 #l8
        !iif &les #l3 #l2  set-variable #l3 #l2
      !endif
      !if &xse #l4 "\\(.*[^ \t\n]\\)[ \t]*:\\([0-9]+\\)\\(-\\([0-9]+\\)\\)?"
        set-variable @wl &spr "@file %s%s" @s1 &con &equ #l2 #l3 &spr ":%d" #l2 &spr ":%d-%d" #l2 #l3
      !endif
    !endif
  !done
!emacro

; fill the empty file or buffer @1 (file or buffer) @2, or create the file, with *ai-edit-r* for
; edit @4 to @3, which is attached when @5 is 1. Sets #p8 to the status and #p9 to "q" when the
; user stopped
0 define-macro ai-edit-new
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 @4
  set-variable #l5 @5
  set-variable #p9 ""
  ai-edit-buffer #l1 #l2
  set-variable #l6 #l9
  !if &len #l6
    ; one that is empty is filled as a change to its first line
    find-buffer #l6
    end-of-buffer
    set-variable #l7 &or &gre $window-line 1 $window-col
    find-buffer #l0
    !if #l7
      set-variable #p8 &spr "failed, the SEARCH text is empty but %s is not" #l3
      !return
    !elif &not #l5
      ai-edit-allow #l2 0 #l4
      !if &not &seq #l9 "y"
        set-variable #p8 &spr "skipped, %s is not attached" #l3
        set-variable #p9 &con &seq #l9 "q" "q" ""
        !return
      !endif
    !endif
    ai-edit-do #l6 1 0 #l3 #l4 1
    set-variable #p8 #l8
    set-variable #p9 #l9
    !return
  !elif &seq #l1 "buffer"
    set-variable #p8 &spr "failed, there is no %s" #l3
    !return
  !elif &not &seq &stat "t" #l2 "X"
    set-variable #p8 &spr "failed, %s is not a file" #l3
    !return
  !elif &or &not #l5 &not .ai-apply-edits.auto
    ; accepting all the changes does not let one create a file
    ai-edit-allow #l2 1 #l4
    !if &not &seq #l9 "y"
      set-variable #p8 "rejected"
      set-variable #p9 &con &seq #l9 "q" "q" ""
      !return
    !endif
  !endif
  find-file #l2
  ; a file hook may have put in its new file template
  beginning-of-buffer
  set-mark
  end-of-buffer
  !force -1 kill-region
  ai-edit-append "*ai-edit-r*"
  !iif &not &lfind .ai-apply-edits.bufs $buffer-bname  set-variable .ai-apply-edits.bufs &spr "%s%s|" .ai-apply-edits.bufs $buffer-bname
  end-of-buffer
  set-variable #l7 &sub $window-line 1
  ai-undo-add 1 #l7 0 #l3 #l2
  find-buffer #l0
  set-variable #p8 &spr "applied, created %s" #l3
!emacro

; ask whether file @1, which is not attached, may be changed (@2 0) or created (@2 1) for edit
; @3, once in a run of edits. Sets #p9 to "y", "n" or "q" when the user stopped
0 define-macro ai-edit-allow
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  !if &lfind .ai-apply-edits.ok #l1
    set-variable #p9 "y"
    !return
  !elif &lfind .ai-apply-edits.no #l1
    set-variable #p9 "n"
    !return
  !endif
  !force set-variable #l9 @mc1 &con #l2 &spr "Create %s for edit %d of %d (y/n)? " #l1 #l3 .ai-apply-edits.total &spr "Edit %s, which is not attached (y/n)? " #l1 "yYnN"
  !if &not $status
    set-variable #p9 "q"
    !return
  !endif
  set-variable #l9 &slo #l9
  !if &seq #l9 "y"
    set-variable .ai-apply-edits.ok &spr "%s%s|" .ai-apply-edits.ok #l1
  !else
    set-variable .ai-apply-edits.no &spr "%s%s|" .ai-apply-edits.no #l1
  !endif
  set-variable #p9 #l9
!emacro

; replace the @3 lines from line @2 of buffer @1 with *ai-edit-r*, re-indented when matched by
; comparison 3 (@6), then show it and ask whether to keep it, edit @5 of the reply's changes,
; to @4. Sets #p8 to the status and #p9 to "q" when the user stopped
0 define-macro ai-edit-do
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 @4
  set-variable #l5 @5
  set-variable #l6 @6
  set-variable #p9 ""
  find-buffer #l1
  set-variable #l7 &bmo "view"
  find-buffer .ai-apply-edits.chat
  !if #l7
    set-variable #p8 &spr "failed, %s is read only" #l4
    !return
  !endif
  !iif &equ #l6 3  ai-edit-indent #l1 #l2 #l3
  find-buffer "*ai-edit-r*"
  end-of-buffer
  set-variable #l8 &sub $window-line 1
  ; the old lines are kept in *ai-edit-o*
  ai-temp-buffer "*ai-edit-o*"
  find-buffer #l1
  set-variable #l9 $system
  set-variable $system &bor #l9 0x800000
  !if #l3
    set-variable $window-line #l2
    set-mark
    set-variable $window-line &add #l2 #l3
    copy-region
    find-buffer "*ai-edit-o*"
    !force yank
    -1 yank
    find-buffer #l1
    set-variable $window-line #l2
    set-mark
    set-variable $window-line &add #l2 #l3
    -1 kill-region
  !endif
  set-variable $system #l9
  ai-edit-append-at #l2 "*ai-edit-r*"
  ; a reworded message that changes its % formats breaks the call
  ai-edit-formats "*ai-edit-o*"
  set-variable #l7 #l9
  ai-edit-formats "*ai-edit-r*"
  set-variable #l7 &and &len #l7 &not &seq #l7 #l9
  find-buffer .ai-apply-edits.chat
  ; accepting all the changes does not accept one that changes the % formats
  !if &or &equ .ai-apply-edits.auto 2 &and .ai-apply-edits.auto &not #l7
    set-variable #l9 "y"
  !else
    !force 0 popup-window #l1
    !iif &not $status  1 popup-window #l1
    set-variable $window-line #l2
    -3 show-region
    set-variable $window-line &add #l2 #l8
    3 show-region
    1 show-region
    set-variable $window-line #l2
    recenter
    ; C-g puts the change back and stops, as q
    !force set-variable #l9 @mc1 &spr "Keep edit %d of %d to %s line %d%s (y/n/a/q)? " #l5 .ai-apply-edits.total #l4 #l2 &con #l7 ", its % formats look changed" "" "yYnNaAqQ"
    !iif &not $status  set-variable #l9 "q"
    set-variable #l9 &slo #l9
    -1 show-region
    !force 0 popup-window .ai-apply-edits.chat
  !endif
  !if &or &seq #l9 "n" &seq #l9 "q"
    ; put the old lines back
    find-buffer #l1
    !if #l8
      set-variable $window-line #l2
      set-mark
      set-variable $window-line &add #l2 #l8
      -1 kill-region
    !endif
    ai-edit-append-at #l2 "*ai-edit-o*"
    find-buffer .ai-apply-edits.chat
    set-variable #p8 "rejected"
    !iif &seq #l9 "q"  set-variable #p9 "q"
    !return
  !endif
  !iif &seq #l9 "a"  set-variable .ai-apply-edits.auto 1
  find-buffer #l1
  set-variable $window-line #l2
  set-variable #l7 $window-aline
  set-variable #l9 $buffer-fname
  !iif &not &lfind .ai-apply-edits.bufs #l1  set-variable .ai-apply-edits.bufs &spr "%s%s|" .ai-apply-edits.bufs #l1
  ai-undo-add #l2 #l8 #l3 #l4 ""
  find-buffer .ai-apply-edits.chat
  !iif &len #l9  ai-att-shift #l9 #l7 #l3 #l8
  set-variable #p8 &spr "applied, %s line %d" #l4 #l7
!emacro

; keep an undo record for the change at line @1 of the current buffer, now @2 lines that were the
; @3 lines of *ai-edit-o*, to @4 (its label), or for the creation of file @5 when not "". The
; record's header line holds the buffer's line count after the change, the change's line counting
; any collapsed lines and, for a removal, the number of lines kept before and after it. The lines
; it is checked by follow, a removal's up to 3 either side else the new lines, then the old lines
0 define-macro ai-undo-add
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 @4
  set-variable #l5 @5
  set-variable $window-line #l1
  set-variable #l6 $window-aline
  end-of-buffer
  set-variable #l7 $window-line
  set-variable #l8 0
  set-variable #l9 0
  !if &not #l2
    set-variable #l8 &sub #l1 1
    !iif &gre #l8 3  set-variable #l8 3
    set-variable #l9 &sub #l7 #l1
    !iif &gre #l9 3  set-variable #l9 3
  !endif
  ai-edit-copy &sub #l1 #l8 &add &add #l1 #l2 #l9 "*ai-edit-t*"
  ; the last batch is kept until a change of this one is
  !if &or .ai-apply-edits.undo-new &not &exi ":*ai-undo*:"
    ai-temp-buffer "*ai-undo*"
    set-variable .ai-apply-edits.undo-new 0
  !endif
  find-buffer "*ai-undo*"
  end-of-buffer
  insert-string &spr "\t%s\t%d\t%d\t%d\t%s\t%s\t%d\t%d\t%d\t%d\t%s\t\n" #l0 #l1 #l2 #l3 #l4 .ai-apply-edits.chat #l7 #l6 #l8 #l9 #l5
  ai-edit-append "*ai-edit-t*"
  !iif #l3  ai-edit-append "*ai-edit-o*"
  !force 0 delete-buffer "*ai-edit-t*"
  find-buffer #l0
!emacro

; insert the text of buffer @2 at the start of line @1 of the current buffer
0 define-macro ai-edit-append-at
  set-variable #l0 $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  find-buffer #l2
  end-of-buffer
  !if &gre $window-line 1
    set-mark
    beginning-of-buffer
    set-variable #l3 $system
    set-variable $system &bor #l3 0x800000
    copy-region
    find-buffer #l0
    set-variable $window-line #l1
    !force yank
    -1 yank
    set-variable $system #l3
  !endif
  find-buffer #l0
!emacro

; apply change @5 of .ai-apply-edits.total, held in *ai-edit-s* & *ai-edit-r*, to the file named @1 in
; its block, sets #p8 to its status and #p9 to "q" when the user stopped
0 define-macro ai-edit-apply
  set-variable #l5 @1
  set-variable #l6 @2
  set-variable #p9 ""
  ; the attached ranges move as changes are kept
  ai-att-scan
  ai-edit-target #l5
  !if &len #l8
    set-variable #p8 &spr "failed, %s could be %s" #l5 #l8
    !return
  !endif
  find-buffer "*ai-edit-s*"
  end-of-buffer
  set-variable #l7 &sub $window-line 1
  find-buffer .ai-apply-edits.chat
  !if &not #l7
    ai-edit-new #l1 #l2 #l5 #l6 #l4
    set-variable #p8 #l8
    set-variable #p9 #l9
    !return
  !elif &not #l4
    ; accepting all the changes does not let one change a file that is not attached
    ai-edit-allow #l2 0 #l6
    !if &not &seq #l9 "y"
      set-variable #p8 &spr "skipped, %s is not attached" #l5
      set-variable #p9 &con &seq #l9 "q" "q" ""
      !return
    !endif
  !endif
  ai-edit-buffer #l1 #l2
  !if &seq #l9 ""
    set-variable #p8 &spr "failed, there is no %s" #l5
    !return
  !endif
  set-variable #l8 #l9
  ai-edit-match #l8 #l3 #l7
  !if &not #l1
    find-buffer #l8
    set-variable #l4 &bmo "narrow"
    find-buffer .ai-apply-edits.chat
    !if #l2
      set-variable #p8 &spr "failed, the SEARCH text matches %d places in %s" #l2 #l5
    !elif #l4
      set-variable #p8 &spr "failed, the SEARCH text is not in the lines of %s shown, it has collapsed parts" #l5
    !else
      set-variable #p8 &spr "failed, the SEARCH text is not in %s" #l5
    !endif
    !return
  !endif
  ai-edit-do #l8 #l1 #l7 #l5 #l6 #l3
  set-variable #p8 #l8
  set-variable #p9 #l9
!emacro

; apply change @1, an *ai-edits* record whose chat lines are now @2 lines further on, the @3rd
; of the reply's, then write its status. #p9 is "q" when the user stopped
0 define-macro ai-edit-change
  set-variable #l6 @3
  set-variable #l7 &add &lget @1 6 @2
  set-variable #l5 &lget @1 1
  set-variable #l9 ""
  !if .ai-apply-edits.reject-this
    set-variable #l8 "rejected"
  !else
    ; sets #l8 to why it cannot be applied
    set-variable #l4 @1
    set-variable #l3 @2
    ai-edit-fetch #l4 #l3
    !iif &not &len #l8  ai-edit-apply #l5 #l6
  !endif
  find-buffer .ai-apply-edits.chat
  ; the status lines are kept in the order of the changes
  set-variable $window-line #l7
  !repeat
    forward-line
    !iif &not &xse @wl "(edit \\([0-9]+\\) [a-z]+.*"  !break
  !until &gre @s1 &lget @1 7
  insert-string &spr "(edit %d %s)\n" &lget @1 7 #l8
  !if &seq &lef #l8 7 "applied"
    set-variable .ai-apply-edits.kept &add .ai-apply-edits.kept 1
  !elif &not &seq #l8 "rejected"
    set-variable .ai-apply-edits.bad &add .ai-apply-edits.bad 1
  !endif
  set-variable #p9 #l9
!emacro

; apply the changes of the edit blocks between lines @1 and @2 of the current chat, asking
; about each unless @3 is 1
0 define-macro ai-edit-run
  set-variable .ai-apply-edits.chat $buffer-bname
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable .ai-apply-edits.auto @3
  set-alpha-mark "\xa8"
  ai-att-scan
  ai-edit-list #l1 #l2
  !if &not #l9
    !force 0 delete-buffer "*ai-edits*"
    !force 0 delete-buffer "*ai-att*"
    goto-alpha-mark "\xa8"
    set-variable .ai-apply-edits.msg &con #l8 "[AI: each change has a status line, delete one to apply its change again]" "[AI: no edits to apply]"
    ml-write .ai-apply-edits.msg
    !return
  !endif
  set-variable .ai-apply-edits.total #l9
  set-variable .ai-apply-edits.kept 0
  set-variable .ai-apply-edits.bad 0
  set-variable .ai-apply-edits.bufs "|"
  ; the files not attached that the user let the changes edit or create, or would not
  set-variable .ai-apply-edits.ok "|"
  set-variable .ai-apply-edits.no "|"
  ; the undo records of the last run are replaced once a change of this one is kept
  set-variable .ai-apply-edits.undo-new 1
  find-buffer .ai-apply-edits.chat
  ; status lines written for one block move the lines of the blocks after it
  set-variable #l3 0
  set-variable #l4 0
  set-variable #l5 0
  set-variable #l6 0
  !while &les #l3 .ai-apply-edits.total
    set-variable #l3 &add #l3 1
    find-buffer "*ai-edits*"
    set-variable $window-line #l3
    set-variable #l7 @wl
    find-buffer .ai-apply-edits.chat
    !if &not &equ &lget #l7 6 #l6
      set-variable #l4 &add #l4 #l5
      set-variable #l5 0
      set-variable #l6 &lget #l7 6
    !endif
    ; from the review of the changes as a diff, one not decided is left for later
    set-variable .ai-apply-edits.reject-this 0
    !if &len .ai-apply-edits.decide
      set-variable #l8 &lget .ai-apply-edits.decide #l3
      !iif &seq #l8 " "  !continue
      set-variable .ai-apply-edits.reject-this &seq #l8 "n"
    !endif
    ai-edit-change #l7 #l4 #l3
    set-variable .ai-apply-edits.reject-this 0
    set-variable #l5 &add #l5 1
    !iif &seq #l9 "q"  !break
  !done
  !force 0 delete-buffer "*ai-edits*"
  !force 0 delete-buffer "*ai-edit-s*"
  !force 0 delete-buffer "*ai-edit-r*"
  !force 0 delete-buffer "*ai-edit-o*"
  !force 0 delete-buffer "*ai-att*"
  find-buffer .ai-apply-edits.chat
  goto-alpha-mark "\xa8"
  set-variable #l1 &rig &rep .ai-apply-edits.bufs "|" " " 1
  set-variable #l1 &con .ai-apply-edits.kept &spr " to %s, not saved" &trr #l1 ""
  set-variable #l2 &con .ai-apply-edits.bad &spr ", %d failed" .ai-apply-edits.bad ""
  set-variable .ai-apply-edits.msg &spr "[AI: %d of %d edits applied%s%s%s]" .ai-apply-edits.kept .ai-apply-edits.total #l1 #l2 &con .ai-apply-edits.kept ", ai-undo-edits undoes them" ""
  ml-write .ai-apply-edits.msg
!emacro

; apply the edit blocks of the reply at or before the point in the chat, or of the last reply
; in *ai-chat* from any other buffer, asking about each change unless given an argument of 0
define-macro ai-apply-edits
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  ; the edits are reviewed now rather than once the user stops typing
  !force -1 create-callback ai-edit-review
  0x01 set-position "\xa1"
  !if &not &exi :ai-chat
    !force 0 popup-window .ai-chat.current
    !if &not $status
      ml-write "[AI: there is no chat]"
      !abort
    !endif
    end-of-buffer
  !endif
  set-alpha-mark "\xa8"
  ai-edit-reply
  goto-alpha-mark "\xa8"
  !if &not #l1
    0x01 goto-position "\xa1"
    ml-write "[AI: no reply to apply]"
    !abort
  !endif
  set-variable #l3 &and @? &not @#
  ai-edit-run #l1 #l2 #l3
  0x01 goto-position "\xa1"
!emacro

; undo the edits kept by the last ai-apply-edits, unless a line has been changed since
define-macro ai-undo-edits
  !if &not &exi ":*ai-undo*:"
    ml-write "[AI: no edits to undo]"
    !abort
  !endif
  set-variable #l0 $buffer-bname
  ; the records, last first
  find-buffer "*ai-undo*"
  beginning-of-buffer
  set-variable #l1 "|"
  !while &not &seq @wc ""
    set-variable #l1 &spr "|%d%s" $window-line #l1
    set-variable #l2 @wl
    set-variable $window-line &add &add $window-line 1 &add &add &lget #l2 3 &lget #l2 4 &add &lget #l2 9 &lget #l2 10
  !done
  ; #l2 undone, #l3 changed since, #l6 read only, #l7 failed
  set-variable #l2 0
  set-variable #l3 0
  set-variable #l6 0
  set-variable #l7 0
  set-variable #l4 0
  !while &not &seq &set #l5 &lget #l1 &inc #l4 1 ""
    find-buffer "*ai-undo*"
    set-variable $window-line #l5
    ; a failure leaves the other records to be undone
    !force ai-undo-one #l5
    !if &not $status
      set-variable #l7 &add #l7 1
    !elif &equ $result 1
      set-variable #l2 &add #l2 1
    !elif &equ $result 2
      set-variable #l6 &add #l6 1
    !else
      set-variable #l3 &add #l3 1
    !endif
  !done
  !force 0 delete-buffer "*ai-undo*"
  !force 0 delete-buffer "*ai-edit-s*"
  !force 0 delete-buffer "*ai-edit-t*"
  !force 0 delete-buffer "*ai-edit-o*"
  find-buffer #l0
  set-variable #l8 &con #l3 &spr ", %d changed since so left" #l3 ""
  !iif #l6  set-variable #l8 &spr "%s, %d read only so left" #l8 #l6
  !iif #l7  set-variable #l8 &spr "%s, %d failed" #l8 #l7
  ml-write &spr "[AI: %d edit%s undone%s]" #l2 &con &equ #l2 1 "" "s" #l8
!emacro

; set #p3 to the first line of the one place in buffer @1 holding exactly the @2 lines of
; *ai-edit-s*, else 0
0 define-macro ai-undo-find
  set-variable #l4 @1
  set-variable #l5 @2
  ai-edit-match #l4 "|" #l5
  set-variable #p3 &con &equ #l3 1 #l1 0
!emacro

; undo the edit whose record starts on line @1 of *ai-undo*, $result is 1 when it is undone, 2
; when its buffer is read only and 0 when its lines have changed since. It is checked by the new
; lines, or for a removal the lines around it, which are looked for when lines have been added or
; removed. A created file's buffer is deleted when unchanged and the file has not been saved
0 define-macro ai-undo-one
  set-variable #l1 @1
  set-variable #l9 @wl
  set-variable #l2 &lget #l9 1
  set-variable #l3 &lget #l9 2
  set-variable #l4 &lget #l9 3
  set-variable #l5 &lget #l9 4
  ; #l8 the lines kept before a removal, #l7 all the lines it is checked by
  set-variable #l8 &lget #l9 9
  set-variable #l7 &add &add #l4 #l8 &lget #l9 10
  set-variable $result 0
  !iif &not &exi &spr ":%s:" #l2  !return
  find-buffer #l2
  !if &len &lget #l9 11
    ; a created file, its buffer is still for it and the file is not saved
    set-variable #l6 &and &seq $buffer-fname &lget #l9 11 &seq &stat "t" &lget #l9 11 "X"
  !else
    set-variable #l6 1
  !endif
  set-variable #l0 &bmo "view"
  find-buffer "*ai-undo*"
  !iif &not #l6  !return
  !if #l0
    set-variable $result 2
    !return
  !endif
  set-variable #l6 &add #l1 1
  ai-edit-copy #l6 &add #l6 #l7 "*ai-edit-s*"
  find-buffer #l2
  end-of-buffer
  set-variable #l6 0
  !if &equ $window-line &lget #l9 7
    ai-edit-copy &sub #l3 #l8 &add &sub #l3 #l8 #l7 "*ai-edit-t*"
    find-buffer "*ai-edit-s*"
    end-of-buffer
    ai-edit-append "*ai-edit-t*"
    ai-edit-same #l7 1
    set-variable #l6 $result
  !endif
  ; moved by lines added or removed, a created file is not looked for
  !if &and &not #l6 &and #l7 &not &len &lget #l9 11
    ai-undo-find #l2 #l7
    !if #l3
      set-variable #l3 &add #l3 #l8
      set-variable #l6 1
    !endif
  !endif
  set-variable $result 0
  !iif &not #l6  !return
  set-variable #l6 &lget #l9 6
  !if &len &lget #l9 11
    0 delete-buffer #l2
    set-variable #l7 &spr "created %s" &lget #l9 5
  !else
    ; the old lines back in place of the new
    find-buffer "*ai-undo*"
    set-variable #l7 &add &add #l1 1 #l7
    ai-edit-copy #l7 &add #l7 #l5 "*ai-edit-o*"
    find-buffer #l2
    !if #l4
      set-variable $window-line #l3
      set-mark
      set-variable $window-line &add #l3 #l4
      -1 kill-region
    !endif
    ai-edit-append-at #l3 "*ai-edit-o*"
    set-variable $window-line #l3
    set-variable #l3 $window-aline
    set-variable #l8 $buffer-fname
    ; the chat's ranges
    !if &and &len #l8 &exi &spr ":%s:" #l6
      find-buffer #l6
      ai-att-shift #l8 #l3 #l4 #l5
    !endif
    set-variable #l7 &spr "%s line %d" &lget #l9 5 &lget #l9 8
  !endif
  ; the edit's status
  !if &exi &spr ":%s:" #l6
    find-buffer #l6
    str-to-regex #l7
    beginning-of-buffer
    !force search-buffer "me" &spr "^(edit \\([0-9]+\\) applied, \\(%s\\))$" #l7
    !iif $status  set-variable @wl &spr "(edit %s undone, %s)" @s1 @s2
  !endif
  find-buffer "*ai-undo*"
  set-variable $result 1
!emacro

; review the edits of the reply to an ai-edit question, run once the reply is in
0 define-macro ai-edit-review
  !iif .ai-send.busy  !return
  !iif &not &exi &spr ":%s:" .ai-apply-edits.review-chat  !return
  ; wait for a second without a key press, so keys being typed are not taken as answers
  !if &not &seq $recent-keys .ai-apply-edits.review-keys
    set-variable .ai-apply-edits.review-keys $recent-keys
    1000 create-callback ai-edit-review
    !return
  !endif
  0x01 set-position "\xa1"
  !force 0 popup-window .ai-apply-edits.review-chat
  !iif &not $status  1 popup-window .ai-apply-edits.review-chat
  end-of-buffer
  ai-edit-reply
  set-variable .ai-apply-edits.msg ""
  !iif #l1  ai-edit-run #l1 #l2 0
  0x01 goto-position "\xa1"
  ; the window change clears the message line when run as a callback
  !if &len .ai-apply-edits.msg
    1 screen-update
    ml-write .ai-apply-edits.msg
  !endif
!emacro

; ask for a change to the attached code. From a file buffer the file, or the lines of the
; region, is attached. The copied text, such as an error message, is offered as a quote and the
; user says how to change it, or picks a template from %ai-edit-actions. Once the reply is in
; its edits are reviewed as by ai-apply-edits
define-macro ai-edit
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  set-variable #l5 ""
  !if &exi :ai-chat
    ; only the chat's attachments, which need to be there
    ai-att-scan
    !force 0 delete-buffer "*ai-att*"
    !if &not #l8
      ml-write "[AI: attach the code to change first, C-c f]"
      !abort
    !endif
  !else
    ai-buffer-source
    set-variable #l5 #l7
    set-variable #l6 #l8
    set-variable #l7 0
    set-variable #l8 0
    ai-get-region
    !if #l9
      0xc0 set-position "\xa6"
      set-variable $window-line #l1
      set-variable #l7 $window-aline
      set-variable $window-line &sub #l3 &not #l4
      set-variable #l8 $window-aline
      !iif &les #l8 #l7  set-variable #l8 #l7
      0xc0 goto-position "\xa6"
    !endif
  !endif
  ; the quote, offered from the clipboard or the last copy
  !force set-variable #l1 @1
  !if &not $status
    ; the clipboard is fetched into the kill buffer to read it, then taken out again
    !force set-variable #l3 @y
    !iif &not $status  set-variable #l3 "\x01"
    !force -98 yank
    !force set-variable #l1 @y
    !iif &not $status  set-variable #l1 ""
    !iif &not &seq #l1 #l3  !force -1 yank
    !iif &sin "\n" #l1  set-variable #l1 &lef #l1 &sub &sin "\n" #l1 1
    set-variable #l1 @ml20 "Text to quote, e.g. the message (empty for none)" &trb #l1
  !endif
  ; how to change it, or a template, which may ask for the user's words in place of its %s
  !force set-variable #l2 @2
  ; the templates are the prompt's history, up and down, as completion would take a space typed
  !iif &not $status  set-variable #l2 @ml0b "How should it change (up for templates)" %ai-edit-actions
  !iif &seq #l2 ""  !abort
  !if &lfind %ai-edit-actions #l2
    set-variable #l3 &ind &cat "%ai-edit-action-" #l2
    !if &sin "%s" #l3
      !force set-variable #l4 @3
      !iif &not $status  set-variable #l4 @ml00 &spr "%s, how should it change" #l2
      !iif &seq #l4 ""  !abort
      set-variable #l3 &rep #l3 "%s" #l4
    !endif
    set-variable #l2 #l3
  !endif
  0x01 set-position "\xa1"
  ai-chat
  ai-chat-question
  !iif &len #l5  ai-chat-attach #l5 #l6 #l7 #l8
  ai-chat-text-point
  !if &len #l1
    set-variable #l3 &con &sin "```" #l1 "~~~" "```"
    insert-string &spr "%stext\n%s\n%s\n" #l3 #l1 #l3
  !endif
  insert-string &cat #l2 "\n"
  set-variable .ai-apply-edits.review-next 1
  !force ai-start
  !iif &not .ai-send.busy  set-variable .ai-apply-edits.review-next 0
  0x01 goto-position "\xa1"
!emacro

; Saved chats: each chat is written to %ai-chat-dir as it is sent and replied to

; set #p9 to the file for the chat in the current buffer, named by when it starts and the first
; line of its first question
0 define-macro ai-chat-file
  set-variable #l1 $time
  set-variable #l2 &spr "%s-%s-%s-%s%s" &mid #l1 0 4 &mid #l1 7 2 &mid #l1 9 2 &mid #l1 12 2 &mid #l1 14 2
  set-variable #l3 ""
  ai-chat-map
  set-variable #l4 0
  !while &and &not &len #l3 &not &seq &set #l5 &lget .ai-chat.map-roles &inc #l4 1 ""
    set-variable $window-line #l5
    !if &xse @wl .ai-chat.you-re
      !repeat
        !force forward-line
        !iif &or &not $status &seq @wc ""  !break
        !iif &xse @wl .ai-chat.role-re  !break
        !if &not &or &xse @wl "[ \t]*" &xse @wl .ai-chat.att-line
          set-variable #l3 @wl
          !break
        !endif
      !done
    !endif
  !done
  set-variable #l3 &slo &xrep #l3 "[^A-Za-z0-9]+" "-"
  !iif &gre &len #l3 40  set-variable #l3 &lef #l3 40
  !while &seq &lef #l3 1 "-"
    set-variable #l3 &rig #l3 1
  !done
  !while &seq &rig #l3 &sub &len #l3 1 "-"
    set-variable #l3 &lef #l3 &sub &len #l3 1
  !done
  set-variable #l6 %ai-chat-dir
  !iif &not &seq &rig #l6 &sub &len #l6 1 "/"  set-variable #l6 &cat #l6 "/"
  set-variable #l7 &spr "%s%s%s" #l6 #l2 &con &len #l3 &cat "-" #l3 ""
  ; another chat started in the same minute
  set-variable #l8 &cat #l7 ".md"
  set-variable #l9 1
  !while &not &seq &stat "t" #l8 "X"
    set-variable #l9 &add #l9 1
    set-variable #l8 &spr "%s-%d.md" #l7 #l9
  !done
  set-variable #p9 #l8
!emacro

; save the chat in the current buffer, once it has a reply, to its file in %ai-chat-dir
0 define-macro ai-chat-save
  !iif &not %ai-chat-save  !return
  !iif &not &exi :ai-chat  !return
  set-variable #l0 $buffer-bname
  0x0c0 set-position "\xab"
  beginning-of-buffer
  !force search-buffer "me" &spr "^%s$" .ai-chat.ai-re
  !if &not $status
    0x0c0 goto-position "\xab"
    !return
  !endif
  !if &not &exi :ai-file
    ai-chat-file
    set-variable :ai-file #l9
  !endif
  set-variable #l1 :ai-file
  set-variable #l2 &lef #l1 &rsin "/" #l1
  !iif &not &seq &stat "t" #l2 "D"  !force 0x100 file-op #l2
  beginning-of-buffer
  set-mark
  end-of-buffer
  set-variable #l3 $system
  set-variable $system &bor #l3 0x800000
  copy-region
  ai-temp-buffer "*ai-save*"
  !force yank
  -1 yank
  set-variable $system #l3
  !force 0 write-buffer #l1
  set-variable #l4 $status
  0 delete-buffer $buffer-bname
  find-buffer #l0
  0x0c0 goto-position "\xab"
  !iif &not #l4  ml-write &spr "[AI: could not save the chat to %s]" #l1
!emacro

; open a saved chat in the chat window, the chat there is saved first. It is chosen from the
; files in %ai-chat-dir, the newest first
define-macro ai-chat-open
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  set-variable #l0 $buffer-bname
  set-variable #l2 %ai-chat-dir
  !iif &not &seq &rig #l2 &sub &len #l2 1 "/"  set-variable #l2 &cat #l2 "/"
  ai-temp-buffer "*ai-chats*"
  !if &seq &stat "t" #l2 "D"
    set-variable $file-names &cat #l2 ".*\\.md"
    !while &not &seq &set #l3 $file-names ""
      beginning-of-buffer
      insert-string &cat #l3 "\n"
    !done
  !endif
  beginning-of-buffer
  set-variable #l3 @wl
  find-buffer #l0
  !if &seq #l3 ""
    ml-write &spr "[AI: there are no saved chats in %s]" #l2
    !abort
  !endif
  !force set-variable #l1 @ml1a "Open AI chat" #l3 "*ai-chats*"
  set-variable #l4 $status
  !force 0 delete-buffer "*ai-chats*"
  !iif &not #l4  !abort
  set-variable #l1 &cat #l2 #l1
  !if &not &seq &stat "t" #l1 "R"
    ml-write &spr "[AI: no file %s]" #l1
    !abort
  !endif
  ai-chat
  !force ai-chat-save
  beginning-of-buffer
  set-mark
  end-of-buffer
  !force -1 kill-region
  insert-file #l1
  set-variable :ai-file #l1
  !force unset-variable :ai-tokens-in
  !force unset-variable :ai-tokens-out
  ; ready for the next question
  ai-chat-map
  set-variable #l5 .ai-chat.map-last
  !iif #l5  set-variable $window-line #l5
  !if &not &and #l5 &xse @wl .ai-chat.you-re
    ai-chat-close-fence
    ai-chat-separate
    insert-string "## You\n\n"
  !endif
  end-of-buffer
  ml-write &spr "[AI: opened %s]" &rig #l1 &rsin "/" #l1
!emacro

; branch the chat at the point: a new chat holding this one up to the end of the part at the
; point, to go on from there another way
define-macro ai-fork
  !if &not &exi :ai-chat
    ml-write "[AI: run this in a chat, at the part to branch after]"
    !abort
  !endif
  set-variable #l0 $buffer-bname
  set-variable #l1 $window-line
  ai-chat-map
  set-variable #l2 0
  set-variable #l3 0
  !while &not &seq &set #l4 &lget .ai-chat.map-roles &inc #l3 1 ""
    !if &gre #l4 #l1
      set-variable #l2 #l4
      !break
    !endif
  !done
  !iif &not #l2  set-variable #l2 $window-eline
  ; the first free name
  set-variable #l5 2
  !while &exi &spr ":*ai-chat:%d*:" #l5
    set-variable #l5 &add #l5 1
  !done
  set-variable #l6 &spr "*ai-chat:%d*" #l5
  beginning-of-buffer
  set-mark
  set-variable $window-line #l2
  set-variable #l7 $system
  set-variable $system &bor #l7 0x800000
  copy-region
  set-variable $window-line #l1
  find-buffer #l6
  !force yank
  -1 yank
  set-variable $system #l7
  ai-chat-setup
  ; a branch at a question leaves it to be changed and sent, else a new question is started
  ai-chat-map
  set-variable #l8 .ai-chat.map-last
  !iif #l8  set-variable $window-line #l8
  !iif &not &and #l8 &xse @wl .ai-chat.you-re  ai-chat-question
  set-variable .ai-chat.current #l6
  find-buffer #l0
  !force 0 popup-window #l6
  !iif &not $status  1 popup-window #l6
  end-of-buffer
  ml-write &spr "[AI: branched into %s, ai-chat with an argument switches chats]" #l6
!emacro

; $result is 1 when the part of the current chat from role line @1 to line @2 (exclusive) has
; text other than blank lines
0 define-macro ai-part-has-text
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable $result 0
  set-variable $window-line &add #l1 1
  !while &les $window-line #l2
    !if &not &xse @wl "[ \t]*"
      set-variable $result 1
      !return
    !endif
    !force forward-line
    !iif &not $status  !return
  !done
!emacro

; ask the last question again, the reply to it and anything after are replaced
define-macro ai-retry
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  !iif &not &exi :ai-chat  ai-chat
  ai-chat-map
  ; the last question with text that has a reply after it
  set-variable #l1 0
  set-variable #l2 0
  set-variable #l3 0
  set-variable #l6 0
  !while &not &seq &set #l4 &lget .ai-chat.map-roles &inc #l3 1 ""
    set-variable #l5 &lget .ai-chat.map-roles &add #l3 1
    !iif &seq #l5 ""  set-variable #l5 &add $window-eline 1
    set-variable $window-line #l4
    !if &xse @wl .ai-chat.you-re
      ai-part-has-text #l4 #l5
      !if $result
        set-variable #l1 #l4
        set-variable #l2 &con &les #l5 $window-eline #l5 0
        set-variable #l6 0
      !endif
    !elif #l1
      set-variable #l6 1
    !endif
  !done
  !if &not &and #l1 &and #l2 #l6
    ml-write "[AI: no question with a reply to ask again, C-c C-c sends a new one]"
    !abort
  !endif
  ; a question written since would be lost
  set-variable $window-line .ai-chat.map-last
  !if &and &xse @wl .ai-chat.you-re &gre .ai-chat.map-last #l2
    ai-part-has-text .ai-chat.map-last &add $window-eline 1
    !if $result
      ml-write "[AI: the last question has not been sent, C-c C-c sends it]"
      !abort
    !endif
  !endif
  set-variable $window-line #l2
  !force search-buffer "me" "^(edit [0-9]+ applied"
  !if $status
    !if &not &iseq @mc1 "Its edits were applied, ask again anyway (y/n)? " "yYnN" "y"
      !abort
    !endif
  !endif
  set-variable $window-line #l2
  set-mark
  end-of-buffer
  -1 kill-region
  set-variable .ai-send.tool-round 0
  ai-start
!emacro

; quote the selected text in the question being written, as > lines
define-macro ai-quote
  ai-get-region
  !if &not #l9
    ml-write "[AI: select the text to quote first]"
    !abort
  !endif
  set-variable #l5 &exi :ai-chat
  set-variable #l0 $buffer-bname
  0x53f set-position "\xa1"
  set-variable $window-line #l1
  set-variable $window-col #l2
  set-mark
  set-variable $window-line #l3
  set-variable $window-col #l4
  set-variable #l6 $system
  set-variable $system &bor #l6 0x800000
  copy-region
  goto-position "\xa1"
  ai-temp-buffer "*ai-quote*"
  !force yank
  -1 yank
  set-variable $system #l6
  ; the last line with text
  end-of-buffer
  set-variable #l8 0
  !while &gre $window-line 1
    backward-line
    !if &not &xse @wl "[ \t]*"
      set-variable #l8 $window-line
      !break
    !endif
  !done
  !if &not #l8
    !force 0 delete-buffer "*ai-quote*"
    find-buffer #l0
    ml-write "[AI: nothing to quote]"
    !abort
  !endif
  ; each line up to it starts with >, the rest is dropped
  beginning-of-buffer
  !while &not &gre $window-line #l8
    insert-string &con &xse @wl "[ \t]*" ">" "> "
    forward-line
    beginning-of-line
  !done
  set-mark
  end-of-buffer
  !force -1 kill-region
  0x01 set-position "\xa1"
  ai-chat
  ai-chat-map
  set-variable #l1 .ai-chat.map-last
  !iif #l1  set-variable $window-line #l1
  !if &and #l1 &xse @wl .ai-chat.you-re
    end-of-buffer
    ; after a blank line, unless just below the "## You" line
    backward-line
    set-variable #l2 &not &or &xse @wl "[ \t]*" &xse @wl .ai-chat.you-re
    forward-line
    !iif #l2  insert-string "\n"
  !else
    ai-chat-question
  !endif
  set-variable #l9 $window-line
  ai-edit-append-at #l9 "*ai-quote*"
  !force 0 delete-buffer "*ai-quote*"
  end-of-buffer
  insert-string "\n"
  !if &not #l5
    0x01 goto-position "\xa1"
    ml-write "[AI: quoted in the chat]"
  !endif
!emacro

; set #p9 to the | list of the opening fence lines of the code blocks of the current chat
0 define-macro ai-chat-blocks
  0xc0 set-position "\xaa"
  set-variable #l1 "|"
  set-variable #l2 ""
  beginning-of-buffer
  !repeat
    !force search-buffer "me" .ai-chat.fence-regex
    !iif &not $status  !break
    !iif &not &len #l2  set-variable #l1 &spr "%s%d|" #l1 $window-line
    ai-fence-line @wl #l2
    set-variable #l2 .ai-chat.fence
    end-of-line
  !done
  0xc0 goto-position "\xaa"
  set-variable #p9 #l1
!emacro

; move to the next (@1 1) or previous (@1 0) line of | list @2 from the current line, else say
; there is none, which is called @3
0 define-macro ai-chat-move
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l4 $window-line
  set-variable #l5 0
  set-variable #l6 0
  !while &not &seq &set #l7 &lget #l2 &inc #l6 1 ""
    !if #l1
      !if &gre #l7 #l4
        set-variable #l5 #l7
        !break
      !endif
    !elif &les #l7 #l4
      set-variable #l5 #l7
    !endif
  !done
  !if &not #l5
    ml-write &spr "[AI: no %s %s]" &con #l1 "next" "previous" #l3
    !return
  !endif
  set-variable $window-line #l5
  beginning-of-line
!emacro

define-macro ai-next-part
  ai-chat-map
  ai-chat-move 1 .ai-chat.map-roles "part"
!emacro

define-macro ai-prev-part
  ai-chat-map
  ai-chat-move 0 .ai-chat.map-roles "part"
!emacro

define-macro ai-next-block
  ai-chat-blocks
  ai-chat-move 1 #l9 "code block"
!emacro

define-macro ai-prev-block
  ai-chat-blocks
  ai-chat-move 0 #l9 "code block"
!emacro

; fold or unfold the part of the chat at the point, the chat is unfolded when it is sent or
; changed by these commands
define-macro ai-fold
  !iif &not &exi collapse-current  !force execute-file "collapse"
  ; on a folded part's line it is opened
  !force 2 narrow-buffer
  !iif $status  !return
  !force search-buffer "bme" &spr "^%s$" .ai-chat.role-re
  !if &not $status
    ml-write "[AI: not in a part of the chat]"
    !abort
  !endif
  !if &and .ai-send.busy &seq $buffer-bname .ai-send.target
    set-variable #l1 $window-line
    goto-alpha-mark "\xa5"
    set-variable #l2 $window-line
    set-variable $window-line #l1
    !if &not &gre #l1 #l2
      ; not the reply being written, which would go into the fold
    !else
      ml-write "[AI: the reply is being written]"
      !abort
    !endif
  !endif
  forward-line
  !force collapse-current
!emacro

; Tools: with %ai-tools 1 the model may ask to read a file of the project, search the files or
; list them. Each request is shown and only run when the user allows it, its result is added to
; the chat as a "## Tool" part and the chat is sent again

; set #p9 to the directory the tools work in: an attached tree's, else the directory the
; attachments' labels start from, else the current directory. The chat is the current buffer
0 define-macro ai-tool-root
  set-variable #l0 $buffer-bname
  ai-att-scan
  set-variable #l1 ""
  find-buffer "*ai-att*"
  beginning-of-buffer
  !while &not &seq @wc ""
    !iif &and &seq #l1 "" &seq &lget @wl 1 "tree"  set-variable #l1 &cat &lget @wl 2 "/"
    forward-line
  !done
  beginning-of-buffer
  !while &and &seq #l1 "" &not &seq @wc ""
    !if &seq &lget @wl 1 "file"
      set-variable #l2 &lget @wl 2
      set-variable #l1 &lef #l2 &sub &len #l2 &len &lget @wl 6
    !endif
    forward-line
  !done
  !iif &seq #l1 ""  set-variable #l1 &stat "a" "./"
  !iif &not &seq &rig #l1 &sub &len #l1 1 "/"  set-variable #l1 &cat #l1 "/"
  !force 0 delete-buffer "*ai-att*"
  find-buffer #l0
  set-variable #p9 #l1
!emacro

; set #p9 to string argument @1 of the tool call in *ai-tool-args*, "" when not given
0 define-macro ai-tool-arg
  set-variable #l1 @1
  set-variable #l0 $buffer-bname
  set-variable #p9 ""
  find-buffer "*ai-tool-args*"
  beginning-of-buffer
  !force search-buffer "me" &spr "\"%s\"[ \t\r\n]*:[ \t\r\n]*\\(\"\\|-?[0-9]+\\)" #l1
  !if $status
    !if &seq @s1 "\""
      ai-temp-buffer "*ai-tool-val*"
      find-buffer "*ai-tool-args*"
      ai-json-string "*ai-tool-val*"
      find-buffer "*ai-tool-val*"
      beginning-of-buffer
      set-variable #p9 @wl
      !force 0 delete-buffer "*ai-tool-val*"
    !else
      set-variable #p9 @s1
    !endif
  !endif
  find-buffer #l0
!emacro

; set #p9 to the absolute name of path @1 of the tool call, relative to directory @2
0 define-macro ai-tool-path
  set-variable #l1 @1
  set-variable #l2 @2
  !iif &seq #l1 ""  set-variable #l1 "."
  !iif &not &sin &lef #l1 1 "/~"  set-variable #l1 &cat #l2 #l1
  set-variable #l1 &stat "a" #l1
  !iif &and &gre &len #l1 1 &seq &rig #l1 &sub &len #l1 1 "/"  set-variable #l1 &lef #l1 &sub &len #l1 1
  set-variable #p9 #l1
!emacro

; escape @1 to be put in double quotes in a shell command
0 define-macro ai-sh-quote
  set-variable #l1 @1
  set-variable #l1 &rep #l1 "\\" "\\\\"
  set-variable #l1 &rep #l1 "\"" "\\\""
  set-variable #l1 &rep #l1 "$" "\\$"
  set-variable #l1 &rep #l1 "`" "\\`"
  set-variable #p9 #l1
!emacro

; set #p8 to what tool call @1 (name) with the arguments in *ai-tool-args* asks for, from directory
; @2, and #p7 to the absolute path it works on
0 define-macro ai-tool-describe
  set-variable #l1 @1
  set-variable #l2 @2
  ai-tool-arg "path"
  set-variable #l3 #l9
  ai-tool-path #l3 #l2
  set-variable #p7 #l9
  set-variable #l4 #l9
  ai-home-name #l4
  set-variable #l4 #l9
  !if &seq #l1 "read_file"
    ai-tool-arg "start_line"
    set-variable #l5 #l9
    ai-tool-arg "end_line"
    set-variable #l6 #l9
    !if &len #l5
      set-variable #p8 &spr "read %s lines %s-%s" #l4 #l5 &con &len #l6 #l6 "on"
    !else
      set-variable #p8 &spr "read %s" #l4
    !endif
  !elif &seq #l1 "search_files"
    ai-tool-arg "pattern"
    set-variable #p8 &spr "search %s for %s" #l4 #l9
  !elif &seq #l1 "list_files"
    set-variable #p8 &spr "list the files in %s" #l4
  !else
    set-variable #p8 ""
  !endif
!emacro

; run tool call @1 (name) with the arguments in *ai-tool-args* on path @2, from directory @3,
; putting its result in *ai-tool-out*
0 define-macro ai-tool-do
  set-variable #l1 @1
  set-variable #l2 @2
  set-variable #l3 @3
  set-variable #l0 $buffer-bname
  set-variable .ai-attach.into "*ai-tool-out*"
  ; named as the model would, from the project directory
  !if &seq &lef #l2 &len #l3 #l3
    set-variable #l4 &rig #l2 &len #l3
    !iif &seq #l4 ""  set-variable #l4 "."
  !else
    ai-home-name #l2
    set-variable #l4 #l9
  !endif
  !if &seq #l1 "read_file"
    ai-tool-arg "start_line"
    set-variable #l5 &con &len #l9 #l9 1
    ai-tool-arg "end_line"
    set-variable #l6 &con &len #l9 #l9 0
    !iif &les #l5 1  set-variable #l5 1
    !iif &or &not #l6 &gre #l6 &add #l5 499  set-variable #l6 &add #l5 499
    !iif &les #l6 #l5  set-variable #l6 #l5
    ai-att-read "file" #l2 #l5 #l6
    find-buffer "*ai-tool-out*"
    !if &len #l9
      insert-string &spr "%s could not be read, %s.\n" #l4 #l9
    !elif &gre #l5 #l8
      insert-string &spr "%s has only %d lines.\n" #l4 #l8
    !else
      !iif &gre #l6 #l8  set-variable #l6 #l8
      ai-att-fenced &spr "Lines %d-%d of the %d lines of %s:" #l5 #l6 #l8 #l4 #l7
    !endif
  !elif &seq #l1 "search_files"
    ai-tool-arg "pattern"
    ai-sh-quote #l9
    set-variable #l5 #l9
    ai-sh-quote #l2
    set-variable #l6 #l9
    ai-sh-quote #l3
    set-variable #l7 &spr "cd \"%s\" && grep -rnIE --exclude-dir=.git -e \"%s\" -- \"%s\" | head -200" #l9 #l5 #l6
    ai-temp-buffer "*ai-att-text*"
    !force 0x42 pipe-shell-command #l7 "*ai-att-text*"
    find-buffer "*ai-att-text*"
    -1 buffer-mode "view"
    end-of-buffer
    set-variable #l8 &sub $window-line 1
    find-buffer "*ai-tool-out*"
    !if #l8
      ai-att-fenced &spr "%d matching line%s, as file:line:text:" #l8 &con &equ #l8 1 "" "s" "text"
    !else
      insert-string "No lines match.\n"
    !endif
  !elif &seq #l1 "list_files"
    ai-att-run "tree" #l2
    find-buffer "*ai-tool-out*"
    !if &len #l9
      insert-string &spr "%s could not be listed, %s.\n" #l4 #l9
    !else
      ai-att-fenced &spr "The %d files under %s:" #l8 #l4 "text"
    !endif
  !else
    find-buffer "*ai-tool-out*"
    insert-string &spr "There is no tool %s.\n" #l1
  !endif
  !force 0 delete-buffer "*ai-att-text*"
  set-variable .ai-attach.into "*ai-req*"
  find-buffer #l0
!emacro

; review the tool calls of the last reply of .ai-send.tool-chat, run as a callback once it is in
0 define-macro ai-tool-review
  !iif .ai-send.busy  !return
  !iif &not &exi &spr ":%s:" .ai-send.tool-chat  !return
  ; wait for a second without a key press, so keys being typed are not taken as answers
  !if &not &seq $recent-keys .ai-apply-edits.review-keys
    set-variable .ai-apply-edits.review-keys $recent-keys
    1000 create-callback ai-tool-review
    !return
  !endif
  0x01 set-position "\xa1"
  !force 0 popup-window .ai-send.tool-chat
  !iif &not $status  1 popup-window .ai-send.tool-chat
  set-variable .ai-send.tool-msg ""
  !force ai-tool-run-all
  0x01 goto-position "\xa1"
  !if &len .ai-send.tool-msg
    1 screen-update
    ml-write .ai-send.tool-msg
  !endif
!emacro

; ask about and run the tool calls of the last reply in the current chat that have no result,
; adding a "## Tool" part for each, then send the chat again unless the user stopped
0 define-macro ai-tool-run-all
  ai-chat-map
  ; the last reply and the results after it
  set-variable #l1 0
  set-variable #l2 "|"
  set-variable #l3 0
  !while &not &seq &set #l4 &lget .ai-chat.map-roles &inc #l3 1 ""
    set-variable $window-line #l4
    !if &xse @wl .ai-chat.ai-re
      set-variable #l1 #l4
      set-variable #l2 "|"
    !elif &xse @wl "## Tool[ \t]+\\([-_.:A-Za-z0-9]+\\).*"
      set-variable #l2 &spr "%s%s|" #l2 @s1
    !elif &xse @wl .ai-chat.you-re
      set-variable #l1 0
    !endif
  !done
  !if &not #l1
    set-variable .ai-send.tool-msg "[AI: no tool calls to answer]"
    !return
  !endif
  ; its tool-call blocks
  ai-temp-buffer "*ai-tool-calls*"
  find-buffer .ai-send.tool-chat
  set-variable $window-line #l1
  set-variable #l5 ""
  !repeat
    !force forward-line
    !iif &not $status  !break
    !iif &seq @wc ""  !break
    !iif &xse @wl .ai-chat.role-re  !break
    !if &len #l5
      !if &xse @wl "[ \t]*\\(```\\|~~~\\).*"
        ai-fence-line @wl #l5
        set-variable #l5 .ai-chat.fence
      !endif
    !elif &xse @wl "[ \t]*\\(```\\|~~~\\).*"
      !if &xse @wl "[ \t]*\\(```+\\|~~~+\\)[ \t]*tool-call[ \t]+\\([-_.:A-Za-z0-9]+\\)[ \t]+\\([-_.:A-Za-z0-9]+\\)[ \t]*"
        set-variable #l6 &spr "\t%s\t%s\t%d\t" @s2 @s3 $window-line
        !if &not &lfind #l2 @s2
          find-buffer "*ai-tool-calls*"
          end-of-buffer
          insert-string &cat #l6 "\n"
          find-buffer .ai-send.tool-chat
        !endif
      !endif
      ai-fence-line @wl ""
      set-variable #l5 .ai-chat.fence
    !endif
  !done
  ai-tool-root
  set-variable .ai-send.tool-dir #l9
  set-variable .ai-send.tool-stop 0
  set-variable .ai-send.tool-auto 0
  set-variable #l3 0
  !repeat
    find-buffer "*ai-tool-calls*"
    set-variable $window-line &add #l3 1
    !iif &seq @wc ""  !break
    set-variable #l4 @wl
    set-variable #l3 &add #l3 1
    find-buffer .ai-send.tool-chat
    ; its arguments are the lines of its block
    set-variable #l5 &lget #l4 3
    set-variable $window-line #l5
    ai-fence-line @wl ""
    set-variable #l6 .ai-chat.fence
    !repeat
      !force forward-line
      !iif &or &not $status &seq @wc ""  !break
      !if &xse @wl "[ \t]*\\(```\\|~~~\\).*"
        ai-fence-line @wl #l6
        !iif &not &len .ai-chat.fence  !break
      !endif
    !done
    set-variable #l9 $window-line
    ai-edit-copy &add #l5 1 #l9 "*ai-tool-args*"
    ai-temp-buffer "*ai-tool-out*"
    find-buffer .ai-send.tool-chat
    set-variable #l2 &lget #l4 2
    ; sets #l7 to the path it works on and #l8 to what it does
    ai-tool-describe #l2 .ai-send.tool-dir
    !if .ai-send.tool-stop
      set-variable #l9 "x"
    !elif &not &len #l8
      set-variable #l9 "u"
    !elif .ai-send.tool-auto
      set-variable #l9 "y"
    !else
      !force set-variable #l9 @mc1 &spr "AI asks to %s, allow it (y/n/a/q)? " #l8 "yYnNaAqQ"
      !iif &not $status  set-variable #l9 "q"
      set-variable #l9 &slo #l9
    !endif
    !if &seq #l9 "a"
      set-variable .ai-send.tool-auto 1
      set-variable #l9 "y"
    !endif
    !if &seq #l9 "y"
      ai-tool-do #l2 #l7 .ai-send.tool-dir
    !else
      find-buffer "*ai-tool-out*"
      !if &seq #l9 "u"
        insert-string &spr "There is no tool %s.\n" #l2
      !elif &seq #l9 "n"
        insert-string "The user did not allow this.\n"
      !else
        insert-string "The user stopped the tool calls.\n"
        set-variable .ai-send.tool-stop 1
      !endif
      find-buffer .ai-send.tool-chat
    !endif
    ; the result as a part of the chat
    ai-chat-separate
    insert-string &spr "## Tool %s\n\n" &lget #l4 1
    ai-edit-append "*ai-tool-out*"
    insert-string "\n"
  !done
  !force 0 delete-buffer "*ai-tool-calls*"
  !force 0 delete-buffer "*ai-tool-args*"
  !force 0 delete-buffer "*ai-tool-out*"
  !if .ai-send.tool-stop
    ai-chat-separate
    insert-string "## You\n\n"
    set-variable .ai-send.tool-msg "[AI: tool calls stopped, write the next question]"
    !return
  !endif
  set-variable .ai-send.tool-round &add .ai-send.tool-round 1
  !if &gre .ai-send.tool-round %ai-tool-rounds
    ai-chat-separate
    insert-string "## You\n\n"
    set-variable .ai-send.tool-msg &spr "[AI: stopped after %d rounds of tool calls, C-c C-c goes on]" %ai-tool-rounds
    !return
  !endif
  !force ai-start
!emacro

; insert the code block of the reply to ai-commit-message into the buffer it was asked from, run as
; a callback once the reply is in
0 define-macro ai-insert-review
  !iif .ai-send.busy  !return
  !iif &not &exi &spr ":%s:" .ai-insert-block.insert-chat  !return
  !if &not &seq $recent-keys .ai-apply-edits.review-keys
    set-variable .ai-apply-edits.review-keys $recent-keys
    1000 create-callback ai-insert-review
    !return
  !endif
  set-variable #l0 $buffer-bname
  find-buffer .ai-insert-block.insert-chat
  end-of-buffer
  !force ai-insert-block "i"
  !iif &not $status  find-buffer #l0
  1 screen-update
  ml-write "[AI: the message is in, edit it as needed]"
!emacro

; set #p9 to the directory of the git work tree of the current buffer's file, else the current
; directory, with no / at its end
0 define-macro ai-git-dir
  set-variable #l1 $buffer-fname
  !if &len #l1
    set-variable #l1 &lef #l1 &sub &rsin "/" #l1 1
    ; the message of a commit is edited in the .git directory
    !iif &seq &rig #l1 &sub &len #l1 5 "/.git"  set-variable #l1 &lef #l1 &sub &len #l1 5
  !else
    set-variable #l1 &stat "a" "./"
    !iif &seq &rig #l1 &sub &len #l1 1 "/"  set-variable #l1 &lef #l1 &sub &len #l1 1
  !endif
  set-variable #p9 #l1
!emacro

; write a commit message for the changes staged in git, from the diff of them, into the current
; buffer at the point, such as the message buffer git opens
define-macro ai-commit-message
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  ai-git-dir
  set-variable #l1 #l9
  !if &or &sin "\"" #l1 &or &sin "$" #l1 &sin "`" #l1
    ml-write "[AI: the directory's name has a quote, $ or ` in it]"
    !abort
  !endif
  set-variable .ai-send.key-out ""
  !force 0x402 pipe-shell-command &spr "git -C \"%s\" diff --cached --quiet" #l1 ".ai-send.key-out"
  set-variable #l2 $result
  set-variable .ai-send.key-out ""
  !if &equ #l2 0
    ml-write &spr "[AI: nothing is staged in %s]" #l1
    !abort
  !elif &not &equ #l2 1
    ml-write &spr "[AI: %s is not in a git work tree]" #l1
    !abort
  !endif
  set-variable #l3 &spr "git -C \"%s\" --no-pager diff --cached --no-ext-diff --no-color" #l1
  set-variable .ai-insert-block.src $buffer-bname
  set-variable .ai-insert-block.src-region 0
  0x01 set-position "\xa1"
  ai-chat
  ai-chat-question
  ai-chat-attach "cmd" #l3 0 0
  ai-cmd-allow #l3 $buffer-bname
  ai-chat-text-point
  insert-string &cat %ai-commit-prompt "\n"
  set-variable .ai-insert-block.insert-next 1
  !force ai-start
  !iif &not .ai-send.busy  set-variable .ai-insert-block.insert-next 0
  0x01 goto-position "\xa1"
!emacro

; ask for a fix of the error on the current line of a compile or grep buffer, sending the message
; and the function of the file it is in. Once the reply is in its edits are reviewed
define-macro ai-fix-error
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  set-variable #l1 $window-line
  set-variable #l2 $window-col
  !force backward-line
  !force 6 get-next-line
  set-variable #l3 &and $status &equ $window-line #l1
  set-variable $window-line #l1
  !if &not #l3
    set-variable $window-col #l2
    ml-write "[AI: no error message on this line]"
    !abort
  !endif
  set-variable #l4 :next-file
  set-variable #l5 :next-line
  set-variable #l6 "file"
  !if &and &seq &lef #l4 1 "*" &seq &rig #l4 &sub &len #l4 1 "*"
    set-variable #l6 "buffer"
    set-variable #l4 &mid #l4 1 &sub &len #l4 2
  !endif
  ; the message: this line and the indented lines after it
  set-variable #l7 $window-line
  !repeat
    !force forward-line
    !iif &or &not $status &seq @wc ""  !break
    !iif &not &xse @wl "[ \t]+[^ \t\n].*"  !break
    !iif &gre &sub $window-line #l7 9  !break
  !done
  set-variable #l8 $window-line
  ai-edit-copy #l7 #l8 "*ai-quote*"
  set-variable $window-line #l1
  set-variable $window-col #l2
  ; the function it is in, else the lines around it
  set-variable #l0 $buffer-bname
  ai-edit-buffer #l6 #l4
  !if &seq #l9 ""
    ml-write &spr "[AI: cannot find %s]" #l4
    !abort
  !endif
  find-buffer #l9
  0x0c0 set-position "\xab"
  !force #l5 goto-line
  ai-function-lines
  !if &not #l9
    set-variable #l1 &sub #l5 %ai-attach-lines
    !iif &les #l1 1  set-variable #l1 1
    set-variable #l2 &add #l5 %ai-attach-lines
    end-of-buffer
    !iif &gre #l2 &sub $window-aline 1  set-variable #l2 &sub $window-aline 1
  !endif
  0x0c0 goto-position "\xab"
  find-buffer #l0
  0x01 set-position "\xa1"
  ai-chat
  ai-chat-question
  ai-chat-attach #l6 #l4 #l1 #l2
  ai-chat-text-point
  insert-string "```text\n"
  ai-edit-append-at $window-line "*ai-quote*"
  !force 0 delete-buffer "*ai-quote*"
  end-of-buffer
  insert-string &spr "```\n%s\n" %ai-fix-prompt
  set-variable .ai-apply-edits.review-next 1
  !force ai-start
  !iif &not .ai-send.busy  set-variable .ai-apply-edits.review-next 0
  0x01 goto-position "\xa1"
!emacro

define-macro ai-new
  !if .ai-send.busy
    ml-write "[AI: busy, wait for the reply or use ai-cancel]"
    !abort
  !endif
  ai-chat
  !if %ai-chat-save
    ; the chat is kept in its file
    !force ai-chat-save
  !else
    beginning-of-buffer
    !force search-buffer "me" &spr "^%s$" .ai-chat.ai-re
    !if $status
      !iif &not &iseq @mc1 "Discard the current chat (y/n)? " "yYnN" "y"  !abort
    !endif
  !endif
  ai-chat-init
  !force unset-variable :ai-file
  !force unset-variable :ai-tokens-in
  !force unset-variable :ai-tokens-out
  !force unset-variable :ai-cmd-ok
!emacro

define-macro ai-cancel
  !if &not .ai-send.busy
    ml-write "[AI: no request to cancel]"
    !return
  !endif
  !if .ai-send.retry-at
    ; waiting to try again
    !force -1 create-callback ai-retry-send
    set-variable .ai-send.cancel 1
    ai-finish
    !return
  !endif
  set-variable #l0 $buffer-bname
  !force find-buffer "*ai-stream*"
  !if &bmo "pipe"
    set-variable .ai-send.cancel 1
    !force ipipe-kill
  !else
    set-variable .ai-send.busy 0
    ml-write "[AI: request state reset]"
  !endif
  find-buffer #l0
!emacro

; fill *ai-models* with the server's model ids that do not match %ai-model-skip, one per line and
; sorted, #p9 is the count. The list is kept for the server unless @1 is 1
0 define-macro ai-model-list
  set-variable #l0 $buffer-bname
  set-variable #p9 0
  !if &and &not @1 &and &seq .ai-set-model.models-url %ai-base-url &exi ":*ai-models*:"
    find-buffer "*ai-models*"
    end-of-buffer
    set-variable #p9 &sub $window-line 1
    find-buffer #l0
    !return
  !endif
  set-variable .ai-set-model.models-url ""
  ai-get-key
  set-variable #l1 &exi %http-header
  !iif #l1  set-variable #l2 %http-header
  !if &len #l9
    set-variable %http-header &spr ":GET:Authorization: Bearer %s" #l9
  !else
    set-variable %http-header ":GET:"
  !endif
  set-variable #l3 &exi %http-flags
  !iif #l3  set-variable #l4 %http-flags
  !iif #l3  set-variable %http-flags &rep #l4 "d" ""
  ai-temp-buffer "*ai-response*"
  !force insert-file &cat %ai-base-url "/models"
  !if #l1
    set-variable %http-header #l2
  !else
    unset-variable %http-header
  !endif
  !iif #l3  set-variable %http-flags #l4
  ai-temp-buffer "*ai-models*"
  find-buffer "*ai-response*"
  beginning-of-buffer
  !repeat
    !force search-buffer "me" "\"id\"[ \t\r\n]*:[ \t\r\n]*\""
    !iif &not $status  !break
    ai-json-string "*ai-models*"
    find-buffer "*ai-models*"
    goto-alpha-mark "\xa4"
    ; one that is not for chat is left out
    beginning-of-line
    !if &and &len %ai-model-skip &xse @wl &spr ".*\\(%s\\).*" %ai-model-skip
      set-mark
      end-of-line
      -1 kill-region
    !else
      end-of-line
      insert-string "\n"
      set-variable #p9 &add #p9 1
    !endif
    set-alpha-mark "\xa4"
    find-buffer "*ai-response*"
  !done
  find-buffer "*ai-models*"
  !if &gre #p9 1
    beginning-of-buffer
    set-mark
    end-of-buffer
    !force sort-lines
    ; the empty line after the last is sorted first
    beginning-of-buffer
    !iif &seq @wc "\n"  forward-delete-char
  !endif
  find-buffer #l0
  !iif #p9  set-variable .ai-set-model.models-url %ai-base-url
!emacro

; choose the model, from the server's list when it gives one. An argument fetches the list again
define-macro ai-set-model
  !force set-variable #l1 @1
  !if &not $status
    ai-model-list @?
    !if #l9
      set-variable #l1 @ml1a "AI model" %ai-model "*ai-models*"
    !else
      set-variable #l1 @ml10 "AI model" %ai-model
    !endif
  !endif
  !iif &seq #l1 ""  !abort
  set-variable %ai-model #l1
  ai-profile-keep "model" #l1
  ml-write &spr "[AI: using model %s]" #l1
!emacro

; set how hard a reasoning model thinks, sent as reasoning_effort, completing from %ai-efforts.
; Empty leaves it to the model, which is needed for one that does not reason
define-macro ai-set-effort
  !force set-variable #l1 @1
  !if &not $status
    !force set-variable #l1 @ml29 "AI effort (empty for the model's own)" %ai-effort %ai-efforts
    !iif &not $status  !abort
  !endif
  set-variable #l1 &trb #l1
  set-variable %ai-effort #l1
  ai-profile-keep "effort" #l1
  ml-write &con &len #l1 &spr "[AI: using %s effort]" #l1 "[AI: effort left to the model]"
!emacro

; The editor's own state, kept as variables of the commands it belongs to so it does not
; crowd the user's variables. Set once the commands are defined
; an attachment line, for &xse
set-variable .ai-chat.att-line "@\\(file\\|buffer\\|cmd\\|diff\\|tree\\)[ \t]+\\(.*[^ \t\n]\\)[ \t]*"
; for &xse, a role line, which may end in a comment such as the model that wrote a reply, and a
; tool's result is for the call named in its role line
set-variable .ai-chat.role-re "## \\(You\\|AI\\|System\\|Tool[ \t]+[-_.:A-Za-z0-9]+\\)\\([ \t]+<!--.*-->\\)?[ \t]*"
set-variable .ai-chat.you-re "## You\\([ \t]+<!--.*-->\\)?[ \t]*"
set-variable .ai-chat.ai-re "## AI\\([ \t]+<!--.*-->\\)?[ \t]*"
; an edit block's opening fence, the file's name may follow edit after a space, : or =, and for
; &xse the same giving the fence and name as @s1 & @s3. The status line written after it for each
; change
set-variable .ai-chat.edit-fence "^[ \t]*\\(```+\\|~~~+\\)[ \t]*edit\\([ \t]*[:=][ \t]*\\|[ \t]+\\)[^ \t\n].*$"
set-variable .ai-chat.edit-fence-x "[ \t]*\\(```+\\|~~~+\\)[ \t]*edit\\([ \t]*[:=][ \t]*\\|[ \t]+\\)\\(.*[^ \t\n]\\)[ \t]*"
set-variable .ai-chat.edit-status "(edit [0-9]+ [a-z]+.*"
; a role line, a code fence or an attachment line, the lines that give a chat its structure
set-variable .ai-chat.map-regex &spr "^\\(%s\\|[ \t]*\\(```\\|~~~\\).*\\|%s\\)$" .ai-chat.role-re .ai-chat.att-line
set-variable .ai-chat.fence-regex "^[ \t]*\\(```\\|~~~\\)"
set-variable .ai-send.busy 0
set-variable .ai-chat.spaces "                                                                "
set-variable .ai-insert-block.src ""
set-variable .ai-insert-block.src-region 0
set-variable .ai-send.req-file ""
set-variable .ai-send.hdr-file ""
set-variable .ai-send.req-note ""
set-variable .ai-apply-edits.review-next 0
set-variable .ai-apply-edits.undo-new 0
set-variable .ai-chat.key-list 0
!iif &not &exi .ai-chat.current  set-variable .ai-chat.current "*ai-chat*"
set-variable .ai-insert-block.insert-next 0
set-variable .ai-send.retry-at 0
set-variable .ai-send.req-key ""
set-variable .ai-send.req-resp 0
set-variable .ai-send.tc-n 0
set-variable .ai-send.think 0
set-variable .ai-send.ml-saved ""
set-variable .ai-send.tool-round 0
set-variable .ai-send.key-cmd ""
set-variable .ai-apply-edits.decide ""
set-variable .ai-apply-edits.reject-this 0
set-variable .ai-attach.into "*ai-req*"
!iif &not &exi .ai-set-model.models-url     set-variable .ai-set-model.models-url ""
set-variable .ai-set-profile.settings "|base-url|api-key|api-key-command|transport|api|extra-json|tools|"
; the default profile, the settings as they were given before this file was loaded
!iif &not &exi .ai-set-profile.default-base-url  set-variable .ai-set-profile.default-base-url %ai-base-url
!iif &not &exi .ai-set-profile.default-api-key   set-variable .ai-set-profile.default-api-key %ai-api-key
!iif &not &exi .ai-set-profile.default-api-key-command  set-variable .ai-set-profile.default-api-key-command %ai-api-key-command
!iif &not &exi .ai-set-profile.default-transport  set-variable .ai-set-profile.default-transport %ai-transport
!iif &not &exi .ai-set-profile.default-api       set-variable .ai-set-profile.default-api %ai-api
!iif &not &exi .ai-set-profile.default-extra-json  set-variable .ai-set-profile.default-extra-json %ai-extra-json
!iif &not &exi .ai-set-profile.default-tools     set-variable .ai-set-profile.default-tools %ai-tools
!iif &not &exi .ai-set-profile.default-model     set-variable .ai-set-profile.default-model %ai-model
!iif &not &exi .ai-set-profile.default-effort    set-variable .ai-set-profile.default-effort %ai-effort

; the profile last chosen, once its macros are defined
!if &not &exi .ai-set-profile.current
  set-variable .ai-set-profile.current &reg "/history/ai-chat/profile" "default"
  !iif &not &lfind %ai-profiles .ai-set-profile.current  set-variable .ai-set-profile.current "default"
  !iif &not &seq .ai-set-profile.current "default"  !force ai-profile-apply
!endif
